---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import BundleOfferCard from "@/components/products/BundleOfferCard.astro";
import { Button } from "@/components/starwind/button";
import TextLink from "@/components/ui/TextLink.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { isPublicBundle, isPublicProduct } from "@/lib/storefront-visibility";

const products = (await getCollection("products")).filter(isPublicProduct);
const bundles = (await getCollection("bundles")).filter(isPublicBundle).sort((a, b) => a.data.order - b.data.order);

const service = [
  {
    stage: "Offer",
    problem: "When someone asks what you do, your answer turns into a list of technologies or whatever they happen to need.",
    change: "Define a specific offer, who it is for, what it includes, and where the boundary sits before a prospect asks you to improvise it.",
    product: "Productize Your Dev Skills",
    href: "/products/productize-your-dev-skills/",
  },
  {
    stage: "Pricing",
    problem: "You can estimate the build, but naming a price still feels like a guess made under pressure.",
    change: "Build a pricing process that connects the quote to the economics, risk, scope, and assumptions behind the work.",
    product: "Web Developer Pricing System",
    href: "/products/web-developer-pricing-system/",
  },
  {
    stage: "Pipeline",
    problem: "You get busy, stop looking for work, then reach the end of the project with an empty pipeline.",
    change: "Create an acquisition process you can keep operating while client work is underway instead of restarting from zero later.",
    product: "Client Acquisition Without Upwork",
    href: "/products/client-acquisition-without-upwork/",
  },
  {
    stage: "Marketing",
    problem: "Your technical work is stronger than the way your website, portfolio, and marketing make you look to buyers.",
    change: "Make the business value of your work easier to understand so the right buyer can see why the work matters before a sales conversation begins.",
    product: "Marketing for Builders",
    href: "/products/marketing-for-builders/",
  },
  {
    stage: "Sales",
    problem: "Sales calls feel productive, but too many end with vague interest instead of a decision or a defined next step.",
    change: "Run conversations that surface the real problem, decision process, fit, and next action without turning the call into free consulting.",
    product: "Developer Sales Playbook",
    href: "/products/developer-sales-playbook/",
  },
  {
    stage: "Proposals",
    problem: "You spend hours writing proposals before you know whether the buyer is actually ready to decide.",
    change: "Recognize proposal readiness, carry discovery decisions forward, and keep scope, price, revisions, and the decision process under control.",
    product: "Developer Proposal & Closing Kit",
    href: "/products/developer-proposal-closing-kit/",
  },
  {
    stage: "Partnerships",
    problem: "You want agencies to send repeat work without turning you into discounted overflow labor with permanent availability.",
    change: "Define the economics, fit, communication, capacity, and boundaries that make an agency relationship worth keeping.",
    product: "Agency Partnership Playbook",
    href: "/products/agency-partnership-playbook/",
  },
  {
    stage: "Retention",
    problem: "A good project ends, the client still has legitimate needs, and your revenue from the relationship drops straight back to zero.",
    change: "Identify continuing value you can responsibly offer and structure recurring work without inventing a retainer just to keep billing.",
    product: "Freelancer Retainer System",
    href: "/products/freelancer-retainer-system/",
  },
];
---

<BaseLayout
  title="Start Here | Find the Business Problem to Fix Next | Developer Business Lab"
  description="Start with the freelance business problem you keep running into, then choose the Developer Business Lab system that matches it."
>
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="Start here"
    title="Start with the business problem you keep running into."
    description="You do not need to understand the catalog before you choose. Find the situation that sounds most like your actual work. If one problem is obvious, go straight to it. If several keep feeding one another, start with the broader foundation."
    primaryCta={{ label: "Find My Bottleneck", href: "#choose-problem" }}
    secondaryCta={{ label: "Start Free Instead", href: "/free/" }}
    supportingItems={["Choose by real situation", "No required buying sequence", "Start as small as the problem allows"]}
  />

  <section id="choose-problem" class="scroll-mt-24 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
        <div>
          <p class="editorial-kicker">What keeps happening?</p>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight">Choose the problem you already recognize.</h2>
        </div>
        <p class="max-w-2xl text-lg leading-8 text-muted-foreground">Do not start with the product name. Start with the moment that keeps creating uncertainty, wasted effort, missed follow-up, or a weak decision in the business. The right focused system should make that specific part of the work more deliberate.</p>
      </div>

      <div class="mt-10 divide-y divide-border border-y border-border">
        {service.map(({ stage, problem, change, product, href }) => (
          <article class="grid gap-5 py-8 lg:grid-cols-[8rem_1fr_1fr_auto] lg:items-start lg:gap-8">
            <p class="pt-1 text-xs font-semibold uppercase tracking-[.14em] text-muted-foreground">{stage}</p>
            <div>
              <h3 class="text-xl font-semibold leading-8">{problem}</h3>
            </div>
            <p class="leading-7 text-muted-foreground">{change}</p>
            <div class="lg:pt-1">
              <TextLink href={href}>{product} →</TextLink>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.85fr_1.15fr] lg:items-center lg:gap-20">
      <div>
        <p class="editorial-kicker">If several of those sounded true</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">The visible problem may be downstream from something you never defined earlier.</h2>
      </div>
      <div class="max-w-3xl">
        <p class="text-lg leading-8 text-muted-foreground">A pricing problem can begin with an unclear offer. A weak proposal can begin with incomplete discovery. An empty pipeline can begin with acquisition work that disappears whenever delivery gets busy. When several parts of the business feel improvised at once, fixing the loudest symptom first can leave the underlying dependency untouched.</p>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">The Freelance Developer Launch Kit is the broader starting point. It helps you build the first complete version of the business in dependency order, see how the decisions connect, and identify which part deserves deeper work next.</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button as="a" href="/products/freelance-developer-launch-kit/" size="lg">Start with the Launch Kit</Button>
          <span class="text-sm text-muted-foreground">Use this when the problem is bigger than one obvious bottleneck.</span>
        </div>
      </div>
    </div>
  </section>

  {bundles.length > 0 && (
    <section id="stage-bundles" class="scroll-mt-24 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
          <div>
            <p class="editorial-kicker">When one problem is actually several related decisions</p>
            <h2 class="mt-4 text-4xl font-semibold tracking-tight">Use a bundle when the parts need to work together.</h2>
          </div>
          <div class="max-w-2xl">
            <p class="text-lg leading-8 text-muted-foreground">Sometimes one stage is clearly the problem, but one focused guide is too narrow. You may need offer, pricing, and marketing to agree with one another, or sales, proposals, and continuing value to work as one process. That is when a bundle makes sense.</p>
            <p class="mt-4 leading-7 text-muted-foreground">Each bundle page shows the included products, what each contributes, the recommended implementation order, the current bundle price, and any verified savings.</p>
          </div>
        </div>
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          {bundles.map((bundle) => (
            <BundleOfferCard
              bundle={bundle}
              products={products}
              featured={bundle.data.slug === "freelance-developer-business-system"}
              location="start-here"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-center">
      <div>
        <p class="editorial-kicker">Still not sure where to begin?</p>
        <h2 class="mt-4 text-3xl font-semibold">Use the free Quickstart to put one real acquisition loop into motion.</h2>
      </div>
      <div>
        <p class="text-lg leading-8 text-muted-foreground">Developer Marketing Quickstart gives you a 30-page guide and 16-page workbook for choosing a buyer, verifying the problem, shaping a provisional offer, working a qualified First 25, and deciding what to test next. It gives you a useful first execution and lets you inspect how Developer Business Lab teaches before you spend anything.</p>
        <p class="mt-5"><Button as="a" href="/free/" size="lg">Get the Free Quickstart</Button></p>
        <p class="mt-3 text-xs uppercase tracking-[0.12em] text-muted-foreground">Free download · email required</p>
      </div>
    </div>
  </section>
</BaseLayout>
