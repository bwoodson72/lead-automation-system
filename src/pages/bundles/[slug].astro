---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import BundlePriceComparison from "@/components/products/BundlePriceComparison.astro";
import FAQList from "@/components/ui/FAQList.astro";
import { button } from "@/components/starwind/button/variants";
import heroImage from "@/assets/brand/neutral-hero.png";
import { getBundleMerchandising } from "@/lib/bundle-merchandising";
import { isPublicBundle, isPublicProduct } from "@/lib/storefront-visibility";
import { applyBundleCopyOverride, applyProductCopyOverride } from "@/lib/copy-overrides";
import { cleanPublicCopyTree } from "@/lib/public-copy-cleaner";

export async function getStaticPaths() {
  const bundles = (await getCollection("bundles")).filter(isPublicBundle);
  return bundles.map((bundle) => ({ params: { slug: bundle.data.slug }, props: { bundle } }));
}

const { bundle } = Astro.props;
const products = (await getCollection("products")).filter(isPublicProduct);
const merch = getBundleMerchandising(bundle, products);
const d = cleanPublicCopyTree(applyBundleCopyOverride(bundle.data));
const siteUrl = Astro.site?.toString() || "https://developerbusinesslab.com";
const canonical = new URL(`/bundles/${d.slug}/`, siteUrl).toString();
const organizationId = new URL("/#organization", siteUrl).toString();
const title = d.seo?.title ?? `${d.title} | Developer Business Lab`;
const description = d.seo?.description ?? d.shortDescription ?? d.outcome;
const checkoutClass = button({ class: "lemonsqueezy-button" });

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Bundles", item: new URL("/bundles/", siteUrl).toString() },
    { "@type": "ListItem", position: 2, name: d.title, item: canonical },
  ],
};
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${canonical}#bundle`,
  name: d.title,
  description,
  url: canonical,
  category: "Business system bundle",
  brand: { "@id": organizationId },
  audience: { "@type": "Audience", audienceType: d.audience },
  ...(merch.purchasable && merch.bundlePrice ? { offers: { "@type": "Offer", url: canonical, priceCurrency: "USD", price: merch.bundlePrice.toFixed(2), availability: "https://schema.org/InStock" } } : {}),
};
---

<BaseLayout title={title} description={description} noindex={merch.effectiveStatus === "planned"} enableCheckoutOverlay={merch.purchasable} structuredData={[breadcrumbs, productSchema]}>
  <PageHero
    image={heroImage}
    imageAlt="Dark developer workspace at night with warm desk lighting and city lights beyond the window"
    breadcrumbs={[{ label: "Bundles", href: "/bundles/" }, { label: d.title }]}
    eyebrow={`${merch.stage} · ${d.title}`}
    title={d.hook ?? d.title}
    description={d.shortDescription ?? d.outcome}
    audience={d.audience}
    supportingItems={[`${merch.productCount} connected systems`, "Digital guides + workbooks", merch.purchasable ? "One-time purchase" : "Built to work as one stage"]}
  >
    <div slot="actions" class="space-y-5">
      {merch.purchasable && merch.bundlePriceFormatted && <BundlePriceComparison bundlePriceFormatted={merch.bundlePriceFormatted} separateValue={merch.separateValue} savings={merch.savings} savingsPercent={merch.savingsPercent} variant="hero" />}
      <div class="flex flex-wrap items-center gap-4">
        {merch.purchasable && merch.checkoutUrl ? <a href={merch.checkoutUrl} class={checkoutClass} data-event="checkout_click" data-product-slug={d.slug} data-cta-location="bundle-hero">Get {d.title}{merch.bundlePriceFormatted ? ` for ${merch.bundlePriceFormatted}` : ""}</a> : <a href="#inside" class="font-semibold text-primary-accent">See what is included ↓</a>}
      </div>
    </div>
    {merch.image && <div slot="visual" class="min-w-0"><Image src={merch.image} alt={`${d.title} bundle mockup`} class="mx-auto max-h-[30rem] w-full object-contain" widths={[480, 720, 960]} sizes="(min-width: 1024px) 38vw, 90vw" /></div>}
  </PageHero>

  {d.pageCopy && <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-20"><div><p class="editorial-kicker">{d.pageCopy.problemEyebrow ?? "The problem this bundle solves"}</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">{d.pageCopy.problemTitle ?? d.hook ?? d.title}</h2></div><div class="space-y-5 text-lg leading-8 text-muted-foreground"><p>{d.outcome}</p>{d.whyTogether && <p>{d.whyTogether}</p>}</div></div></section>}

  <section id="inside" class="scroll-mt-24 border-b border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:gap-20">
        <div><p class="editorial-kicker">{d.pageCopy?.includedEyebrow ?? "What you get"}</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">{d.pageCopy?.includedTitle ?? `${merch.productCount} connected systems that build the ${merch.stage.toLowerCase()} stage together.`}</h2></div>
        <div><p class="text-lg leading-8 text-muted-foreground">{d.pageCopy?.includedIntro ?? d.whyTogether ?? d.outcome}</p></div>
      </div>
      <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border md:grid-cols-2">
        {merch.includedProducts.map((product, index) => {
          const productCopy = cleanPublicCopyTree(applyProductCopyOverride(product.data));
          return <a href={`/products/${productCopy.slug}/`} class="group bg-background p-6 transition-colors hover:bg-card/50" data-event="bundle_included_product" data-product-slug={productCopy.slug}><p class="font-mono text-xs text-primary-accent">{String(index + 1).padStart(2, "0")}</p><h3 class="mt-3 text-xl font-semibold group-hover:text-primary-accent">{productCopy.title}</h3><p class="mt-3 text-sm leading-6 text-muted-foreground">{productCopy.shortDescription}</p></a>;
        })}
      </div>
      <div class="mt-10 flex flex-col gap-7 border-t border-border pt-8 lg:flex-row lg:items-end lg:justify-between"><BundlePriceComparison bundlePriceFormatted={merch.bundlePriceFormatted} separateValue={merch.separateValue} savings={merch.savings} savingsPercent={merch.savingsPercent} />{merch.purchasable && merch.checkoutUrl && <a href={merch.checkoutUrl} class={checkoutClass} data-event="checkout_click" data-product-slug={d.slug} data-cta-location="bundle-inclusions">Get {d.title}{merch.bundlePriceFormatted ? ` for ${merch.bundlePriceFormatted}` : ""}</a>}</div>
    </div>
  </section>

  {d.implementationOrder.length > 0 && <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-20"><div><p class="editorial-kicker">{d.pageCopy?.implementationEyebrow ?? "Implementation order"}</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">{d.pageCopy?.implementationTitle ?? "Use the dependency order. Do not create another pile of material."}</h2></div><ol class="border-t border-border">{d.implementationOrder.map((step, index) => <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-border py-5"><span class="font-mono text-xs text-primary-accent">{String(index + 1).padStart(2, "0")}</span><span class="leading-7 text-muted-foreground">{step}</span></li>)}</ol></div></section>}

  {(d.whoItsFor.length > 0 || d.whoItsNotFor.length > 0) && <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2 lg:gap-20"><div><p class="editorial-kicker">{d.pageCopy?.fitForEyebrow ?? "Buy the bundle if"}</p><ul class="mt-6 border-t border-border">{d.whoItsFor.map((item) => <li class="border-b border-border py-4 text-muted-foreground"><span class="mr-3 text-primary-accent">→</span>{item}</li>)}</ul></div><div><p class="editorial-kicker">{d.pageCopy?.fitNotForEyebrow ?? "Buy one focused system instead if"}</p><ul class="mt-6 border-t border-border">{d.whoItsNotFor.map((item) => <li class="border-b border-border py-4 text-muted-foreground"><span class="mr-3">×</span>{item}</li>)}</ul></div></div></section>}

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-4xl">
      {d.faqs.length > 0 && <><p class="editorial-kicker">{d.pageCopy?.faqEyebrow ?? "Before you buy"}</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">{d.pageCopy?.faqTitle ?? "Questions worth answering first."}</h2><div class="mt-8"><FAQList faqs={d.faqs.map((faq, index) => ({ data: { ...faq, order: index } }))} /></div></>}
      <div class={d.faqs.length > 0 ? "mt-14 border-t border-border pt-12" : ""}>
        <p class="editorial-kicker">{d.pageCopy?.finalEyebrow ?? "Get the connected system"}</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">{d.pageCopy?.finalTitle ?? `Build the whole ${merch.stage.toLowerCase()} stage with one purchase.`}</h2>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">{d.pageCopy?.finalBody ?? "You receive the included systems digitally through Lemon Squeezy after purchase."}</p>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">One-time purchase. Digital delivery through Lemon Squeezy after checkout. Includes the listed digital guides and companion workbooks. Refund requests are handled under the <a class="text-primary-accent hover:underline" href="/refund-policy/">14-day refund policy</a>.</p>
        <div class="mt-7"><BundlePriceComparison bundlePriceFormatted={merch.bundlePriceFormatted} separateValue={merch.separateValue} savings={merch.savings} savingsPercent={merch.savingsPercent} /></div>
        <div class="mt-8">{merch.purchasable && merch.checkoutUrl ? <a href={merch.checkoutUrl} class={checkoutClass} data-event="checkout_click" data-product-slug={d.slug} data-cta-location="bundle-final">Get {d.title}</a> : <a href="/products/" class="font-semibold text-primary-accent">Browse the included systems →</a>}</div>
      </div>
    </div>
  </section>
</BaseLayout>
