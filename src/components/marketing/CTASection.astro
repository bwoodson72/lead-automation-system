---
import { Button } from "@/components/starwind/button";
const { title, description, primaryLabel = "Get the Free Quickstart", primaryHref = "/free/", secondaryLabel, secondaryHref } = Astro.props;
---
<section class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-5xl rounded-2xl border border-primary/20 bg-primary/10 px-6 py-12 text-center sm:px-10">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-muted-foreground">{description}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3"><Button as="a" href={primaryHref}>{primaryLabel}</Button>{secondaryLabel && <Button as="a" href={secondaryHref} variant="outline">{secondaryLabel}</Button>}</div>
  </div>
</section>
