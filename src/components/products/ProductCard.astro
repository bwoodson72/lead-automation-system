---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/starwind/card";
import { resolveProductCoverImage } from "@/lib/product-cover-images";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";

interface Props {
  product: CollectionEntry<"products">;
  eventName?: string;
}

const { product, eventName = "product_view" } = Astro.props;
const d = product.data;
const commerce = resolveProductCommerce(d);
const href = `/products/${d.slug}/`;
const coverImage = resolveProductCoverImage(d, commerce.purchasable ? commerce.product?.id : undefined);
const statusLabel = commerce.effectiveStatus === "coming-soon"
  ? "Coming soon"
  : commerce.effectiveStatus === "planned"
    ? "Planned"
    : d.free
      ? "Free"
      : commerce.priceFormatted ?? "Available";
---

<Card class="flex h-full flex-col overflow-hidden border-border bg-card/70">
  <a
    href={href}
    class="block border-b border-border bg-card focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-outline"
    aria-label={`View ${d.title}`}
  >
    <div class="flex aspect-4/3 w-full items-center justify-center overflow-hidden p-4">
      {coverImage ? (
        <Image
          src={coverImage}
          alt={`${d.title} product cover`}
          class="h-full w-full object-contain"
          widths={[360, 540, 720]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      ) : (
        <div
          class="relative flex h-full w-full flex-col overflow-hidden rounded-lg border border-border bg-background p-5"
          role="img"
          aria-label={`${d.title} product cover placeholder`}
        >
          <div class="absolute inset-x-0 top-0 h-1 bg-primary"></div>
          <p class="font-mono text-[0.65rem] font-semibold uppercase tracking-widest text-primary-accent">Developer Business Lab</p>
          <div class="my-auto">
            <p class="text-xs font-medium text-muted-foreground">{d.family}{d.tier ? ` · Tier ${d.tier}` : ""}</p>
            <p class="mt-2 text-2xl font-semibold tracking-tight text-foreground">{d.title}</p>
          </div>
        </div>
      )}
    </div>
  </a>

  <CardHeader>
    <div class="mb-2 flex flex-wrap gap-2">
      <Badge variant="outline">{d.family}</Badge>
      {d.tier && <Badge variant="outline">Tier {d.tier}</Badge>}
      <Badge variant={commerce.effectiveStatus === "available" ? "default" : "secondary"}>{statusLabel}</Badge>
    </div>
    <CardTitle class="text-xl">
      <a href={href} class="hover:text-primary-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline">
        {d.title}
      </a>
    </CardTitle>
    <CardDescription class="leading-6">{d.shortDescription}</CardDescription>
  </CardHeader>

  <CardContent class="flex-1">
    <p class="text-sm leading-6"><strong>Best for:</strong> <span class="text-muted-foreground">{d.audience}</span></p>
  </CardContent>

  <CardFooter>
    <Button as="a" href={href} variant="secondary" data-event={eventName} data-product-slug={d.slug}>See how it works</Button>
  </CardFooter>
</Card>
