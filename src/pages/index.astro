---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/starwind/card";
import ProductCard from "@/components/products/ProductCard.astro";
import KitForm from "@/components/marketing/KitForm.astro";
const products = await getCollection("products");
const paths = [
  ["I don't know what to sell","productize-your-dev-skills"],["I don't know what to charge","web-developer-pricing-system"],["I need clients beyond marketplaces","client-acquisition-without-upwork"],["I need a marketing system","marketing-for-builders"],["I want to automate prospecting","ai-prospecting-starter"],["Conversations are not becoming projects","developer-sales-playbook"],["I need recurring revenue","freelancer-retainer-system"],["I have a SaaS idea","saas-validation-before-you-build"],["I want AI to increase my capacity","ai-powered-one-person-dev-business"],
];
const resolvedPaths = paths.flatMap(([problem, slug]) => {
  const product = products.find((entry) => entry.data.slug === slug);
  return product ? [{ problem, product }] : [];
});
const nextSteps = products.filter((entry) => ["developer-marketing-quickstart", "productize-your-dev-skills"].includes(entry.data.slug));
const families = ["Freelance Foundations","AI Prospecting","Sales & Closing","Growth & Recurring Revenue","SaaS","AI Operations"];
---
<BaseLayout title="Developer Business Lab | Business Systems for Independent Developers" description="Practical business systems for independent developers who need to find customers, sell valuable work, validate products, and build a repeatable business.">
  <section class="border-b border-border px-4 py-20 sm:px-6 sm:py-28 lg:px-8"><div class="mx-auto max-w-7xl"><p class="font-mono text-xs font-semibold uppercase tracking-widest text-primary-accent">Business systems for independent developers</p><h1 class="mt-5 max-w-5xl text-5xl font-semibold tracking-tight sm:text-7xl">You learned how to build. Now build the business around it.</h1><p class="mt-7 max-w-3xl text-xl leading-8 text-muted-foreground">Field guides and implementation systems for developers who need to find customers, sell valuable work, validate products, and create a more repeatable independent business.</p><div class="mt-9 flex flex-wrap gap-3"><Button as="a" href="/free/" size="lg" data-event="quickstart_view">Get the Free Quickstart</Button><Button as="a" href="/start/" variant="outline" size="lg">Find Your Next System</Button></div></div></section>
  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Recognize the bottleneck</p><h2 class="mt-3 max-w-3xl text-4xl font-semibold">Technical capability is not the same as a commercial system.</h2><div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{["Your offer is difficult to explain","Pricing feels improvised","Client acquisition happens in bursts","Prospecting stops when delivery gets busy","Sales conversations stall","SaaS gets built before demand is established"].map((item) => <div class="rounded-xl border border-border bg-card p-5">{item}</div>)}</div><p class="mt-8 text-xl font-semibold text-primary-accent">These are business-system problems.</p></div></section>
  <section class="border-y border-border bg-card/30 px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><h2 class="text-4xl font-semibold">Start with the problem in front of you.</h2><div class="mt-10 grid gap-3 md:grid-cols-2">{resolvedPaths.map(({ problem, product }) => <a href={`/products/${product.data.slug}/`} class="group flex items-center justify-between rounded-xl border border-border bg-card p-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline" data-event="problem_path" data-product-slug={product.data.slug}><span>{problem}</span><span class="text-primary-accent group-hover:translate-x-1 motion-reduce:transform-none">{product.data.title} →</span></a>)}</div><p class="mt-7"><Button as="a" href="/start/" variant="outline">Use the Start Here guide</Button></p></div></section>
  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2"><div><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Free starting point</p><h2 class="mt-3 text-4xl font-semibold">Developer Marketing Quickstart</h2><p class="mt-5 text-lg leading-8 text-muted-foreground">Build a minimum viable customer-acquisition system in seven days: target, problem, offer, message, buyer source, next action, and measurement.</p><div class="mt-8"><Button as="a" href="/free/">See the Quickstart</Button></div></div><KitForm kind="quickstart" /></div></section>
  <section class="border-y border-border bg-card/30 px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><h2 class="text-4xl font-semibold">Executable systems, not disconnected tactics.</h2><ol class="mt-10 grid gap-3 sm:grid-cols-3 lg:grid-cols-6">{["Learn","Decide","Implement","Execute","Measure","Improve"].map((step,index) => <li class="rounded-xl border border-border bg-card p-5"><span class="font-mono text-xs text-primary-accent">0{index+1}</span><p class="mt-3 font-semibold">{step}</p></li>)}</ol></div></section>
  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><h2 class="text-4xl font-semibold">One catalog, organized around the next system.</h2><div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{families.map((family) => <Card><CardHeader><CardTitle>{family}</CardTitle></CardHeader><CardContent><p class="text-sm text-muted-foreground">{products.filter((p)=>p.data.family===family).length} focused system{products.filter((p)=>p.data.family===family).length === 1 ? "" : "s"}</p><a href={`/products/#${family.toLowerCase().replaceAll(" ","-").replaceAll("&","")}`} class="mt-4 inline-block font-semibold text-primary-accent">Explore family →</a></CardContent></Card>)}</div></div></section>
  <section class="border-t border-border px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><h2 class="text-4xl font-semibold">Two useful next steps.</h2><div class="mt-10 grid gap-5 md:grid-cols-2">{nextSteps.map((product) => <ProductCard product={product} />)}</div><div class="mt-8 flex flex-wrap gap-3"><Button as="a" href="/free/">Get the Free Quickstart</Button><Button as="a" href="/products/" variant="outline">Browse All Products</Button></div></div></section>
</BaseLayout>
