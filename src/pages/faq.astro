---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import FAQList from "@/components/ui/FAQList.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";

const faqs = (await getCollection("faqs")).sort((a, b) => a.data.order - b.data.order);
const purchaseCategory = "Orders, access & refunds";
const productFaqs = faqs.filter((faq) => faq.data.category !== purchaseCategory);
const purchaseFaqs = faqs.filter((faq) => faq.data.category === purchaseCategory);
---

<BaseLayout
  title="FAQ | Developer Business Lab"
  description="Answers about choosing Developer Business Lab products, accessing purchases, downloads, licenses, coupons, and refunds."
>
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="FAQ"
    title="Questions about choosing a system, placing an order, or getting support?"
    description="Use the product section before you buy and the order section after checkout. These answers cover the situations most customers are likely to need without turning the FAQ into a support manual."
  />

  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <p class="editorial-kicker">Products</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">Choose the system that matches the problem you are solving.</h2>
      <p class="mt-5 max-w-3xl leading-7 text-muted-foreground">These questions explain where the current products start and stop, how the bundles fit together, and when a focused product makes more sense.</p>
      <div class="mt-10"><FAQList faqs={productFaqs} /></div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <p class="editorial-kicker">Orders, access & refunds</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">The common questions after checkout.</h2>
      <p class="mt-5 max-w-3xl leading-7 text-muted-foreground">Lemon Squeezy handles checkout, order records, receipts, and digital delivery. Developer Business Lab handles product support and refund requests under the posted policy.</p>
      <div class="mt-10"><FAQList faqs={purchaseFaqs} /></div>
      <div class="mt-8 flex flex-col gap-3 text-sm sm:flex-row sm:items-center sm:gap-6">
        <a href="/support/" class="font-semibold text-primary-accent hover:underline">Open the Support Center →</a>
        <a href="/refund-policy/" class="font-semibold text-primary-accent hover:underline">Read the Refund Policy →</a>
      </div>
    </div>
  </section>
</BaseLayout>
