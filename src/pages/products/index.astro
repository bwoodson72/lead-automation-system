---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FeaturedProductCard from "@/components/products/FeaturedProductCard.astro";
import { isPublicProduct } from "@/lib/storefront-visibility";

const products = (await getCollection("products"))
  .filter(isPublicProduct)
  .sort((a, b) => a.data.order - b.data.order);

const problems = [
  ["01", "Offer", "Prospects still make me explain what I actually sell", "productize-your-dev-skills"],
  ["02", "Pricing", "Every serious quote still feels partly made up", "web-developer-pricing-system"],
  ["03", "Pipeline", "My pipeline disappears whenever client work gets busy", "client-acquisition-without-upwork"],
  ["04", "Marketing", "Less capable competitors look easier to hire than I do", "marketing-for-builders"],
  ["05", "Sales", "Good sales calls keep ending without a real decision", "developer-sales-playbook"],
  ["06", "Closing", "I spend too much time on proposals that do not close cleanly", "developer-proposal-closing-kit"],
  ["07", "Partnerships", "I want repeat agency work without discounting myself into a bad deal", "agency-partnership-playbook"],
  ["08", "Retention", "Successful projects end and my revenue resets anyway", "freelancer-retainer-system"],
];
---

<BaseLayout
  title="Products | Developer Business Lab"
  description="Business systems for independent developers who want clearer offers, stronger pricing, dependable client acquisition, better sales, and more recurring revenue."
>
  <section class="border-b border-border px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="editorial-kicker">Developer Business Lab systems</p>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_.7fr] lg:items-end">
        <h1 class="max-w-4xl text-5xl font-semibold tracking-[-0.04em] sm:text-6xl">Fix the bottleneck before you buy another tactic.</h1>
        <div>
          <p class="text-lg leading-8 text-muted-foreground">Focused systems for the parts of freelancing technical skill alone does not solve: offer, pricing, acquisition, sales, closing, partnerships, and recurring revenue.</p>
          <p class="mt-5"><a href="/start/" class="font-semibold text-primary-accent">Not sure where to start? Find the bottleneck →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-border bg-card/35 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="editorial-kicker">Choose by problem</p>
      <div class="mt-7 border-t border-border">
        {problems.map(([number, stage, problem, slug]) => (
          <a href={`/products/${slug}/`} class="group grid gap-3 border-b border-border py-5 sm:grid-cols-[4rem_8rem_1fr_auto] sm:items-center" data-event="problem_path">
            <span class="font-mono text-xs text-primary-accent">{number}</span>
            <span class="text-xs font-semibold uppercase tracking-[.14em] text-muted-foreground">{stage}</span>
            <span class="text-lg">{problem}</span>
            <span class="font-semibold text-primary-accent">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-3xl">
        <p class="editorial-kicker">The library</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">One focused commercial problem at a time.</h2>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">Each system is designed to stand on its own. Start where the business is leaking, then add the next system when another constraint becomes more important.</p>
      </div>
      <div class="mt-10 grid gap-x-12 lg:grid-cols-2">
        {products.map((product) => <FeaturedProductCard product={product} />)}
      </div>
    </div>
  </section>
</BaseLayout>
