---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import TextLink from "@/components/ui/TextLink.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { isPublicProduct } from "@/lib/storefront-visibility";

const products = (await getCollection("products")).filter(isPublicProduct);
const productBySlug = (slug: string) => products.find((entry) => entry.data.slug === slug);

const routes = [
  {
    stage: "Offer",
    problem: "You can build many things, but every inquiry forces you to explain from scratch what you actually sell.",
    change: "Create one offer a buyer can understand, evaluate, and react to without helping invent the commercial job first.",
    slug: "productize-your-dev-skills",
  },
  {
    stage: "Pricing",
    problem: "A buyer asks what the project costs before you are confident what the full obligation will consume.",
    change: "Understand the engagement, workload, uncertainty, and economics before the client-facing price becomes a promise.",
    slug: "web-developer-pricing-system",
  },
  {
    stage: "Marketing",
    problem: "Your technical work is stronger than the way the market currently understands it.",
    change: "Make the commercial meaning, proof, and buyer relevance easier for the right people to see and trust.",
    slug: "marketing-for-builders",
  },
  {
    stage: "Acquisition",
    problem: "The current project is ending and there is not enough qualified opportunity behind it.",
    change: "Build a visible acquisition process that can keep buyer access moving while delivery is busy.",
    slug: "client-acquisition-without-upwork",
  },
  {
    stage: "Social",
    problem: "Social gets attention, but you cannot tell whether it is contributing to useful buyer relationships or pipeline.",
    change: "Give social a commercial role built around relevance, proof, relationships, conversations, and attribution.",
    slug: "social-media-client-acquisition-system",
  },
  {
    stage: "Agencies",
    problem: "Agency work looks promising, but future volume is starting to influence rates, capacity, or availability before it is earned.",
    change: "Test agency relationships through paid work and deepen commitment only when demand, economics, and delivery behavior justify it.",
    slug: "agency-partnership-playbook",
  },
  {
    stage: "Sales",
    problem: "Buyer conversations feel positive, but too many end without an explicit commercial decision.",
    change: "Know whether the next step is more discovery, paid discovery, reshape, nurture, decline, or Proposal Ready.",
    slug: "developer-sales-playbook",
  },
  {
    stage: "Closing",
    problem: "The opportunity is ready, but scope, review, negotiation, payment, or project start still feels loose.",
    change: "Carry a Proposal Ready opportunity into one current commercial agreement, payment, and a Start-Ready project.",
    slug: "developer-proposal-closing-kit",
  },
  {
    stage: "Retention",
    problem: "A good project ends, the client still has a legitimate need, and the next commercial relationship is undefined.",
    change: "Decide whether the continuing job belongs in another project, ad hoc work, a recurring service, or a clean ending.",
    slug: "freelancer-retainer-system",
  },
];

const resolved = routes.flatMap((route) => {
  const product = productBySlug(route.slug);
  return product ? [{ ...route, product }] : [];
});
---

<BaseLayout title="Start Here | Developer Business Lab" description="Turn an unclear freelance business problem into one focused next move with the Developer Business Lab system that matches it.">
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and workbooks on a developer workspace"
    eyebrow="Start here"
    title="Turn something about this business isn't working into one clear next move."
    description="Start with the situation you recognize. If one problem is clearly limiting the business, go directly to the focused system. If several keep feeding one another, use the broader foundation."
    primaryCta={{ label: "Find My Problem", href: "#routes" }}
    secondaryCta={{ label: "Start Free", href: "/free/" }}
    supportingItems={["Choose by business condition", "No required buying sequence", "Start with the smallest useful scope"]}
  />

  <section id="routes" class="scroll-mt-24 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
        <div><p class="editorial-kicker">What keeps happening?</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Choose the business condition you want to leave behind.</h2></div>
        <p class="max-w-2xl text-lg leading-8 text-muted-foreground">The product name is secondary. Start with the moment that is costing money, opportunity, margin, time, or confidence in the business.</p>
      </div>

      <div class="mt-10 divide-y divide-border border-y border-border">
        {resolved.map(({ stage, problem, change, product }) => (
          <article class="grid gap-5 py-8 lg:grid-cols-[7rem_1fr_1fr_auto] lg:items-start lg:gap-8">
            <p class="pt-1 text-xs font-semibold uppercase tracking-[.14em] text-muted-foreground">{stage}</p>
            <h3 class="text-xl font-semibold leading-8">{problem}</h3>
            <p class="leading-7 text-muted-foreground">{change}</p>
            <div class="lg:pt-1"><TextLink href={`/products/${product.data.slug}/`}>{product.data.title} →</TextLink></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
      <div><p class="editorial-kicker">If several routes sounded familiar</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">The problem may be broader than one specialist system.</h2></div>
      <div class="space-y-5 text-lg leading-8 text-muted-foreground">
        <p>A thin pipeline can put pressure on pricing. A vague offer can weaken marketing. Poor qualification can create proposal waste. Busy delivery can stop acquisition. A successful project can still return revenue to zero.</p>
        <p>Use the <a class="font-semibold text-primary-accent hover:underline" href="/products/freelance-developer-launch-kit/">Freelance Developer Launch Kit</a> when you need the first coherent operating foundation across the whole business.</p>
      </div>
    </div>
  </section>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2 lg:gap-20">
      <div><p class="editorial-kicker">If one stage contains several connected problems</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">A bundle may be the right scope.</h2><p class="mt-5 text-lg leading-8 text-muted-foreground">Use a bundle when fixing one piece would still leave the larger outcome constrained by other decisions in the same part of the business.</p><p class="mt-7"><TextLink href="/bundles/">Compare the bundles →</TextLink></p></div>
      <div><p class="editorial-kicker">If acquisition is the first move</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Run one real cycle for free.</h2><p class="mt-5 text-lg leading-8 text-muted-foreground">Developer Marketing Quickstart gives you a guide and workbook for choosing a buyer, investigating a problem, building a provisional offer, qualifying a First 25, working the cycle, and deciding what to test next.</p><p class="mt-7"><TextLink href="/free/">Get Developer Marketing Quickstart →</TextLink></p></div>
    </div>
  </section>
</BaseLayout>
