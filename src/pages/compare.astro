---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTASection from "@/components/marketing/CTASection.astro";
const rows = [
["Evidence-first qualification","Yes","Yes","Yes","Yes"],["Google Sheets state","Yes","Yes","Primary","Non-primary"],["Human-led workflow","Primary","Reduced","Minimal operational","Administrative"],["Scheduled ChatGPT","No","Yes","Not primary","Not primary"],["APIs","No","No","Yes","Yes"],["n8n","No","No","Yes","Non-primary"],["Automated discovery","Assisted","Scheduled / assisted","Yes","Yes"],["Automated site evidence","No","Assisted","Yes","Yes"],["Contact enrichment","Manual / optional","Assisted","Automated","Automated"],["Webhooks","No","No","Yes","Yes"],["PostgreSQL","No","No","No","Yes"],["Job queue / workers","No","No","No","Yes"],["Best for","Learning the system","Recurring operation","Freelancer automation","Production software"],["Complexity","Low","Low-medium","Medium","High"]];
---
<BaseLayout title="Compare the Lead Automation System Guides" description="Compare all four Lead Automation System PDF guides by operational bottleneck, automation, tools, complexity, and architecture."><section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Tier comparison</p><h1 class="mt-4 text-5xl font-semibold tracking-tight">Which Lead Automation System Is Right for You?</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">Choose the lowest tier that removes the bottleneck you actually have. More automation is useful only when it solves a real operational problem.</p><div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">{[[1,"I need a repeatable prospecting method."],[2,"The method works, but I keep having to restart the work manually."],[3,"I want the repetitive pipeline to process leads through connected workflows."],[4,"I need the engine to operate as durable, extensible software."]].map(([tier, text]) => <div class="rounded-xl border border-primary/20 bg-card p-5"><p class="font-mono text-xs text-primary-accent">TIER {tier}</p><p class="mt-3 font-semibold leading-6">“{text}”</p></div>)}</div><h2 class="mt-16 text-3xl font-semibold">Compare the technical details</h2><div class="mt-8 overflow-x-auto rounded-xl border border-border"><table class="w-full min-w-5xl text-left text-sm"><caption class="sr-only">Feature comparison across the four guides</caption><thead class="bg-muted"><tr><th scope="col" class="p-4">Capability</th><th scope="col" class="p-4">Tier 1</th><th scope="col" class="p-4">Tier 2</th><th scope="col" class="p-4">Tier 3</th><th scope="col" class="p-4">Tier 4</th></tr></thead><tbody class="divide-y divide-border">{rows.map((row) => <tr><th scope="row" class="p-4 font-medium">{row[0]}</th>{row.slice(1).map((cell) => <td class="p-4 text-muted-foreground">{cell}</td>)}</tr>)}</tbody></table></div><div class="mt-16 rounded-2xl border border-border bg-card p-8"><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Build vs. subscribe</p><h2 class="mt-3 text-3xl font-semibold">Why These Guides Instead of Another Prospecting Subscription?</h2><p class="mt-5 max-w-4xl leading-7 text-muted-foreground">A prospecting subscription gives you access to a product. These guides teach you how to design the acquisition process itself and choose the level of ownership that makes sense. You may still use commercial tools—they perform jobs inside a system whose qualification rules, evidence requirements, workflow, and state you understand.</p><div class="mt-8 grid gap-4 md:grid-cols-3"><div><h3 class="font-semibold">Specificity</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">Design qualification around actual web-development opportunities.</p></div><div><h3 class="font-semibold">Portability</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">Keep providers replaceable as needs change, while recognizing that integrations require work.</p></div><div><h3 class="font-semibold">Control</h3><p class="mt-2 text-sm leading-6 text-muted-foreground">Decide what gets automated, stored, and verified.</p></div></div></div></div></section><CTASection title="Start With the Lowest Tier That Fits." description="More infrastructure is useful only when your process and operating needs justify it." primaryLabel="View All Products" primaryHref="/products/" /></BaseLayout>
