---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
---
<BaseLayout title="Page Not Found | Prospect Foundry" description="The requested page could not be found." noindex={true}><section class="grid min-h-[60vh] place-items-center px-4 py-20 text-center"><div><p class="font-mono text-sm text-primary-accent">404 · NOT FOUND</p><h1 class="mt-4 text-5xl font-semibold">This path reached a dead end.</h1><p class="mx-auto mt-5 max-w-xl text-lg text-muted-foreground">The page may have moved, or the address may be incorrect.</p><div class="mt-8 flex justify-center gap-3"><Button as="a" href="/">Return home</Button><Button as="a" href="/products/" variant="outline">View products</Button></div></div></section></BaseLayout>
