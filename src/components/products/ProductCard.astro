---
import { Image } from "astro:assets";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from "@/components/starwind/card";
import { resolveProductCoverImage } from "@/lib/product-cover-images";

const {
  product,
  eventName = "product_view",
  ctaLabel = "See how it works",
} = Astro.props;
const d = product.data;
const statusLabel = d.status === "coming-soon" ? "Coming soon" : d.status === "planned" ? "Planned" : d.free ? "Free" : d.price ? `$${d.price}` : "Available";
const coverImage = resolveProductCoverImage(d);
---

<Card class="flex h-full flex-col overflow-hidden border-border bg-card/70">
  <a href={`/products/${d.slug}/`} class="block border-b border-border bg-card" aria-label={`View ${d.title}`}>
    <div class="aspect-4/3 w-full overflow-hidden">
      {coverImage ? (
        <Image
          src={coverImage}
          alt={`${d.title} product cover`}
          class="h-full w-full object-contain p-4"
          widths={[360, 540, 720]}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
      ) : (
        <div
          class="relative flex h-full w-full flex-col bg-card p-5"
          role="img"
          aria-label={`${d.title} generated product cover`}
        >
          <div class="absolute inset-x-0 top-0 h-1.5 bg-primary"></div>
          <p class="font-mono text-[10px] font-semibold uppercase tracking-widest text-primary-accent">Developer Business Lab</p>
          <div class="my-auto">
            <p class="text-xs font-medium text-muted-foreground">{d.family}{d.tier ? ` · Tier ${d.tier}` : ""}</p>
            <p class="mt-2 text-2xl font-semibold tracking-tight">{d.title}</p>
          </div>
          <div class="grid grid-cols-5 gap-1.5" aria-hidden="true">
            {[1, 2, 3, 4, 5].map((n) => (
              <span class:list={["h-1.5 rounded-full", n < 4 ? "bg-primary" : "bg-muted"]}></span>
            ))}
          </div>
        </div>
      )}
    </div>
  </a>
  <CardHeader>
    <div class="mb-4 flex flex-wrap gap-2">
      <Badge variant="outline">{d.family}</Badge>
      {d.tier && <Badge variant="outline">Tier {d.tier}</Badge>}
      <Badge variant={d.status === "available" ? "default" : "secondary"}>{statusLabel}</Badge>
    </div>
    <CardTitle class="text-xl">{d.title}</CardTitle>
  </CardHeader>
  <CardContent class="flex-1">
    <p class="leading-7 text-muted-foreground">{d.shortDescription}</p>
    <p class="mt-5 text-sm"><strong>Best for:</strong> <span class="text-muted-foreground">{d.audience}</span></p>
  </CardContent>
  <CardFooter>
    <Button as="a" href={`/products/${d.slug}/`} variant="secondary" data-event={eventName} data-product-slug={d.slug}>{ctaLabel}</Button>
  </CardFooter>
</Card>
