---
import { siteConfig } from "@/config";
interface Props { placement: string; }
const { placement } = Astro.props;
const formId = siteConfig.kit.newsletterFormId;
const uid = siteConfig.kit.newsletterFormUid;
const options = {
  settings: {
    after_subscribe: {
      action: "message",
      success_message: "Thanks! Please check your email to confirm your subscription.",
      redirect_url: "",
    },
    analytics: { google: null, fathom: null, facebook: null, segment: null, pinterest: null, sparkloop: null, googletagmanager: null },
    powered_by: { show: true, url: "https://kit.com/features/forms" },
    recaptcha: { enabled: false },
    return_visitor: { action: "show", custom_content: "" },
  },
  version: "5",
};
const inputId = "dbl-newsletter-email-" + placement;
---

  <form
    action={"https://app.kit.com/forms/" + formId + "/subscriptions"}
    method="post"
    class="seva-form formkit-form dbl-newsletter-form"
    data-dbl-newsletter-form
    data-dbl-placement={placement}
    data-sv-form={formId}
    data-uid={uid}
    data-format="inline"
    data-version="5"
    data-options={JSON.stringify(options)}
  >
    <ul class="formkit-alert formkit-alert-error" data-element="errors" data-group="alert" aria-live="polite"></ul>
    <div data-element="fields" class="seva-fields formkit-fields" data-stacked="false">
      <div class="formkit-field">
        <label class="sr-only" for={inputId}>Email address</label>
        <input id={inputId} class="formkit-input" name="email_address" type="email" autocomplete="email" placeholder="Your email address" required />
      </div>
      <button data-element="submit" class="formkit-submit" type="submit"><span>Get the Weekly Fix</span></button>
    </div>
    <p class="formkit-guarantee" data-element="guarantee">
      Free weekly business advice, plus occasional subscriber-only offers. Unsubscribe anytime.
      <a href="/privacy/">Privacy policy</a>.
    </p>
    <p class="dbl-kit-credit"><a href="https://kit.com/features/forms" rel="nofollow noopener" target="_blank">Built with Kit</a></p>
  </form>
