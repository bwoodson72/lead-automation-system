---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
import { button } from "@/components/starwind/button/variants";
import { bundleProgression } from "@/lib/bundle-progression";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";
import { resolveProductCoverImage } from "@/lib/product-cover-images";
import { isPublicBundle } from "@/lib/storefront-visibility";

const bundles = (await getCollection("bundles")).filter(isPublicBundle);
const products = await getCollection("products");
const checkoutClass = button({ class: "lemonsqueezy-button w-full text-center sm:w-auto" });

const resolvedBundles = bundleProgression.map((definition) => {
  const bundle = bundles.find((entry) => entry.data.slug === definition.slug);
  const commerce = bundle ? resolveProductCommerce(bundle.data) : undefined;
  const sourceSlugs = bundle?.data.products?.length ? bundle.data.products : definition.productSlugs;
  const included = sourceSlugs
    .map((slug) => products.find((product) => product.data.slug === slug))
    .filter(Boolean);
  const image = bundle && commerce?.product?.id
    ? resolveProductCoverImage(bundle.data, commerce.product.id)
    : undefined;

  return {
    ...definition,
    title: bundle?.data.title ?? definition.title,
    outcome: bundle?.data.outcome ?? definition.outcome,
    status: commerce?.effectiveStatus ?? bundle?.data.status ?? "planned",
    purchasable: commerce?.purchasable ?? false,
    priceFormatted: commerce?.priceFormatted,
    checkoutUrl: commerce?.checkoutUrl,
    image,
    included,
    expectedCount: sourceSlugs.length,
  };
});

const hasCheckout = resolvedBundles.some((bundle) => bundle.purchasable);
---

<BaseLayout
  title="Bundles | Developer Business Lab"
  description="Developer Business Lab bundles progress from freelance foundations through acquisition, sales and retention, SaaS, and the complete builder library."
  enableCheckoutOverlay={hasCheckout}
>
  <section class="border-b border-border px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="editorial-kicker">Business system bundles</p>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_.7fr] lg:items-end">
        <h1 class="max-w-4xl text-5xl font-semibold tracking-[-0.04em] sm:text-6xl">Add depth by stage, not another random pile of tactics.</h1>
        <p class="text-lg leading-8 text-muted-foreground">The bundle progression follows the business: establish the foundation, build acquisition, strengthen sales and retention, validate and launch SaaS, then connect the broader builder library.</p>
      </div>
    </div>
  </section>

  <section class="border-b border-border bg-card/35 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div class="max-w-3xl">
        <p class="editorial-kicker">Not sure which stage is broken?</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight">Start with the Freelance Developer Launch Kit.</h2>
        <p class="mt-4 text-lg leading-8 text-muted-foreground">The Launch Kit is the integrated starting system. It shows how market, offer, pricing, acquisition, sales, delivery, referrals, and recurring revenue depend on one another. Use bundles when you already want deeper specialist coverage across a related stage.</p>
      </div>
      <Button as="a" href="/products/freelance-developer-launch-kit/" size="lg">Start with the Launch Kit</Button>
    </div>
  </section>

  <section class="px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {resolvedBundles.map((bundle) => (
          <a href={`#${bundle.slug}`} class="group border border-border bg-card/35 p-5 transition-colors hover:border-primary/35">
            <p class="font-mono text-xs text-primary-accent">{bundle.step}</p>
            <p class="mt-2 text-xs font-semibold uppercase tracking-[.14em] text-muted-foreground">{bundle.stage}</p>
            <p class="mt-3 font-semibold transition-colors group-hover:text-primary-accent">{bundle.title}</p>
          </a>
        ))}
      </div>

      <div class="mt-10 border-t border-border">
        {resolvedBundles.map((bundle) => {
          const visible = bundle.included.slice(0, 4);
          const remaining = Math.max(bundle.expectedCount - visible.length, 0);
          return (
            <article id={bundle.slug} class="scroll-mt-24 border-b border-border py-10 sm:py-12">
              <div class="grid gap-8 lg:grid-cols-[5rem_.8fr_1.2fr] lg:items-start">
                <div>
                  <p class="font-mono text-sm text-primary-accent">{bundle.step}</p>
                  <p class="mt-2 text-[.65rem] font-semibold uppercase tracking-[.14em] text-muted-foreground">{bundle.stage}</p>
                </div>

                <div>
                  {bundle.image && (
                    <div class="mb-7 aspect-4/5 w-full max-w-xs overflow-hidden rounded-2xl border border-primary/30 bg-card shadow-xl">
                      <Image
                        src={bundle.image}
                        alt={`${bundle.title} bundle mockup`}
                        class="h-full w-full object-contain"
                        widths={[320, 480, 640]}
                        sizes="(min-width: 1024px) 20rem, 80vw"
                      />
                    </div>
                  )}
                  <p class="editorial-kicker">Bundle</p>
                  <h2 class="mt-3 text-3xl font-semibold tracking-tight">{bundle.title}</h2>
                  <p class="mt-5 text-sm leading-6 text-muted-foreground">{bundle.step === "04" ? "The Launch Kit supplies the integrated operating map. The focused systems add deeper specialist guidance at the major commercial stages." : "A focused multi-product system for this stage of the builder business."}</p>
                </div>

                <div>
                  <p class="text-lg leading-8 text-muted-foreground">{bundle.outcome}</p>
                  <div class="mt-7 border-t border-border">
                    {visible.map((product: any) => (
                      <div class="flex items-center justify-between gap-4 border-b border-border py-3.5">
                        <span class="text-sm sm:text-base">{product.data.title}</span>
                        <span class="text-primary-accent" aria-hidden="true">✓</span>
                      </div>
                    ))}
                    {remaining > 0 && <p class="py-3.5 text-sm font-medium text-muted-foreground">+ {remaining} more system{remaining === 1 ? "" : "s"}</p>}
                    {visible.length === 0 && bundle.purchasable && <p class="py-4 text-sm text-muted-foreground">Broad catalog access across the current builder-business library.</p>}
                    {visible.length === 0 && !bundle.purchasable && <p class="py-4 text-sm text-muted-foreground">Included products will appear here as the bundle catalog is populated.</p>}
                  </div>

                  <div class="mt-7 flex flex-wrap items-center gap-4">
                    {bundle.purchasable ? (
                      <>
                        <p class="text-2xl font-semibold">{bundle.priceFormatted}</p>
                        <a
                          href={bundle.checkoutUrl!}
                          class={checkoutClass}
                          data-event="checkout_click"
                          data-product-slug={bundle.slug}
                          data-cta-location="bundles"
                        >
                          Get {bundle.title}
                        </a>
                      </>
                    ) : bundle.status === "coming-soon" ? (
                      <>
                        <span class="inline-flex border border-primary/35 px-4 py-2 text-xs font-semibold uppercase tracking-[.14em] text-primary-accent">Coming soon</span>
                        <p class="text-sm text-muted-foreground">Checkout will appear automatically when this bundle is published in Lemon Squeezy.</p>
                      </>
                    ) : (
                      <>
                        <span class="inline-flex border border-primary/35 px-4 py-2 text-xs font-semibold uppercase tracking-[.14em] text-primary-accent">In development</span>
                        <p class="text-sm text-muted-foreground">Pricing and checkout will appear automatically when the bundle is released.</p>
                      </>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-card/35 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl text-center">
      <p class="editorial-kicker">Choose by scope</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-tight">Whole business unclear? Launch Kit. One bottleneck? Focused guide. Several related bottlenecks? Bundle.</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">The goal is not to buy the biggest package. It is to use the smallest system that matches the actual scope of the problem.</p>
      <p class="mt-7"><a href="/start/" class="font-semibold text-primary-accent">Choose the right starting point →</a></p>
    </div>
  </section>
</BaseLayout>
