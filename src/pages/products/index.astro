---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import TextLink from "@/components/ui/TextLink.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { isPublicProduct } from "@/lib/storefront-visibility";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";

const products = (await getCollection("products")).filter(isPublicProduct);
const productBySlug = (slug: string) => products.find((entry) => entry.data.slug === slug);
const priceFor = (slug: string) => {
  const product = productBySlug(slug);
  if (!product) return undefined;
  return resolveProductCommerce(product.data).priceFormatted;
};

const stages = [
  {
    eyebrow: "Define",
    title: "What you sell",
    products: [
      ["productize-your-dev-skills", "Turn everything you can build into one clear service the right clients understand and buy."],
    ],
  },
  {
    eyebrow: "Price",
    title: "What you charge",
    products: [
      ["web-developer-pricing-system", "Know what a project really costs you, whether it's worth taking, and what price and terms make sense."],
    ],
  },
  {
    eyebrow: "Attract",
    title: "How clients find you",
    products: [
      ["marketing-for-builders", "Make buyers understand why your work is worth paying for, so every channel works better."],
      ["client-acquisition-without-upwork", "Build a pipeline that keeps new opportunities moving while you're busy delivering."],
      ["social-media-client-acquisition-system", "Turn your time on social media into real conversations with buyers."],
      ["agency-partnership-playbook", "Build agency relationships that send steady, profitable work without owning your income."],
    ],
  },
  {
    eyebrow: "Sell",
    title: "How you close the deal",
    products: [
      ["developer-sales-playbook", "Turn good sales conversations into clear decisions, without scripts or pressure."],
      ["developer-proposal-closing-kit", "Get the deal signed, paid, and started without giving away your margin."],
    ],
  },
  {
    eyebrow: "Retain",
    title: "How clients keep paying you",
    products: [
      ["freelancer-retainer-system", "Turn successful projects into steady monthly income, with boundaries that protect your time."],
    ],
  },
] as const;

const launchKit = productBySlug("freelance-developer-launch-kit");
const launchKitPrice = priceFor("freelance-developer-launch-kit");
---

<BaseLayout title="Products | Developer Business Lab" description="Browse every Developer Business Lab system by stage of the freelance development business: define, price, attract, sell, and retain.">
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="Products"
    title="Every system, one catalog."
    description="Practical guides and fill-in workbooks for every stage of a freelance development business: defining what you sell, pricing it, finding clients, closing deals, and keeping them."
  >
    <div slot="actions"><a class="font-semibold text-primary-accent underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline" href="/start/">Not sure what you need? Start Here →</a></div>
  </PageHero>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="editorial-kicker">The foundation</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-tight">The whole business, built as one system</h2>
      {launchKit && (
        <div class="mt-10 border border-border bg-background p-7 lg:p-9">
          <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
            <div>
              <h3 class="text-3xl font-semibold">Freelance Developer Launch Kit</h3>
              <p class="mt-4 max-w-4xl text-lg leading-8 text-muted-foreground">Your offer, pricing, client pipeline, sales, delivery, and a regular review that shows what to fix next, all connected. Complete on its own, and the best starting point when several parts of the business need work.</p>
              <p class="mt-5 text-sm text-muted-foreground">The systems below each take one part of the business much deeper than the Launch Kit does.</p>
            </div>
            <div class="lg:text-right">
              {launchKitPrice && <p class="text-lg font-semibold">{launchKitPrice}</p>}
              <p class="mt-4"><TextLink href="/products/freelance-developer-launch-kit/">Learn more →</TextLink></p>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  {stages.map((stage, index) => (
    <section class={index % 2 === 0 ? "border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8" : "px-4 py-18 sm:px-6 sm:py-24 lg:px-8"}>
      <div class="mx-auto max-w-7xl">
        <p class="editorial-kicker">{stage.eyebrow}</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">{stage.title}</h2>
        <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border md:grid-cols-2">
          {stage.products.map(([slug, description]) => {
            const product = productBySlug(slug);
            if (!product) return null;
            const price = priceFor(slug);
            return (
              <article class="bg-background p-7">
                <h3 class="text-2xl font-semibold">{product.data.title}</h3>
                <p class="mt-4 leading-7 text-muted-foreground">{description}</p>
                <p class="mt-5 flex flex-wrap items-center gap-2 text-sm">
                  {price && <strong>{price}</strong>}
                  {price && <span aria-hidden="true">·</span>}
                  <TextLink href={`/products/${product.data.slug}/`}>Learn more →</TextLink>
                </p>
              </article>
            );
          })}
          {stage.eyebrow === "Attract" && (
            <article class="bg-background p-7">
              <div class="flex flex-wrap items-center gap-2"><h3 class="text-2xl font-semibold">Developer Marketing Quickstart</h3><span class="text-sm italic text-muted-foreground">Free</span></div>
              <p class="mt-4 leading-7 text-muted-foreground">Run one real round of finding clients and reach your first 25 qualified prospects.</p>
              <p class="mt-5"><TextLink href="/free/">Get it free →</TextLink></p>
            </article>
          )}
        </div>
      </div>
    </section>
  ))}

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="editorial-kicker">Bundles</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-tight">Several connected problems? Fix them together for less.</h2>
      <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border md:grid-cols-2">
        <div class="bg-background p-7"><p><strong>Freelancer Starter Bundle:</strong> offer, pricing, and marketing.</p></div>
        <div class="bg-background p-7"><p><strong>Client Acquisition Bundle:</strong> several reliable routes to new clients.</p></div>
        <div class="bg-background p-7"><p><strong>Freelancer Sales System:</strong> from first sales call to monthly revenue.</p></div>
        <div class="bg-background p-7"><p><strong>Freelance Developer Business System:</strong> the Launch Kit plus all nine specialist systems.</p></div>
      </div>
      <p class="mt-7"><TextLink href="/bundles/">See all bundles →</TextLink></p>
    </div>
  </section>

  <section class="border-t border-border bg-card/35 px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl text-sm text-muted-foreground">Every purchase is covered by Developer Business Lab's 14-Day Satisfaction Guarantee. <a class="font-semibold text-primary-accent hover:underline" href="/refund-policy/">Read the full refund policy</a></div>
  </section>
</BaseLayout>
