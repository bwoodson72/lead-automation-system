---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import { Button } from "@/components/starwind/button";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";
import { getBundleMerchandising } from "@/lib/bundle-merchandising";
import { isPublicBundle, isPublicProduct } from "@/lib/storefront-visibility";

const affiliateApplicationUrl = "https://developerbusinesslab.lemonsqueezy.com/affiliates";
const commissionRate = 0.3;
const products = (await getCollection("products")).filter(isPublicProduct);
const bundles = (await getCollection("bundles")).filter(isPublicBundle);

const parsePrice = (formatted?: string) => {
  if (!formatted) return undefined;
  const value = Number(formatted.replace(/[^0-9.]/g, ""));
  return Number.isFinite(value) ? value : undefined;
};

const money = (value?: number) => value === undefined
  ? undefined
  : new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: "USD",
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(value);

const launchKit = products.find((entry) => entry.data.slug === "freelance-developer-launch-kit");
const launchCommerce = launchKit ? resolveProductCommerce(launchKit.data) : undefined;
const launchPrice = parsePrice(launchCommerce?.priceFormatted);
const launchCommission = money(launchPrice === undefined ? undefined : launchPrice * commissionRate);

const completeBundle = bundles.find((entry) => entry.data.slug === "freelance-developer-business-system");
const completeMerch = completeBundle ? getBundleMerchandising(completeBundle, products) : undefined;
const completeCommission = money(
  completeMerch?.bundlePrice === undefined ? undefined : completeMerch.bundlePrice * commissionRate,
);

const specialistProducts = [
  ["Offer & niche", "Productize Your Dev Skills"],
  ["Pricing", "Web Developer Pricing System"],
  ["Marketing", "Marketing for Builders"],
  ["Finding clients", "Client Acquisition Without Upwork"],
  ["Social media", "Social Media Client Acquisition System for Freelancers"],
  ["Sales calls", "Developer Sales Playbook"],
  ["Proposals & closing", "Developer Proposal & Closing Kit"],
  ["Agency partnerships", "Agency Partnership Playbook"],
  ["Recurring revenue", "Freelancer Retainer System"],
];

const partnerTypes = [
  "Freelance-development YouTubers",
  "Developer newsletters",
  "Coding educators who cover freelancing",
  "Web-design and agency educators",
  "Developer communities",
  "Indie developer and solopreneur creators",
];

const promotionAssets = [
  "Product mockups and social graphics",
  "Pain points and angles that resonate",
  "Approved product descriptions and CTAs",
  "Direct links to every product",
  "Ready-to-use copy ideas",
];

const faqs = [
  {
    question: "When and how do I get paid?",
    answer: "Lemon Squeezy handles affiliate payouts. Approved referral commissions are held for 30 days. Payouts are created on the 1st and 15th and paid on the 14th and 28th. Affiliates can receive payouts through a supported bank account or PayPal.",
  },
  {
    question: "Is there a minimum payout?",
    answer: "Lemon Squeezy's default affiliate payout threshold is $10. If the threshold shown in your Affiliate Hub is different, the amount shown there controls.",
  },
  {
    question: "Do bundles earn commission?",
    answer: "Yes. Eligible Developer Business Lab bundles are included at the same 30% commission rate.",
  },
  {
    question: "What if I send someone to the free Quickstart first?",
    answer: "The Quickstart itself does not pay a commission. If someone first arrives through your affiliate link and later buys an eligible product within the 60-day referral window, the purchase can still be attributed to you as long as the referral tracking remains intact.",
  },
  {
    question: "Can I earn commission on my own purchase?",
    answer: "No. Self-referrals are not eligible for commission.",
  },
  {
    question: "Do I have to link directly to checkout?",
    answer: "No. You can send people to the homepage, an article, a product page, or a bundle page. Affiliate tracking is installed across the Developer Business Lab site.",
  },
];
---

<BaseLayout
  title="Affiliate Program | Developer Business Lab"
  description="Earn 30% recommending practical business systems for freelance developers through the Developer Business Lab affiliate program."
>
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="Developer Business Lab Affiliate Program"
    title="Earn 30% recommending the business side of freelance development."
    description="Your audience already knows how to build. These are the systems for pricing work, landing clients, and closing deals that they keep asking about. Send them our way and earn 30% on eligible sales for 60 days after they click."
    primaryCta={{ label: "Apply to Become an Affiliate", href: affiliateApplicationUrl }}
    secondaryCta={{ label: "See the Products", href: "#products" }}
    supportingItems={["30% commission", "60-day referral window", "Bundles included"]}
  >
    <div slot="visual" class="publisher-panel p-7 sm:p-9">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-primary-accent">What 30% looks like</p>
      <div class="mt-7 space-y-6">
        <div class="border-t border-border pt-5">
          <p class="text-sm text-muted-foreground">Freelance Developer Launch Kit</p>
          <p class="mt-2 text-2xl font-semibold">
            {launchCommerce?.priceFormatted ?? "$129.00"} sale → {launchCommission ?? "$38.70"} commission
          </p>
        </div>
        <div class="border-t border-border pt-5">
          <p class="text-sm text-muted-foreground">Freelance Developer Business System</p>
          <p class="mt-2 text-2xl font-semibold">
            {completeMerch?.bundlePriceFormatted ?? "$549.00"} sale → {completeCommission ?? "$164.70"} commission
          </p>
        </div>
      </div>
    </div>
  </PageHero>

  <section id="products" class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-4xl">
        <p class="editorial-kicker">What you can promote</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">A system for every problem your audience brings up.</h2>
      </div>

      <article class="mt-10 border border-primary/40 bg-card/40 p-7 sm:p-9">
        <div class="grid gap-7 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-12">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary-accent">Complete starting point</p>
            <h3 class="mt-3 text-3xl font-semibold tracking-tight">Freelance Developer Launch Kit</h3>
            <p class="mt-4 max-w-3xl text-lg leading-8 text-muted-foreground">For developers who need the whole freelance business working together: what to sell, what to charge, how to find clients, how to sell, and how to run the work without rebuilding the business every month.</p>
          </div>
          <div class="lg:text-right">
            <p class="text-lg font-semibold">{launchCommerce?.priceFormatted ?? "$129.00"}</p>
            <p class="mt-1 text-sm text-muted-foreground">Your 30%: {launchCommission ?? "$38.70"}</p>
            <p class="mt-4"><a href="/products/freelance-developer-launch-kit/" class="font-semibold text-primary-accent underline-offset-4 hover:underline">See the Launch Kit →</a></p>
          </div>
        </div>
      </article>

      <div class="mt-8 grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
        {specialistProducts.map(([topic, product]) => (
          <div class="bg-background p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">{topic}</p>
            <p class="mt-3 text-lg font-semibold">{product}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 border-l-2 border-primary-accent pl-5">
        <p class="text-lg leading-8 text-muted-foreground">
          <strong class="text-foreground">Bundles are included too, and they carry the biggest payouts.</strong>
          {completeMerch?.bundlePriceFormatted && completeCommission
            ? ` The complete Freelance Developer Business System is currently ${completeMerch.bundlePriceFormatted}, which means ${completeCommission} at a 30% commission.`
            : " The complete business bundle carries the largest current payout."}
          {" "}<a href="/bundles/" class="font-semibold text-primary-accent underline-offset-4 hover:underline">See all bundles →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-3xl">
        <p class="editorial-kicker">Who it fits</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">A focused audience beats a big one.</h2>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">If the people who follow you are freelancers or independent developers trying to turn their skills into steady income, you're a fit. A small, focused following can outperform a large general coding account.</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {partnerTypes.map((partner) => (
          <div class="surface-editorial p-6"><p class="font-medium">{partner}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section id="program" class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="editorial-kicker">How it works</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">You share the link. Lemon Squeezy handles the rest.</h2>
        <div class="mt-8 space-y-7">
          {[
            ["01", "Apply", "Tell us about your audience and where you'll share Developer Business Lab."],
            ["02", "Get approved", "We review every application manually before the program is activated for you."],
            ["03", "Share your links", "Link to a product page, an article, a bundle, or the homepage. Eligible purchases attributed through your referral link count."],
            ["04", "Get paid", "Earn 30% on eligible purchases attributed within 60 days. Lemon Squeezy tracks the referrals and handles affiliate payouts."],
          ].map(([number, title, description]) => (
            <div class="grid grid-cols-[3rem_1fr] gap-4 border-t border-border pt-5">
              <p class="font-mono text-xs text-primary-accent">{number}</p>
              <div><h3 class="text-xl font-semibold">{title}</h3><p class="mt-2 leading-7 text-muted-foreground">{description}</p></div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <p class="editorial-kicker">Affiliate kit</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">Everything you need to start promoting.</h2>
        <div class="mt-8 grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          {promotionAssets.map((item) => (
            <div class="bg-background p-6"><p class="font-medium">{item}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="editorial-kicker">Ground rules</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-tight">Keep it honest.</h2>
      <ul class="mt-8 space-y-4 text-lg leading-8 text-muted-foreground">
        <li>Disclose that you may earn a commission.</li>
        <li>Share your real opinion. We won't provide fake testimonials or scripts claiming you've used something you haven't.</li>
        <li>Don't promise results that Developer Business Lab doesn't promise.</li>
        <li>No spam, fake reviews, deceptive redirects, or misleading promotions.</li>
        <li>Don't bid on our brand name or pose as the official Developer Business Lab site.</li>
      </ul>
      <p class="mt-8 text-sm text-muted-foreground">Participation is subject to Lemon Squeezy's affiliate terms and the Developer Business Lab program standards.</p>
    </div>
  </section>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="editorial-kicker">Affiliate FAQ</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-tight">The practical details.</h2>
      <div class="mt-10 divide-y divide-border border-y border-border">
        {faqs.map((faq) => (
          <details class="group py-6">
            <summary class="cursor-pointer list-none text-lg font-semibold text-foreground focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline">
              <span class="flex items-center justify-between gap-6">
                <span>{faq.question}</span>
                <span aria-hidden="true" class="text-primary-accent transition-transform group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-4 max-w-4xl leading-7 text-muted-foreground">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="apply" class="relative overflow-hidden border-t border-border bg-card/35 px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="relative mx-auto max-w-4xl text-center">
      <p class="editorial-kicker">Become a partner</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">Know developers who can build but struggle to sell?</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">Recommend the systems that close that gap, and earn 30% when they buy.</p>
      <div class="mt-8">
        <Button as="a" href={affiliateApplicationUrl} size="lg">Apply to Become an Affiliate</Button>
      </div>
      <p class="mx-auto mt-5 max-w-xl text-sm leading-6 text-muted-foreground">Applications are handled through Lemon Squeezy and reviewed manually before approval.</p>
    </div>
  </section>
</BaseLayout>
