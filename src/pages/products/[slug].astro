---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCTA from "@/components/products/ProductCTA.astro";
import ProductCover from "@/components/products/ProductCover.astro";
import FAQList from "@/components/ui/FAQList.astro";
import { reportProductCatalogCoverage, resolveProductCommerce } from "@/lib/lemon-squeezy";

export async function getStaticPaths() {
  const products = await getCollection("products");
  reportProductCatalogCoverage(products.map((product) => product.data));
  return products.map((product) => ({ params: { slug: product.data.slug }, props: { product } }));
}

const { product } = Astro.props;
const d = product.data;
const commerce = resolveProductCommerce(d);
const effectiveStatus = commerce.effectiveStatus;
const canonical = Astro.site ? new URL(`/products/${d.slug}/`, Astro.site).toString() : undefined;
const breadcrumbs = canonical ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Products", item: new URL("/products/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: d.title, item: canonical },
  ],
} : undefined;

const hook = d.hook ?? d.problem;
const reframe = d.reframe ?? d.situation;
const delivery = d.delivery ?? {
  length: d.contents.length > 0 ? `${d.contents.length} focused implementation topics` : d.format,
  worksheets: "Final working assets will be listed when the product is released.",
  time: effectiveStatus === "available" ? "Use it on the next real business decision." : "Final implementation guidance will be published at release.",
};
const splitParagraphs = (text: string) => text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean).length > 1
  ? text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean)
  : [text];
const reframeParagraphs = splitParagraphs(reframe);
const proofParagraphs = d.proof ? splitParagraphs(d.proof.body) : [];
const finalHeading = effectiveStatus === "available" ? `Put ${d.title} to work` : `Follow ${d.title}`;
---

<BaseLayout title={d.seo.title} description={d.seo.description} noindex={effectiveStatus === "planned"} enableCheckoutOverlay={commerce.purchasable}>
  {breadcrumbs && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />}

  <section class="relative overflow-hidden border-b border-border px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_20%,rgba(212,138,23,.09),transparent_32rem)]"></div>
    <div class="relative mx-auto max-w-7xl">
      <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground"><a href="/products/" class="hover:text-foreground">Products</a><span aria-hidden="true"> / </span><span>{d.title}</span></nav>
      <div class="mt-10 grid gap-14 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:gap-20">
        <div>
          <p class="editorial-kicker">{d.family}</p>
          <p class="mt-5 text-sm font-semibold text-primary-accent">{d.title}</p>
          <h1 class="mt-3 max-w-3xl text-5xl font-semibold tracking-[-0.04em] sm:text-6xl">{hook}</h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">{d.shortDescription}</p>
          <div class="mt-7 border-l border-primary/70 pl-5"><p class="text-sm font-semibold uppercase tracking-[.12em] text-muted-foreground">Best for</p><p class="mt-2 leading-7">{d.audience}</p></div>
          <div class="mt-8"><ProductCTA product={product} location="hero" /></div>
          <p class="mt-4 text-sm text-muted-foreground">{d.format}{commerce.purchasable ? ` · ${commerce.priceFormatted}${d.free ? "" : " one-time"}` : ` · ${effectiveStatus === "coming-soon" ? "Coming soon" : "Planned"}`}</p>
        </div>
        <div class="gold-glow"><ProductCover product={product} /></div>
      </div>
    </div>
  </section>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-20">
      <div><p class="editorial-kicker">The problem</p><h2 class="mt-4 text-3xl font-semibold">Why this keeps costing you.</h2></div>
      <div class="space-y-5 text-lg leading-8 text-muted-foreground">{reframeParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="editorial-kicker">Inside the system</p>
      <div class="mt-4 grid gap-8 lg:grid-cols-[1fr_.55fr] lg:gap-16">
        <div>
          <h2 class="text-4xl font-semibold tracking-tight">What you will work through.</h2>
          <ol class="mt-8 border-t border-border">
            {d.contents.map((item, index) => <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-border py-5"><span class="font-mono text-xs text-primary-accent">{String(index + 1).padStart(2, "0")}</span><span>{item}</span></li>)}
          </ol>
        </div>
        <aside class="surface-editorial self-start p-7">
          <p class="editorial-kicker">What you receive</p>
          <dl class="mt-6 space-y-6">
            <div><dt class="font-semibold">Guide depth</dt><dd class="mt-2 text-sm leading-6 text-muted-foreground">{delivery.length}</dd></div>
            <div><dt class="font-semibold">Working tools</dt><dd class="mt-2 text-sm leading-6 text-muted-foreground">{delivery.worksheets}</dd></div>
            <div><dt class="font-semibold">How to use it</dt><dd class="mt-2 text-sm leading-6 text-muted-foreground">{delivery.time}</dd></div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="editorial-kicker">This is for you if</p>
        <ul class="mt-6 border-t border-border">{d.whoItsFor.map((item) => <li class="border-b border-border py-4 text-muted-foreground"><span class="mr-3 text-primary-accent">→</span>{item}</li>)}</ul>
      </div>
      <div>
        <p class="editorial-kicker">Skip it if</p>
        <ul class="mt-6 border-t border-border">{d.whoItsNotFor.map((item) => <li class="border-b border-border py-4 text-muted-foreground"><span class="mr-3">×</span>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  {d.proof && (
    <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <p class="editorial-kicker">See what changes</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">{d.proof.title}</h2>
        <div class="mt-6 space-y-5 text-lg leading-8 text-muted-foreground">{proofParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
        {(d.proof.before || d.proof.after) && <div class="mt-9 grid gap-px overflow-hidden border border-border bg-border md:grid-cols-2">{d.proof.before && <div class="bg-background p-7"><p class="editorial-kicker text-muted-foreground">Before</p><p class="mt-3 text-lg">{d.proof.before}</p></div>}{d.proof.after && <div class="bg-background p-7"><p class="editorial-kicker">After</p><p class="mt-3 text-lg">{d.proof.after}</p></div>}</div>}
      </div>
    </section>
  )}

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-4xl">
      {d.faqs.length > 0 && <><p class="editorial-kicker">Before you buy</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Questions worth answering first.</h2><div class="mt-8"><FAQList faqs={d.faqs.map((faq, index) => ({ data: { ...faq, order: index } }))} /></div></>}
      <div class={d.faqs.length > 0 ? "mt-14 border-t border-border pt-12" : ""}>
        <p class="editorial-kicker">Next step</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">{finalHeading}</h2>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">{effectiveStatus === "available" ? d.coreOutcome : `If ${d.title} is the problem you are trying to solve, join the release list. You will get the final contents and release notice when it is ready.`}</p>
        <div class="mt-8"><ProductCTA product={product} location="final" /></div>
      </div>
    </div>
  </section>
</BaseLayout>
