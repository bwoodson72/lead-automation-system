---
import { Image } from "astro:assets";
import logo from "@/assets/brand/developer-business-lab-logo.png";
const { compact = false } = Astro.props;
---
<a
  href="/"
  aria-label="Developer Business Lab home"
  class="group inline-flex min-w-0 items-center focus-visible:rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline"
>
  <Image
    src={logo}
    alt="Developer Business Lab"
    widths={[240, 320, 400, 520]}
    sizes={compact ? "140px" : "(max-width: 640px) 210px, 250px"}
    loading="eager"
    decoding="async"
    class:list={[
      "h-auto w-auto object-contain object-left transition-opacity group-hover:opacity-90",
      compact ? "max-h-9 max-w-[140px]" : "max-h-12 max-w-[210px] sm:max-w-[250px]",
    ]}
  />
</a>
