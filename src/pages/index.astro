---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/starwind/card";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import ProductGrid from "@/components/products/ProductGrid.astro";
import Pipeline from "@/components/marketing/Pipeline.astro";
import CTASection from "@/components/marketing/CTASection.astro";
import FAQList from "@/components/ui/FAQList.astro";

const products = (await getCollection("products")).sort((a, b) => a.data.order - b.data.order);
const featuredFaqs = (await getCollection("faqs", ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
const benefits = [
  ["Get prospecting time back", "Stop spending as much of your day opening businesses one by one, researching them, hunting for contacts, and writing every message from scratch."],
  ["Keep prospecting moving when client work gets busy", "Turn prospecting into a defined process you can run consistently—and progressively automate—so it does not depend entirely on remembering to restart it when your pipeline gets thin."],
  ["Spend your effort on better prospects", "Qualify businesses before outreach so weak opportunities can be rejected instead of consuming the same attention as strong ones."],
  ["Give prospects a reason to pay attention", "Build outreach around a current, verified business problem instead of another generic “I build websites” pitch."],
];
const cycle = ["Need work", "Prospect manually", "Win project", "Client work takes over", "Prospecting stops", "Project ends", "Pipeline is thin or empty", "Start over"];
const withoutSystem = ["Search manually whenever you need work", "Open businesses one at a time", "Decide from scratch whether each lead is worth pursuing", "Hunt for a contact", "Think of something personalized to say", "Write each message", "Keep follow-ups in your head or scattered notes", "Stop when other work gets busy"];
const withSystem = ["Define the clients and opportunities you want", "Use a repeatable discovery process", "Reject weak prospects before outreach", "Preserve the evidence that made a lead worth contacting", "Turn evidence into a relevant outreach angle", "Track contact and follow-up state", "Automate more repetitive work when ready"];
const repetitiveTasks = ["Deciding where to search every time", "Opening businesses one by one", "Judging every company from scratch", "Hunting for contact information", "Inventing something personalized to say", "Writing and tracking every message manually", "Remembering every follow-up"];
const attentionWork = ["Qualified opportunities", "Approved evidence", "Prepared outreach", "Due follow-ups", "Replies", "Sales conversations", "Exceptions that actually require judgment"];
const tierFreedom = [
  ["Tier 1", "Stop prospecting randomly.", "Work from a defined research, qualification, outreach, and follow-up process."],
  ["Tier 2", "Stop initiating every prospecting session yourself.", "Let recurring ChatGPT workflows keep research, review, and reporting moving."],
  ["Tier 3", "Stop processing every lead yourself.", "Let connected workflows handle repetitive lead processing after proper testing."],
  ["Tier 4", "Own the engine and control how it operates.", "Move the process into durable, extensible software when workflow automation is no longer enough."],
];
const example = [["Raw lead", "Summit Ridge Roofing"], ["Verified finding", "A primary estimate link on a current service page leads to a dead end."], ["Business consequence", "A customer attempting to request an estimate can fail to reach the conversion path."], ["Outreach angle", "Contact the business about the broken estimate path rather than sending a vague redesign pitch."]];
const ownershipBenefits = [
  ["Control what qualifies", "Define what makes a business worth contacting and let weak opportunities end in rejection instead of forcing every database match into outreach."],
  ["Make it specific to web development", "Qualify around current website evidence and business consequences—not only industry, title, headcount, or contact availability."],
  ["Choose the tools for each job", "Use commercial providers as replaceable parts of the process rather than making one vendor your entire strategy."],
  ["Keep the reasoning with the lead", "Preserve why a prospect qualified, what evidence was used, what was said, and what should happen next."],
  ["Control the economics", "Run inexpensive filtering first and reserve enrichment and processing for leads that survive qualification."],
  ["Know what to fix", "Inspect discovery, qualification, enrichment, outreach, and follow-up separately when the pipeline underperforms."],
];
const guardrails = [["Evidence first", "Reject a lead instead of inventing a reason to contact it."], ["Stop conditions", "Treat replies, opt-outs, and hard bounces as durable campaign state."], ["Controlled volume", "Protect sender reputation instead of maximizing raw sends."], ["Durable records", "Prevent duplicate and inappropriate outreach."], ["Progressive automation", "Automate only after the process is understood and tested."]];
---
<BaseLayout title="Prospect Foundry | Client Acquisition for Web Developers" description="Build a repeatable web-development prospecting system, spend less time on repetitive lead work, and automate more when you are ready.">
  <section class="border-b border-border px-4 py-20 sm:px-6 sm:py-28 lg:px-8"><div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-2 lg:items-center">
    <div><p class="font-mono text-xs font-semibold uppercase tracking-widest text-primary-accent">Client acquisition systems for freelance web developers</p><h1 class="mt-5 text-5xl font-semibold tracking-tight sm:text-6xl lg:text-7xl">Spend Less Time Looking for Web-Development Clients.</h1><p class="mt-7 text-lg leading-8 text-muted-foreground sm:text-xl">Build a repeatable prospecting system that helps you find better opportunities, identify a real reason to contact them, keep up with follow-ups, and automate the repetitive work that eats into your day.</p><div class="mt-9 flex flex-wrap gap-3"><Button as="a" href="/compare/" size="lg">Compare the Guides</Button><Button as="a" href="/how-it-works/" variant="outline" size="lg">See How It Works</Button></div><p class="mt-6 text-sm text-muted-foreground">Start with an AI-assisted workflow and automate as much of the process as your business actually needs.</p></div>
    <div class="grid gap-5 sm:grid-cols-2"><div class="rounded-2xl border border-border bg-card p-6"><p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Manual prospecting</p><ul class="mt-5 space-y-3 text-sm text-muted-foreground"><li>Search businesses</li><li>Open sites one by one</li><li>Hunt for contacts</li><li>Write every message</li><li>Remember follow-ups</li><li>Start over</li></ul></div><div class="rounded-2xl border border-primary/30 bg-primary/10 p-6"><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Systematic prospecting</p><ul class="mt-5 space-y-3 text-sm"><li>Find candidates consistently</li><li>Filter weak prospects</li><li>Preserve real evidence</li><li>Create relevant outreach</li><li>Track the pipeline</li><li>Automate more over time</li></ul></div></div>
  </div></section>

  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><SectionHeader eyebrow="What changes for you" title="Prospecting Becomes a System Instead of Another Job on Your List." /><div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">{benefits.map(([title, text]) => <Card><CardHeader><CardTitle>{title}</CardTitle></CardHeader><CardContent><p class="leading-7 text-muted-foreground">{text}</p></CardContent></Card>)}</div></div></section>

  <section class="border-y border-border bg-card/30 px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2"><SectionHeader title="The Problem Isn't Just Finding Leads. It's Having to Start Over Every Time." description="Freelance prospecting often disappears as soon as paid work arrives. You get busy, outreach stops, the project ends, and suddenly you need another client with nothing moving in the pipeline." /><div><ol class="grid gap-2 sm:grid-cols-2">{cycle.map((step, index) => <li class="flex items-center gap-4 rounded-lg border border-border bg-card px-4 py-3"><span class="font-mono text-xs text-primary-accent">{String(index + 1).padStart(2, "0")}</span><span>{step}</span></li>)}</ol><p class="mt-6 leading-7 text-muted-foreground">Prospect Foundry teaches you to replace that stop-start behavior with a process that can become more consistent as you automate it.</p></div></div></section>

  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><SectionHeader title="Replace a Pile of Prospecting Tasks With One Defined Process." /><div class="mt-10 grid gap-5 lg:grid-cols-2"><div class="rounded-2xl border border-border bg-card p-7"><h3 class="text-xl font-semibold">Without a system</h3><ul class="mt-5 space-y-3">{withoutSystem.map((item) => <li class="flex gap-3 text-muted-foreground"><span aria-hidden="true" class="text-error">×</span><span>{item}</span></li>)}</ul></div><div class="rounded-2xl border border-primary/30 bg-primary/10 p-7"><h3 class="text-xl font-semibold">With the system</h3><ul class="mt-5 space-y-3">{withSystem.map((item) => <li class="flex gap-3"><span aria-hidden="true" class="text-success">✓</span><span>{item}</span></li>)}</ul></div></div><p class="mt-7 max-w-3xl leading-7 text-muted-foreground">The goal is not to send more email for the sake of sending more email. It is to make finding the next good conversation less manual and less random.</p></div></section>

  <section class="border-y border-border bg-card/30 px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><SectionHeader eyebrow="How it works" title="One Prospecting Process. Four Levels of Automation." description="Every guide uses the same underlying decision process. The difference is how much you perform yourself and how much you hand to ChatGPT, workflows, APIs, or application infrastructure." /><div class="mt-12"><Pipeline steps={["Discover", "Verify", "Inspect", "Qualify or reject", "Find / verify contact", "Create outreach", "Follow up", "Stop / record", "Report"]} /></div></div></section>

  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><SectionHeader eyebrow="What changes after implementation" title="Prospecting Stops Being Something You Have to Rebuild Every Time." description="Once the system is in place, you are no longer starting from a blank screen every time you need more work. You have a defined market, qualification rules, a process for finding businesses, a record of what has happened, and a method for deciding which opportunities deserve your attention." /><p class="mt-6 max-w-3xl leading-7 text-muted-foreground">As you move through the automation levels, more repetitive work can happen without requiring another manual prospecting session.</p><div class="mt-10 grid gap-5 lg:grid-cols-2"><Card><CardHeader><p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">Less of your attention goes here</p><CardTitle>Performing every prospecting task</CardTitle></CardHeader><CardContent><ul class="space-y-3">{repetitiveTasks.map((item) => <li class="flex gap-3 text-muted-foreground"><span aria-hidden="true" class="text-error">×</span><span>{item}</span></li>)}</ul></CardContent></Card><Card class="border-primary/30 bg-primary/10"><CardHeader><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">More of your attention goes here</p><CardTitle>Managing work that deserves judgment</CardTitle></CardHeader><CardContent><ul class="space-y-3">{attentionWork.map((item) => <li class="flex gap-3"><span aria-hidden="true" class="text-success">✓</span><span>{item}</span></li>)}</ul></CardContent></Card></div><p class="mt-8 rounded-xl border border-primary/30 bg-primary/10 p-6 text-xl font-semibold">Your role shifts from performing every prospecting task yourself to managing the opportunities and conversations that deserve your attention.</p></div></section>

  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><SectionHeader eyebrow="Waste fewer outreach attempts" title="Don't Contact a Business Just Because You Found Its Email Address." description="A contact record is not the same thing as a good prospect. The system researches the business first and asks whether there is a current, meaningful web-development opportunity worth discussing. If there is no defensible reason to make contact, the correct result can be rejection." /><div class="mt-12"><Pipeline steps={["Business found", "Current site verified", "Evidence collected", "Meaningful consequence?", "Reject or qualify", "Outreach angle"]} /></div><p class="mt-7 rounded-xl border border-primary/30 bg-primary/10 p-5 font-semibold">Better qualification means your limited outreach effort goes toward businesses with an actual reason to hear from a web developer.</p></div></section>

  <section class="border-y border-border bg-card/30 px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><SectionHeader title="Give the Prospect Something Specific to Respond To." description="The value is not “AI personalization.” The value is having a legitimate reason for the message in the first place." /><div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">{example.map(([title, text]) => <Card><CardHeader><CardTitle>{title}</CardTitle></CardHeader><CardContent><p class="leading-7 text-muted-foreground">{text}</p></CardContent></Card>)}</div></div></section>

  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><SectionHeader eyebrow="Progressive automation" title="Four Levels of Control Over the Same Prospecting Process." description="Each level removes a different amount of repetitive work. The right choice is the one that matches what you are ready to hand off—not the one with the most technology." /><div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">{tierFreedom.map(([tier, title, text]) => <Card><CardHeader><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">{tier}</p><CardTitle>{title}</CardTitle></CardHeader><CardContent><p class="text-sm leading-6 text-muted-foreground">{text}</p></CardContent></Card>)}</div></div></section>

  <section class="border-y border-border bg-card/30 px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><SectionHeader eyebrow="Build vs. buy" title="Why Build a Prospecting System When You Can Just Buy Software?" description="Sometimes buying software is the right answer. If all you need is company data, contact information, enrichment, and a basic email sequence, an off-the-shelf platform may get you there faster. Prospect Foundry is for the point where you want control over the web-development-specific process around those tools." /><p class="mt-8 rounded-xl border border-primary/30 bg-primary/10 p-6 text-xl font-semibold">Buying software gives you a tool. Building the system gives you control over the process.</p><div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{ownershipBenefits.map(([title, text]) => <Card><CardHeader><CardTitle>{title}</CardTitle></CardHeader><CardContent><p class="text-sm leading-6 text-muted-foreground">{text}</p></CardContent></Card>)}</div><p class="mt-7 max-w-4xl leading-7 text-muted-foreground">You are not building everything from scratch for the sake of building it. You are building the part that should belong to your business: the rules, evidence, state, and workflow that determine who is worth your time. Greater control also brings setup and maintenance work.</p><div class="mt-8 flex flex-wrap gap-3"><Button as="a" href="/how-it-works/">See How the System Works</Button><Button as="a" href="/compare/" variant="outline">Compare the Guides</Button></div></div></section>

  <section class="px-4 py-16 sm:px-6 lg:px-8"><div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-2 lg:items-center"><SectionHeader title="Where Does Apollo Fit?" description="Apollo can still be part of the system. It is strong at jobs such as company and contact data, enrichment, sequencing, and sales workflows. The guides treat those capabilities as components inside a broader web-development-specific acquisition process." /><div class="rounded-xl border border-border bg-card p-7"><p class="leading-7 text-muted-foreground">The system defines what happens around those tools: which businesses deserve research, what current website evidence qualifies them, what outreach may claim, how campaign state is tracked, and when contact should stop.</p><p class="mt-5 font-semibold text-foreground">Apollo can help you find someone to contact. Your system decides whether the opportunity is worth pursuing and why.</p></div></div></section>

  <section class="border-y border-border bg-card/30 px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><SectionHeader eyebrow="Choose your starting point" title="Choose How Much of the Prospecting Work You Want to Keep Doing Yourself." description="You do not need to build the most advanced version first. Start by removing the part of prospecting that consumes the most of your time today." /><div class="mt-12"><ProductGrid products={products} /></div><p class="mt-8"><a href="/compare/" class="font-semibold text-primary-accent hover:text-foreground">Compare all four guides →</a></p></div></section>

  <section class="border-y border-border bg-card/30 px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><SectionHeader title="Automation Is Only Useful if You Can Trust What It Does." description="Guardrails help you protect evidence quality, sender reputation, and campaign state as more work moves into the system." /><div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-5">{guardrails.map(([title, text]) => <div class="rounded-xl border border-border bg-card p-5"><h3 class="font-semibold">{title}</h3><p class="mt-3 text-sm leading-6 text-muted-foreground">{text}</p></div>)}</div></div></section>

  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-4xl"><SectionHeader title="Questions Before You Choose?" description="The guides are PDF implementation manuals—not software access, a lead service, or a guaranteed-results program." /><div class="mt-10"><FAQList faqs={featuredFaqs} /></div><p class="mt-6"><a href="/faq/" class="font-semibold text-primary-accent hover:text-foreground">View all FAQs →</a></p></div></section>
  <CTASection title="Spend Less Time Rebuilding Your Pipeline From Scratch." description="Choose the guide that matches how you prospect today, then start removing the repetitive work that keeps pulling your attention away from client work and sales conversations." secondaryLabel="View All Products" secondaryHref="/products/" />
</BaseLayout>
