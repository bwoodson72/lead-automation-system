---
import BaseLayout from "./BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";

const { title, description, eyebrow, noindex = false } = Astro.props;
---

<BaseLayout title={`${title} | Prospect Foundry`} description={description} noindex={noindex}>
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow={eyebrow}
    title={title}
    description={description}
  />
  <article class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="space-y-8 text-base leading-8 text-muted-foreground [&_a]:text-primary-accent [&_h2]:pt-4 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-foreground [&_li]:ml-5 [&_li]:list-disc [&_strong]:text-foreground">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
