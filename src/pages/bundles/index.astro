---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import TextLink from "@/components/ui/TextLink.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { getBundleMerchandising } from "@/lib/bundle-merchandising";
import { isPublicBundle, isPublicProduct } from "@/lib/storefront-visibility";

const bundles = (await getCollection("bundles")).filter(isPublicBundle);
const products = (await getCollection("products")).filter(isPublicProduct);
const bundleBySlug = (slug: string) => bundles.find((entry) => entry.data.slug === slug);
const money = (value?: number) => value === undefined ? undefined : new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value);

const cards = [
  {
    slug: "freelancer-starter-bundle",
    fit: "For when you're not sure what you sell, what to charge, or why clients should care.",
    body: "A clear offer, prices based on real numbers, and marketing that shows buyers why you're worth it. Each one makes the others work.",
    includes: "Productize Your Dev Skills, Web Developer Pricing System, Marketing for Builders",
    cta: "See the Starter Bundle →",
  },
  {
    slug: "client-acquisition-bundle",
    fit: "For when your skills aren't the problem, but getting enough good clients is.",
    body: "Several reliable routes to new clients, all feeding one pipeline you can see and manage, so no single source controls your income.",
    includes: "Marketing for Builders, Client Acquisition Without Upwork, Social Media Client Acquisition System, Agency Partnership Playbook",
    cta: "See the Client Acquisition Bundle →",
  },
  {
    slug: "freelancer-sales-system",
    fit: "For when opportunities come in, but too many slip away or lose money.",
    body: "Carry a good opportunity from first sales call to signed, paid project, and keep the best clients paying after launch.",
    includes: "Developer Sales Playbook, Developer Proposal & Closing Kit, Freelancer Retainer System",
    cta: "See the Freelancer Sales System →",
  },
  {
    slug: "freelance-developer-business-system",
    fit: "For when you've decided you're doing this for real.",
    body: "The Launch Kit to build the whole business, plus all nine deeper systems ready for whatever needs work next.",
    includes: "Freelance Developer Launch Kit and all nine specialist systems",
    cta: "See the Complete System →",
  },
];
---

<BaseLayout title="Bundles | Developer Business Lab" description="Compare Developer Business Lab bundles for connected problems across your freelance foundation, client acquisition, sales, and complete business system.">
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="Bundles"
    title="When the problems are connected, fix them together."
    description="Business problems rarely show up alone. A vague offer makes pricing harder. Weak pricing makes marketing harder. An empty pipeline makes every sales call feel like one you can't lose. Each bundle groups the systems that solve a connected set of problems, for less than buying them separately."
  >
    <div slot="actions"><a class="font-semibold text-primary-accent underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline" href="/start/">Not sure which one fits? Start Here →</a></div>
  </PageHero>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="space-y-8">
        {cards.map((card) => {
          const bundle = bundleBySlug(card.slug);
          if (!bundle) return null;
          const merch = getBundleMerchandising(bundle, products);
          const savings = money(merch.savings);
          return (
            <article class="border border-border bg-background p-7 lg:p-9">
              <div class="grid gap-8 lg:grid-cols-[.9fr_1.1fr] lg:gap-16">
                <div>
                  <h2 class="text-3xl font-semibold tracking-tight">{bundle.data.title}</h2>
                  <p class="mt-4 text-lg italic leading-8 text-muted-foreground">{card.fit}</p>
                  <p class="mt-5 text-lg leading-8 text-muted-foreground">{card.body}</p>
                </div>
                <div class="border-t border-border pt-7 lg:border-l lg:border-t-0 lg:pl-9 lg:pt-0">
                  <p class="leading-7 text-muted-foreground"><strong class="text-foreground">Includes:</strong> {card.includes}</p>
                  <p class="mt-6 text-lg font-semibold">{merch.bundlePriceFormatted ?? "One-time purchase"}{savings ? ` · Save ${savings}` : ""}</p>
                  <p class="mt-5"><TextLink href={`/bundles/${card.slug}/`}>{card.cta}</TextLink></p>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-4xl font-semibold tracking-tight">How to choose</h2>
      <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border md:grid-cols-2">
        <article class="bg-background p-7"><h3 class="text-xl font-semibold">One problem is clearly the problem?</h3><p class="mt-4 leading-7 text-muted-foreground">You may not need a bundle. <a class="font-semibold text-primary-accent hover:underline" href="/products/">Browse individual systems →</a></p></article>
        <article class="bg-background p-7"><h3 class="text-xl font-semibold">Your offer, pricing, or marketing are the weak spot?</h3><p class="mt-4 leading-7 text-muted-foreground">Freelancer Starter Bundle.</p></article>
        <article class="bg-background p-7"><h3 class="text-xl font-semibold">You don't have enough good clients?</h3><p class="mt-4 leading-7 text-muted-foreground">Client Acquisition Bundle.</p></article>
        <article class="bg-background p-7"><h3 class="text-xl font-semibold">You have opportunities, but deals slip away or lose money?</h3><p class="mt-4 leading-7 text-muted-foreground">Freelancer Sales System.</p></article>
        <article class="bg-background p-7 md:col-span-2"><h3 class="text-xl font-semibold">Several parts of the business need work?</h3><p class="mt-4 leading-7 text-muted-foreground">Start with the <a class="font-semibold text-primary-accent hover:underline" href="/products/freelance-developer-launch-kit/">Freelance Developer Launch Kit</a>, or get the <a class="font-semibold text-primary-accent hover:underline" href="/bundles/freelance-developer-business-system/">Freelance Developer Business System</a> if you want the deeper systems ready too.</p></article>
      </div>
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl text-sm text-muted-foreground">Every purchase is covered by Developer Business Lab's 14-Day Satisfaction Guarantee. <a class="font-semibold text-primary-accent hover:underline" href="/refund-policy/">Read the full refund policy</a></div>
  </section>
</BaseLayout>
