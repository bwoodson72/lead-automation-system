---
import { siteConfig } from "@/config";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
const groups = [
  { title: "Find a system", links: [["Start Here","/start/"],["All Products","/products/"],["AI Prospecting","/products/ai-prospecting-system/"],["Bundles","/bundles/"]] },
  { title: "Learn", links: [["Free Quickstart","/free/"],["Articles","/articles/"],["FAQ","/faq/"]] },
  { title: "Company", links: [["About","/about/"], ...(siteConfig.supportEmail ? [[siteConfig.supportEmail,`mailto:${siteConfig.supportEmail}`]] : [])] },
  { title: "Legal", links: [["Privacy","/privacy/"],["Terms","/terms/"],["Refund Policy","/refund-policy/"]] },
];
---
<footer class="border-t border-border bg-card/40"><div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8"><Logo /><p class="mt-5 max-w-xl text-sm leading-6 text-muted-foreground">Build the business system around your technical skills.</p><div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">{groups.map((group) => <div><h2 class="text-sm font-semibold">{group.title}</h2><ul class="mt-4 space-y-3">{group.links.map(([label,href]) => <li><a href={href} class="text-sm text-muted-foreground hover:text-foreground">{label}</a></li>)}</ul></div>)}</div><p class="mt-12 border-t border-border pt-6 text-sm text-muted-foreground">© {year} Developer Business Lab. All rights reserved.</p></div></footer>
