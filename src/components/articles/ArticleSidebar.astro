---
type TopicLink = {
  slug: string;
  label: string;
  count?: number;
};

type TocItem = {
  slug: string;
  text: string;
};

interface Props {
  topics?: TopicLink[];
  activeTopic?: string;
  tocItems?: TocItem[];
  showQuickstart?: boolean;
}

const {
  topics = [],
  activeTopic,
  tocItems = [],
  showQuickstart = false,
} = Astro.props;
---

<aside class="space-y-6 lg:sticky lg:top-32">
  {topics.length > 0 && (
    <section class="rounded-xl border border-border bg-card p-6" aria-labelledby="article-topics-heading">
      <h2 id="article-topics-heading" class="text-lg font-semibold text-foreground">Browse by topic</h2>
      <nav aria-label="Article topics" class="mt-4">
        <ul class="space-y-1">
          {topics.map((topic) => (
            <li>
              <a
                href={`/articles/topics/${topic.slug}/`}
                aria-current={activeTopic === topic.slug ? "page" : undefined}
                class:list={[
                  "flex items-center justify-between gap-3 rounded-md px-3 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline",
                  activeTopic === topic.slug
                    ? "bg-primary/10 text-primary-accent"
                    : "text-muted-foreground hover:bg-secondary hover:text-foreground",
                ]}
              >
                <span>{topic.label}</span>
                {typeof topic.count === "number" && <span class="text-xs text-muted-foreground">{topic.count}</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>
  )}

  {tocItems.length > 0 && (
    <nav aria-label="Table of contents" class="rounded-xl border border-border bg-card p-6">
      <h2 class="text-lg font-semibold text-foreground">On this page</h2>
      <ul class="mt-4 space-y-2">
        {tocItems.map((item) => (
          <li>
            <a
              href={`#${item.slug}`}
              class="block text-sm leading-6 text-muted-foreground transition-colors hover:text-primary-accent focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline"
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  {showQuickstart && (
    <section class="rounded-xl border border-primary/20 bg-primary/10 p-6" aria-labelledby="article-quickstart-heading">
      <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">New here?</p>
      <h2 id="article-quickstart-heading" class="mt-3 text-xl font-semibold text-foreground">Build your marketing foundation first.</h2>
      <p class="mt-3 text-sm leading-6 text-muted-foreground">The free Developer Marketing Quickstart helps you define the buyer, problem, offer, message, and next acquisition actions.</p>
      <a
        href="/free/"
        class="mt-5 inline-flex items-center font-medium text-primary-accent underline decoration-primary-accent/60 underline-offset-4 transition-colors hover:text-foreground hover:decoration-foreground/70 focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline"
      >
        Get the free Quickstart
      </a>
    </section>
  )}
</aside>
