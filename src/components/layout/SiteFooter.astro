---
import { siteConfig } from "@/config";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
const groups = [
  { title: "Products", links: [["AI Prospecting Starter", "/products/ai-prospecting-starter/"], ["ChatGPT Client Acquisition System", "/products/chatgpt-client-acquisition-system/"], ["Automated Lead Engine", "/products/automated-lead-engine/"], ["Production Lead Engine", "/products/production-lead-engine/"]] },
  { title: "Learn", links: [["How It Works", "/how-it-works/"], ["Compare", "/compare/"], ["Articles", "/articles/"], ["FAQ", "/faq/"]] },
  { title: "Company", links: [["About", "/about/"], ...(siteConfig.supportEmail ? [[siteConfig.supportEmail, `mailto:${siteConfig.supportEmail}`]] : [])] },
  { title: "Legal", links: [["Privacy", "/privacy/"], ["Terms", "/terms/"], ["Refund Policy", "/refund-policy/"]] },
];
---
<footer class="border-t border-border bg-card/40">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <Logo />
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {groups.map((group) => <div><h2 class="text-sm font-semibold text-foreground">{group.title}</h2><ul class="mt-4 space-y-3">{group.links.map(([label, href]) => <li><a href={href} class="text-sm text-muted-foreground hover:text-foreground">{label}</a></li>)}</ul></div>)}
    </div>
    <p class="mt-12 border-t border-border pt-6 text-sm text-muted-foreground">© {year} Lead Automation System. All rights reserved.</p>
  </div>
</footer>
