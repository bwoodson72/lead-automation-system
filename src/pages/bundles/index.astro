---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import BundleOfferCard from "@/components/products/BundleOfferCard.astro";
import { Button } from "@/components/starwind/button";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { getBundleMerchandising } from "@/lib/bundle-merchandising";
import { isPublicBundle, isPublicProduct } from "@/lib/storefront-visibility";

const bundles = (await getCollection("bundles")).filter(isPublicBundle).sort((a, b) => a.data.order - b.data.order);
const products = (await getCollection("products")).filter(isPublicProduct);
const merchandising = bundles.map((bundle) => ({ bundle, merch: getBundleMerchandising(bundle, products) }));
const hasCheckout = merchandising.some(({ merch }) => merch.purchasable);

const choiceCopy = {
  "freelancer-starter-bundle": {
    problem: "I can deliver the work, but what I sell, what I charge, and how I explain the value still change from prospect to prospect.",
    result: "Connect one clear offer to pricing you can defend and marketing that makes the value easier for the right buyer to understand.",
  },
  "client-acquisition-bundle": {
    problem: "I know acquisition is the problem, but my marketing, social activity, direct outreach, and agency relationships are being run as separate tactics.",
    result: "Give several buyer-access paths one qualification, pipeline, measurement, and diagnosis system while keeping each channel's role clear.",
  },
  "freelancer-sales-system": {
    problem: "I can get prospects into conversations, but opportunities become vague between discovery, proposal, closing, and what happens after delivery.",
    result: "Carry buyer understanding forward into a clear decision, controlled close, clean handoff, and legitimate recurring value where it actually exists.",
  },
  "freelance-developer-business-system": {
    problem: "I am building or rebuilding the whole freelance business and want the complete operating system plus deeper specialist treatment as different constraints appear.",
    result: "Use the Launch Kit as the integrated foundation, then go deeper on offer, pricing, marketing, acquisition, sales, proposals, partnerships, and recurring work without losing the overall structure.",
  },
} as const;
---

<BaseLayout
  title="Freelance Developer Bundles | Developer Business Lab"
  description="Choose a Developer Business Lab bundle when several connected freelance business problems need to work together across your foundation, acquisition, sales, or complete business system."
  enableCheckoutOverlay={hasCheckout}
>
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="Developer Business Lab bundles"
    title="A bundle makes sense when one business problem has spread across several connected decisions."
    description="Use one when you already know the broader part of the business that needs work and expect to use several specialist systems together. The savings are a benefit. They are not the reason to buy material you do not need."
    primaryCta={{ label: "Help Me Choose", href: "/start/" }}
    supportingItems={["Four current bundles", "Connected implementation paths", "Live prices and savings where available"]}
  />

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:gap-16 lg:items-start">
        <div>
          <p class="editorial-kicker">When a bundle is the right purchase</p>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight">Buy the connected work, not simply the larger pile of files.</h2>
        </div>
        <div class="space-y-5 text-lg leading-8 text-muted-foreground">
          <p>A bundle is useful when several decisions have to reinforce one another. A clearer offer changes what you can price. Pricing changes what the business has to communicate. Better acquisition creates opportunities that still need qualification and a sales process. A good project can create future demand only when the continuing client need is real.</p>
          <p>If only one of those decisions is weak, the focused guide is usually the better purchase. If you cannot yet tell which part of the business is causing the symptoms, the Launch Kit is the better starting point. The bundles are for the middle case: you know the broader problem and several connected systems inside it need deeper work.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-4xl">
        <p class="editorial-kicker">Choose by your situation</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">Which larger problem are you actually trying to solve?</h2>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">Start with the situation that sounds like your business now. The bundle name matters less than the set of decisions you need to make work together.</p>
      </div>

      <div class="mt-10 border-t border-border">
        {merchandising.map(({ bundle, merch }, index) => {
          const copy = choiceCopy[bundle.data.slug as keyof typeof choiceCopy];
          return (
            <a
              href={`/bundles/${bundle.data.slug}/`}
              class="group grid gap-4 border-b border-border py-7 lg:grid-cols-[3rem_10rem_1.1fr_1.1fr_auto] lg:items-start lg:gap-6"
              data-event="bundle_choice"
              data-product-slug={bundle.data.slug}
            >
              <span class="font-mono text-xs text-primary-accent">{String(index + 1).padStart(2, "0")}</span>
              <span class="text-xs font-semibold uppercase tracking-[.14em] text-muted-foreground">{bundle.data.stage}</span>
              <div>
                <p class="text-lg font-semibold text-foreground transition-colors group-hover:text-primary-accent">{copy?.problem ?? bundle.data.shortDescription ?? bundle.data.outcome}</p>
                <p class="mt-2 text-sm font-semibold text-primary-accent">{bundle.data.title} →</p>
              </div>
              <p class="leading-7 text-muted-foreground">{copy?.result ?? bundle.data.outcome}</p>
              <div class="lg:text-right">
                {merch.bundlePriceFormatted && <p class="font-semibold text-foreground">{merch.bundlePriceFormatted}</p>}
                {merch.savings && merch.savingsPercent && <p class="mt-1 text-xs text-primary-accent">Save ${merch.savings.toFixed(0)} · {merch.savingsPercent}%</p>}
                <p class="mt-1 text-xs text-muted-foreground">{merch.productCount} included system{merch.productCount === 1 ? "" : "s"}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-end">
        <div>
          <p class="editorial-kicker">Compare the bundles</p>
          <h2 class="mt-4 text-4xl font-semibold tracking-tight">Inspect the scope before you decide.</h2>
        </div>
        <p class="max-w-2xl text-lg leading-8 text-muted-foreground">Each bundle page explains what the combined system is meant to change, which products are included, why they belong together, the recommended implementation order, who should buy it, who should not, and the current live price.</p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {bundles.map((bundle) => (
          <BundleOfferCard
            bundle={bundle}
            products={products}
            featured={bundle.data.slug === "freelance-developer-business-system"}
            location="bundles-index"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-4xl">
        <p class="editorial-kicker">Do not overbuy</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">Use the smallest purchase that matches the problem you can actually see.</h2>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">More material is not automatically more useful. The right scope depends on how much of the business is genuinely unclear or connected right now.</p>
      </div>

      <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border lg:grid-cols-3">
        <div class="bg-background p-7 sm:p-9">
          <p class="editorial-kicker">Several symptoms, unclear cause</p>
          <h3 class="mt-4 text-2xl font-semibold tracking-tight">Start with the Launch Kit.</h3>
          <p class="mt-4 leading-7 text-muted-foreground">Use the complete first operating system when offer, pricing, acquisition, sales, delivery, and management are still interacting in ways you have not fully diagnosed.</p>
          <p class="mt-7"><Button as="a" href="/products/freelance-developer-launch-kit/">See the Launch Kit</Button></p>
        </div>

        <div class="bg-background p-7 sm:p-9">
          <p class="editorial-kicker">One clear constraint</p>
          <h3 class="mt-4 text-2xl font-semibold tracking-tight">Buy the focused guide.</h3>
          <p class="mt-4 leading-7 text-muted-foreground">If the surrounding business is functioning and one problem clearly deserves deeper work, go directly to the specialist product for that problem.</p>
          <p class="mt-7"><Button as="a" href="/products/" variant="outline">Browse Focused Products</Button></p>
        </div>

        <div class="bg-background p-7 sm:p-9">
          <p class="editorial-kicker">Several connected constraints</p>
          <h3 class="mt-4 text-2xl font-semibold tracking-tight">Choose the matching bundle.</h3>
          <p class="mt-4 leading-7 text-muted-foreground">Use a bundle when you already expect to implement several included systems because the larger problem crosses those boundaries.</p>
          <p class="mt-7"><Button as="a" href="/start/" variant="outline">Help Me Choose</Button></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
