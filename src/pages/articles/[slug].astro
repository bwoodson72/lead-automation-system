---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import ArticleSidebar from "@/components/articles/ArticleSidebar.astro";
import { Button } from "@/components/starwind/button";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";

export async function getStaticPaths() {
  return (await getCollection("articles", ({ data }) => !data.draft)).map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const tocItems = headings.filter((heading) => heading.depth === 2).map((heading) => ({ slug: heading.slug, text: heading.text }));
const siteUrl = Astro.site?.toString() || "https://developerbusinesslab.com";
const canonical = new URL(`/articles/${article.id}/`, siteUrl).toString();
const organizationId = new URL("/#organization", siteUrl).toString();
const publishedDate = article.data.publishedAt.toLocaleDateString("en-US", { dateStyle: "long" });

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${canonical}#article`,
    headline: article.data.title,
    description: article.data.description,
    datePublished: article.data.publishedAt.toISOString(),
    ...(article.data.updatedAt ? { dateModified: article.data.updatedAt.toISOString() } : {}),
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    author: {
      "@type": "Person",
      name: "Brian Woodson",
    },
    publisher: { "@id": organizationId },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Articles",
        item: new URL("/articles/", siteUrl).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: article.data.title,
        item: canonical,
      },
    ],
  },
];
---

<BaseLayout title={`${article.data.title} | Developer Business Lab`} description={article.data.description} structuredData={structuredData}>
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    breadcrumbs={[{ label: "Articles", href: "/articles/" }, { label: article.data.category }]}
    eyebrow={article.data.category}
    title={article.data.title}
    description={article.data.description}
    supportingItems={["By Brian Woodson", publishedDate]}
  />

  <article class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-10 lg:grid-cols-4 lg:items-start">
        <main class="lg:col-span-3">
          <div class="max-w-3xl">
            {tocItems.length > 2 && (
              <nav aria-label="Table of contents" class="rounded-xl border border-border bg-card p-6 lg:hidden">
                <h2 class="font-semibold text-foreground">On this page</h2>
                <ul class="mt-3 space-y-2">
                  {tocItems.map((item) => (
                    <li>
                      <a href={`#${item.slug}`} class="text-sm text-primary-accent hover:text-foreground">{item.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}

            <div class:list={["space-y-6 leading-8 text-muted-foreground [&_h2]:pt-8 [&_h2]:text-3xl [&_h2]:font-semibold [&_h2]:text-foreground [&_p]:text-base [&_a]:font-medium [&_a]:text-primary-accent [&_a]:underline [&_a]:decoration-primary-accent/60 [&_a]:underline-offset-4 [&_a]:transition-colors [&_a:hover]:text-foreground [&_a:hover]:decoration-foreground/70 [&_a:focus-visible]:rounded-sm [&_a:focus-visible]:outline-none [&_a:focus-visible]:ring-2 [&_a:focus-visible]:ring-outline", tocItems.length > 2 ? "mt-12 lg:mt-0" : ""]}>
              <Content />
            </div>

            <div class="mt-14 rounded-xl border border-primary/20 bg-primary/10 p-7">
              <h2 class="text-2xl font-semibold">Build the business system behind your development work.</h2>
              <p class="mt-3 text-muted-foreground">Explore practical systems for positioning, pricing, client acquisition, sales, and recurring revenue.</p>
              <div class="mt-6"><Button as="a" href="/products/" data-event="article_to_product_navigation">Explore the systems</Button></div>
            </div>
          </div>
        </main>

        {tocItems.length > 2 && (
          <div class="hidden lg:sticky lg:top-32 lg:block">
            <ArticleSidebar tocItems={tocItems} />
          </div>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
