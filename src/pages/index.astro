---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import { Button } from "@/components/starwind/button";
import FAQList from "@/components/ui/FAQList.astro";
import TextLink from "@/components/ui/TextLink.astro";
import FlagshipProductFeature from "@/components/products/FlagshipProductFeature.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { isPublicProduct } from "@/lib/storefront-visibility";
import { applyProductCopyOverride, sanitizePublicCopy } from "@/lib/copy-overrides";

const products = (await getCollection("products")).filter(isPublicProduct);
const productBySlug = (slug: string) => products.find((entry) => entry.data.slug === slug);
const launchKit = productBySlug("freelance-developer-launch-kit");

const routes = sanitizePublicCopy([
  ["Offer", "I can do the work, but buyers still get a moving target.", "productize-your-dev-skills"],
  ["Pricing", "I need to know whether this project is worth taking before I quote it.", "web-developer-pricing-system"],
  ["Marketing", "I need the right buyers to understand why my technical work matters.", "marketing-for-builders"],
  ["Pipeline", "I need enough qualified opportunity moving that every inquiry is not necessary revenue.", "client-acquisition-without-upwork"],
  ["Social", "I spend time in public, but I cannot see a credible path from attention to client opportunity.", "social-media-client-acquisition-system"],
  ["Sales", "Good buyer conversations are happening, but too many end without a commercial decision.", "developer-sales-playbook"],
  ["Closing", "The opportunity is ready, but proposal, negotiation, payment, or project start still feels loose.", "developer-proposal-closing-kit"],
  ["Agencies", "I want repeat agency access without giving one partner too much influence over my business.", "agency-partnership-playbook"],
  ["Retainers", "Good clients still need useful work after launch, but the next commercial relationship is undefined.", "freelancer-retainer-system"],
]);

const resolvedRoutes = routes.flatMap(([stage, problem, slug]) => {
  const product = productBySlug(slug);
  return product ? [{ stage, problem, product }] : [];
});

const outcomes = [
  { title: "Quote without panic", description: "A project does not have to be won at any price because you understand what the work needs to support and other opportunities can still be developing." },
  { title: "Finish a project without starting from zero", description: "Buyer access and pipeline activity do not disappear simply because delivery became busy." },
  { title: "Turn down work that consumes the wrong part of your calendar", description: "Better qualification, pricing, and pipeline visibility make a weak-fit project easier to reject or reshape." },
  { title: "Build a business that belongs to you", description: "Your reputation, client relationships, commercial process, and future income depend less on one employer, platform, referral source, agency, or client." },
];

const faqs = [
  { data: { order: 1, question: "Where should I start if several parts of the business feel weak?", answer: "Start with the Freelance Developer Launch Kit. It builds the first complete operating foundation across offer, economics, buyer access, sales, delivery, future demand, and management review. If one constraint is already obvious, use the focused system for that problem." } },
  { data: { order: 2, question: "Do I need to buy the whole catalog?", answer: "No. Buy the smallest system that matches the problem. Focused products go deep on one constraint, bundles connect several related constraints, the Launch Kit builds the first complete foundation, and the complete Business System adds specialist depth across the broader commercial cycle." } },
  { data: { order: 3, question: "What am I buying?", answer: "Developer Business Lab sells digital instructional guides and implementation workbooks. The products teach commercial reasoning and turn it into records, calculations, decisions, and operating tools you can apply to an independent development business." } },
  { data: { order: 4, question: "Can I start without buying anything?", answer: "Yes. Developer Marketing Quickstart is the free starting point. It helps you put one real acquisition loop into motion and learn from buyer response before moving into a deeper paid system." } },
];
---

<BaseLayout title="Developer Business Lab | Business Systems for Freelance Developers" description="Practical business systems for independent developers who want more earning power, more reliable opportunity, and more control over how they work.">
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    variant="home"
    eyebrow="Business systems for independent developers"
    title="Build a freelance business strong enough to give you choices."
    description="Your technical ability should be able to buy you more than another project. Build the business capabilities that help you earn well, keep opportunities moving, choose work on better terms, and create more control over how you spend your time."
    primaryCta={{ label: "Start with the Launch Kit", href: "/products/freelance-developer-launch-kit/" }}
    secondaryCta={{ label: "Get the Free Quickstart", href: "/free/" }}
    supportingItems={["Practical guides", "Implementation workbooks", "Problem-specific business systems"]}
  />

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.75fr_1.25fr] lg:gap-20"><div><p class="editorial-kicker">Why freelancing in the first place?</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Valuable technical skills should give you options.</h2></div><div class="space-y-5 text-lg leading-8 text-muted-foreground"><p>More earning upside. More say over the calendar. The ability to choose better clients and projects. The option to work remotely, specialize, build recurring revenue, create products, take time away, or simply stop depending on one employer for all of your income.</p><p>Those benefits do not come from coding skill alone. They depend on the business around the skill.</p></div></div></section>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.75fr_1.25fr] lg:gap-20"><div><p class="editorial-kicker">Where freedom gets lost</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">A weak business can turn freelancing into the opposite of what you wanted.</h2></div><div class="space-y-5 text-lg leading-8 text-muted-foreground"><p>No boss can become six client-bosses. Schedule control can become everything being urgent. Earning upside can become fear of quoting a project at the price the obligation deserves. Independence can become dependence on one marketplace, agency, referral source, or large client.</p><p>The business side decides whether technical ability creates leverage or simply creates more work.</p></div></div></section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto max-w-7xl"><div class="max-w-3xl"><p class="editorial-kicker">What better feels like</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">You have choices because the business is producing enough money and enough opportunity that you are not trapped.</h2></div><div class="mt-10 grid gap-px overflow-hidden border border-border bg-border md:grid-cols-2">{outcomes.map((item) => <div class="bg-background p-7"><h3 class="text-xl font-semibold">{item.title}</h3><p class="mt-3 leading-7 text-muted-foreground">{item.description}</p></div>)}</div></div></section>

  {launchKit && <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto max-w-7xl"><div class="mb-10 max-w-3xl"><p class="editorial-kicker">When the whole business needs a foundation</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Build the first complete version of the freelance business around your technical skills.</h2><p class="mt-5 text-lg leading-8 text-muted-foreground">The Launch Kit connects offer, economics, buyer access, sales, delivery, future demand, and management review so the business can start accumulating understanding instead of repeatedly losing it.</p></div><FlagshipProductFeature product={{ ...launchKit, data: applyProductCopyOverride(launchKit.data) }} eyebrow="Recommended whole-business starting point" heading="Build the first operating foundation, then use evidence to decide what deserves deeper work." /></div></section>}

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto max-w-7xl"><div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-end"><div><p class="editorial-kicker">Already know the constraint?</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Go straight to the commercial problem that is limiting the business.</h2></div><p class="max-w-2xl text-lg leading-8 text-muted-foreground">You do not need every product. Use the focused system when one problem is clearly the problem.</p></div><div class="mt-10 border-t border-border">{resolvedRoutes.map(({ stage, problem, product }) => <a href={`/products/${product.data.slug}/`} class="group grid gap-3 border-b border-border py-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline sm:grid-cols-[8rem_1fr_auto] sm:items-center"><span class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">{stage}</span><span class="text-lg text-foreground/90 transition-colors group-hover:text-foreground">{problem}</span><span class="text-sm font-semibold text-primary-accent">{product.data.title} →</span></a>)}</div><p class="mt-8"><TextLink href="/start/">Help me choose where to start →</TextLink></p></div></section>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-16"><div class="max-w-3xl"><p class="editorial-kicker">Start before the current work runs out</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Give the next client search a head start.</h2><p class="mt-5 text-lg leading-8 text-muted-foreground">Developer Marketing Quickstart gives you a free guide and workbook for choosing a buyer, investigating a problem, shaping a provisional offer, qualifying a First 25, working the cycle, and using what happens to decide what to test next.</p></div><div class="lg:text-right"><Button as="a" href="/free/" size="lg">Get the Free Quickstart</Button><p class="mt-3 text-xs uppercase tracking-[0.12em] text-muted-foreground">Free digital guide + workbook · email required</p></div></div></section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto max-w-4xl"><p class="editorial-kicker">Questions before you choose</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Start with the scope of the problem you actually have.</h2><div class="mt-8"><FAQList faqs={faqs} /></div></div></section>
</BaseLayout>
