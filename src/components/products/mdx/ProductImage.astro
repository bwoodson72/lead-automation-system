---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="px-4 py-6 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl overflow-hidden rounded-2xl border border-border bg-card shadow-2xl shadow-black/20">
    <img src={src} alt={alt} class="block h-auto w-full" loading="lazy" />
  </div>
  {caption && <figcaption class="mx-auto mt-4 max-w-4xl text-center text-sm text-muted-foreground">{caption}</figcaption>}
</figure>
