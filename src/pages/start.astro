---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import TextLink from "@/components/ui/TextLink.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { isPublicProduct } from "@/lib/storefront-visibility";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";

const products = (await getCollection("products")).filter(isPublicProduct);
const productBySlug = (slug: string) => products.find((entry) => entry.data.slug === slug);
const launchKit = productBySlug("freelance-developer-launch-kit");
const launchKitCommerce = launchKit ? resolveProductCommerce(launchKit.data) : undefined;
const launchKitPriceLine = launchKitCommerce?.priceFormatted ? `${launchKitCommerce.priceFormatted}, one-time` : "One-time purchase";

const problems = [
  {
    stage: "Your offer",
    quote: '“Every prospect gets a different pitch, because I can build almost anything.”',
    change: "Turn everything you can do into one clear service buyers understand and can say yes to.",
    slug: "productize-your-dev-skills",
  },
  {
    stage: "Your pricing",
    quote: '“I have no idea if I’m charging too much or way too little.”',
    change: "Know what a project really costs you and whether it’s worth taking, before you name a price.",
    slug: "web-developer-pricing-system",
  },
  {
    stage: "Your marketing",
    quote: '“My work is better than the cheap option, but clients can’t tell.”',
    change: "Show the right buyers why your work is worth paying for, in terms they actually care about.",
    slug: "marketing-for-builders",
  },
  {
    stage: "Finding clients",
    quote: '“This project is ending and I’ve got nothing lined up.”',
    change: "Build a pipeline that keeps new opportunities moving while you’re busy delivering.",
    slug: "client-acquisition-without-upwork",
  },
  {
    stage: "Social media",
    quote: '“I post, other developers like it, and no clients ever show up.”',
    change: "Turn your time on social media into real conversations with the people who hire developers.",
    slug: "social-media-client-acquisition-system",
  },
  {
    stage: "Agencies",
    quote: '“One agency sends most of my work, and they’re starting to set the terms.”',
    change: "Build agency relationships that send steady, profitable work without controlling your income.",
    slug: "agency-partnership-playbook",
  },
  {
    stage: "Sales calls",
    quote: '“The call went great. Then they disappeared.”',
    change: "End every serious conversation with a clear decision and an agreed next step.",
    slug: "developer-sales-playbook",
  },
  {
    stage: "Proposals and closing",
    quote: '“The deal was almost done, then the proposal turned into free consulting or a discount.”',
    change: "Get the deal signed, paid, and started without giving away your margin.",
    slug: "developer-proposal-closing-kit",
  },
  {
    stage: "After launch",
    quote: '“A great project ends, and I never earn another dollar from that client.”',
    change: "Turn real ongoing client needs into monthly income with clear limits on your time.",
    slug: "freelancer-retainer-system",
  },
];
---

<BaseLayout title="Start Here | Developer Business Lab" description="Find the Developer Business Lab system that matches what is going wrong in your freelance business right now.">
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and workbooks on a developer workspace"
    eyebrow="Start Here"
    title="Something isn't working. Let's find out what."
    description="Pick the situation that sounds like your business right now. If it's one clear problem, you'll go straight to the system that fixes it. If several things are breaking at once, you'll start with the foundation."
    primaryCta={{ label: "Find My Problem", href: "#problems" }}
    secondaryCta={{ label: "Start Free", href: "/free/" }}
    supportingItems={["Start with the problem · No required order · Buy only what you need"]}
  />

  <section id="problems" class="scroll-mt-24 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="editorial-kicker">What keeps happening?</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-tight">Pick the one that sounds most like your month.</h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-muted-foreground">Don't worry about product names yet. Start with the moment that's costing you money, clients, time, or sleep.</p>

      <div class="mt-10 divide-y divide-border border-y border-border">
        {problems.map((problem) => {
          const product = productBySlug(problem.slug);
          if (!product) return null;
          return (
            <article class="grid gap-5 py-8 lg:grid-cols-[9rem_1.1fr_1fr_auto] lg:items-start lg:gap-8">
              <p class="pt-1 text-xs font-semibold uppercase tracking-[.14em] text-muted-foreground">{problem.stage}</p>
              <h3 class="text-xl font-semibold leading-8">{problem.quote}</h3>
              <p class="leading-7 text-muted-foreground">{problem.change}</p>
              <div class="lg:pt-1"><TextLink href={`/products/${product.data.slug}/`}>{product.data.title} →</TextLink></div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
      <div>
        <p class="editorial-kicker">If several of those sounded familiar</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">The problem is probably the whole business, not one part.</h2>
      </div>
      <div class="space-y-5 text-lg leading-8 text-muted-foreground">
        <p>That's common, because the problems feed each other. An empty pipeline makes you desperate on price. A vague offer makes marketing fall flat. Weak sales calls lead to wasted proposals. Busy delivery stops you from finding the next client. And a great project still ends with your income back at zero.</p>
        <p>Fixing one piece won't hold while the others keep pulling it down. Start with the <strong class="text-foreground">Freelance Developer Launch Kit</strong>, which builds every part of the business as one connected system and shows you what to fix next.</p>
        <p class="font-semibold text-foreground">{launchKitPriceLine}</p>
        <p><TextLink href="/products/freelance-developer-launch-kit/">See the Launch Kit →</TextLink></p>
      </div>
    </div>
  </section>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="editorial-kicker">If the problems cluster in one area</p>
      <h2 class="mt-4 text-4xl font-semibold tracking-tight">A bundle may be the right size.</h2>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-muted-foreground">When two or three problems sit in the same part of the business, fixing just one still leaves you stuck.</p>
      <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border lg:grid-cols-3">
        <article class="bg-background p-7">
          <h3 class="text-xl font-semibold">Offer, pricing, and marketing all feel shaky?</h3>
          <p class="mt-5"><TextLink href="/bundles/freelancer-starter-bundle/">Freelancer Starter Bundle →</TextLink></p>
        </article>
        <article class="bg-background p-7">
          <h3 class="text-xl font-semibold">Not enough good clients, from too few sources?</h3>
          <p class="mt-5"><TextLink href="/bundles/client-acquisition-bundle/">Client Acquisition Bundle →</TextLink></p>
        </article>
        <article class="bg-background p-7">
          <h3 class="text-xl font-semibold">Opportunities come in, but deals slip away or lose money?</h3>
          <p class="mt-5"><TextLink href="/bundles/freelancer-sales-system/">Freelancer Sales System →</TextLink></p>
        </article>
      </div>
      <p class="mt-7"><TextLink href="/bundles/">Compare all bundles →</TextLink></p>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
      <div>
        <p class="editorial-kicker">If finding clients is the first move</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">Start free with one real round.</h2>
      </div>
      <div class="space-y-5 text-lg leading-8 text-muted-foreground">
        <p>The Developer Marketing Quickstart walks you through choosing who to serve, finding a problem worth solving, building a simple offer, and reaching 25 qualified prospects. You'll finish with real conversations and real answers, and a much clearer idea of what to fix next.</p>
        <p><TextLink href="/free/">Get the Free Quickstart →</TextLink></p>
        <p class="text-sm">Free. Enter your email on the next screen and it's yours.</p>
      </div>
    </div>
  </section>

  <section class="px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl text-sm text-muted-foreground">Every purchase is covered by Developer Business Lab's 14-Day Satisfaction Guarantee. <a class="font-semibold text-primary-accent hover:underline" href="/refund-policy/">Read the full refund policy</a></div>
  </section>
</BaseLayout>
