---
interface Props {
  message: string;
}

const { message } = Astro.props;
---
<div role="status" class="flex h-9 items-center justify-center bg-primary-accent px-3 text-center text-[11px] font-semibold tracking-wide text-background sm:text-sm">
  <p class="whitespace-nowrap">{message}</p>
</div>
