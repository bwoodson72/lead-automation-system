---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
import FAQList from "@/components/ui/FAQList.astro";

const products = await getCollection("products");

const paths = [
  ["I can build, but I don't know what to sell", "productize-your-dev-skills"],
  ["I'm guessing what my work should cost", "web-developer-pricing-system"],
  ["I'm tired of depending on freelance marketplaces", "client-acquisition-without-upwork"],
  ["My work is better than the way I market it", "marketing-for-builders"],
  ["Prospecting keeps stopping when client work gets busy", "ai-prospecting-starter"],
  ["Prospects talk to me but don't make a decision", "developer-sales-playbook"],
  ["I want agency work without becoming cheap overflow labor", "agency-partnership-playbook"],
  ["I'm starting from zero after every project", "freelancer-retainer-system"],
  ["I want to validate SaaS demand before I spend months building", "saas-validation-before-you-build"],
];

const resolvedPaths = paths.flatMap(([problem, slug]) => {
  const product = products.find((entry) => entry.data.slug === slug);
  return product ? [{ problem, product }] : [];
});

const faqs = [
  {
    data: {
      order: 1,
      question: "Will these systems work with my stack or type of development work?",
      answer: "They are built around commercial decisions rather than a specific framework. The relevant question is whether you can credibly solve the buyer's problem, not whether you use React, WordPress, Astro, Laravel, or something else.",
    },
  },
  {
    data: {
      order: 2,
      question: "What if I do not have strong case studies yet?",
      answer: "You still need honest proof, but proof can start with demonstrations, audits, prototypes, process artifacts, before-and-after work, and relevant personal projects. The products distinguish proof of capability from proof of client outcomes so you do not have to invent authority you do not have.",
    },
  },
  {
    data: {
      order: 3,
      question: "Do I need to build the whole business system at once?",
      answer: "No. Start with the bottleneck that is creating the most friction now. The Start Here diagnostic helps you identify the next system instead of turning the catalog into a rigid curriculum.",
    },
  },
  {
    data: {
      order: 4,
      question: "Why guides instead of one big course?",
      answer: "A developer who has a pricing problem does not need twenty hours of acquisition material before getting to it. Each guide is built around one operating problem so you can buy and implement the system you need now.",
    },
  },
];
---

<BaseLayout
  title="Developer Business Lab | Business Systems for Independent Developers"
  description="Practical business systems for capable independent developers who want clearer offers, defensible pricing, better client acquisition, stronger sales, and a business that does not restart from zero every month."
>
  <section class="border-b border-border px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Developer Business Lab</p>
      <h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight sm:text-7xl">You are good at the work. You are tired of starting the business from zero every month.</h1>
      <p class="mt-7 max-w-3xl text-xl leading-8 text-muted-foreground">Practical systems for independent developers who were taught how to build, but never taught how to define an offer, set a price, create demand, run a sales process, or turn successful work into something repeatable.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button as="a" href="/start/" size="lg">Find the System You Need</Button>
        <Button as="a" href="/free/" variant="outline" size="lg">Get Developer Marketing Quickstart Free</Button>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">The gap</p>
      <h2 class="mt-3 text-3xl font-semibold">Technical competence and business competence are different skill sets.</h2>
      <div class="mt-5 space-y-5 text-lg leading-8 text-muted-foreground">
        <p>You can be a very good developer and still struggle to explain what you sell, defend a price, keep the pipeline moving, or turn a promising sales call into a signed project. Most developers were never taught those systems. In an agency or in-house role, somebody else may have handled them. In freelancing, they suddenly become your job.</p>
        <p>That is why the usual advice is so frustrating. One source tells you to niche down. Another gives you a cold-email template. Another tells you to raise your rates. Each idea might be useful, but none tells you what has to be true before that tactic can work or what system comes next.</p>
        <p>Developer Business Lab breaks the commercial side of independent development into focused operating systems. You start with the problem you already know you have, make the decisions that problem requires, put them into use, and improve them from evidence.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/30 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">What is inside</p>
      <h2 class="mt-3 text-3xl font-semibold">Start with the sentence that sounds most like your problem.</h2>
      <p class="mt-4 max-w-3xl text-muted-foreground">Each link goes directly to the system for that bottleneck. You do not need to buy or read the catalog in order.</p>
      <div class="mt-8 grid gap-3 md:grid-cols-2">
        {resolvedPaths.map(({ problem, product }) => (
          <a
            href={`/products/${product.data.slug}/`}
            class="group flex items-center justify-between gap-6 rounded-xl border border-border bg-card p-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline"
            data-event="problem_path"
            data-product-slug={product.data.slug}
          >
            <span>{problem}</span>
            <span class="shrink-0 text-right text-sm font-semibold text-primary-accent">{product.data.title} →</span>
          </a>
        ))}
      </div>
      <p class="mt-7"><Button as="a" href="/products/" variant="outline">Browse Every Business System</Button></p>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-semibold">For:</h2>
        <ul class="mt-6 space-y-3 text-muted-foreground">
          <li>✓ Independent developers who can deliver the technical work but still improvise parts of the business.</li>
          <li>✓ Freelancers tired of marketplaces, unpredictable referrals, arbitrary pricing, and rebuilding every sales process from scratch.</li>
          <li>✓ Developers who want direct instructions, working tools, honest boundaries, and evidence instead of motivational business content.</li>
        </ul>
      </div>
      <div>
        <h2 class="text-3xl font-semibold">Not for:</h2>
        <ul class="mt-6 space-y-3 text-muted-foreground">
          <li>× Anyone looking for guaranteed clients, guaranteed revenue, or a passive business that requires no selling or delivery.</li>
          <li>× Anyone who wants one universal script, price, niche, or growth hack to replace business judgment.</li>
          <li>× Large agencies looking for enterprise staffing, finance, or multi-team operating systems.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/30 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Concrete examples</p>
      <h2 class="mt-3 text-3xl font-semibold">The work gets easier to sell when the business decision gets specific.</h2>
      <div class="mt-8 grid gap-4 lg:grid-cols-3">
        <div class="rounded-xl border border-border bg-card p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Offer</p>
          <p class="mt-3 text-sm text-muted-foreground">Before: “I build APIs and integrations.”</p>
          <p class="mt-3 font-medium">After: “I remove duplicate data entry between the systems your team already uses.”</p>
        </div>
        <div class="rounded-xl border border-border bg-card p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Pricing</p>
          <p class="mt-3 text-sm text-muted-foreground">Before: estimate coding hours and choose a number that feels safe.</p>
          <p class="mt-3 font-medium">After: price the whole engagement from your economics, uncertainty, scope, risk, and commercial context.</p>
        </div>
        <div class="rounded-xl border border-border bg-card p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Acquisition</p>
          <p class="mt-3 text-sm text-muted-foreground">Before: “I need clients, so I should try more outreach.”</p>
          <p class="mt-3 font-medium">After: test one offer for one buyer through one channel and know what result you are measuring.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-3xl font-semibold">Questions before you start</h2>
      <div class="mt-8"><FAQList faqs={faqs} /></div>
      <div class="mt-12 border-t border-border pt-10">
        <h2 class="text-3xl font-semibold">Find the problem that is costing you the most right now.</h2>
        <p class="mt-4 text-muted-foreground">Use the Start Here diagnostic for a direct recommendation, or build the first acquisition loop with the free Developer Marketing Quickstart.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button as="a" href="/start/" size="lg">Use the Start Here Diagnostic</Button>
          <Button as="a" href="/free/" variant="outline" size="lg">Get Developer Marketing Quickstart Free</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
