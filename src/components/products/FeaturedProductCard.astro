---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import TextLink from "@/components/ui/TextLink.astro";
import { resolveProductCoverImage } from "@/lib/product-cover-images";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";

interface Props { product: CollectionEntry<"products">; }
const { product } = Astro.props;
const d = product.data;
const commerce = resolveProductCommerce(d);
const cover = resolveProductCoverImage(d, commerce.purchasable ? commerce.product?.id : undefined);
const price = d.free ? "Free" : commerce.priceFormatted ?? (commerce.effectiveStatus === "coming-soon" ? "Coming soon" : "Planned");
---
<article class="group relative overflow-hidden border-t border-border py-7 sm:grid sm:grid-cols-[8rem_1fr] sm:gap-7">
  <a href={`/products/${d.slug}/`} class="block" aria-label={`View ${d.title}`}>
    <div class="mx-auto flex h-44 w-32 items-center justify-center sm:mx-0 sm:h-48 sm:w-36">
      {cover ? <Image src={cover} alt={`${d.title} cover`} class="h-full w-full object-contain drop-shadow-[0_18px_30px_rgba(0,0,0,.45)] transition-transform duration-300 group-hover:-translate-y-1" widths={[220,320,440]} sizes="144px" /> : <div class="h-full w-full border border-border bg-card"></div>}
    </div>
  </a>
  <div class="mt-5 self-center sm:mt-0">
    <p class="editorial-kicker">{d.family}</p>
    <h3 class="mt-2 text-2xl font-semibold tracking-tight"><a href={`/products/${d.slug}/`} class="hover:text-primary-accent">{d.title}</a></h3>
    <p class="mt-3 max-w-xl leading-7 text-muted-foreground">{d.shortDescription}</p>
    <div class="mt-5 flex items-center justify-between gap-4">
      <p class="text-lg font-semibold">{price}</p>
      <TextLink href={`/products/${d.slug}/`} class="text-sm">Explore the system →</TextLink>
    </div>
  </div>
</article>
