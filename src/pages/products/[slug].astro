---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import ProductCTA from "@/components/products/ProductCTA.astro";
import ProductCover from "@/components/products/ProductCover.astro";
import FAQList from "@/components/ui/FAQList.astro";
export async function getStaticPaths() { return (await getCollection("products")).map((product) => ({ params: { slug: product.data.slug }, props: { product } })); }
const { product } = Astro.props;
const d = product.data;
const allProducts = await getCollection("products");
const related = allProducts.filter((p) => d.relatedProducts.includes(p.data.slug));
const canonical = Astro.site ? new URL(`/products/${d.slug}/`, Astro.site).toString() : undefined;
const breadcrumbs = canonical ? { "@context":"https://schema.org", "@type":"BreadcrumbList", itemListElement:[{"@type":"ListItem",position:1,name:"Products",item:new URL("/products/",Astro.site).toString()},{"@type":"ListItem",position:2,name:d.title,item:canonical}] } : undefined;
---
<BaseLayout title={d.seo.title} description={d.seo.description} noindex={d.status === "planned"} enableCheckoutOverlay={d.status === "available" && Boolean(d.checkoutUrl)}>
  {breadcrumbs && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />}
  <section class="border-b border-border px-4 py-16 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><nav aria-label="Breadcrumb" class="text-sm text-muted-foreground"><a href="/products/" class="hover:text-foreground">Products</a><span aria-hidden="true"> / </span><span>{d.title}</span></nav><div class="mt-10 grid gap-14 lg:grid-cols-2 lg:items-center"><div><div class="flex flex-wrap gap-2"><Badge variant="outline">{d.family}</Badge>{d.tier && <Badge>Tier {d.tier}</Badge>}<Badge variant="secondary">{d.status === "coming-soon" ? "Coming soon" : d.status}</Badge></div><h1 class="mt-5 text-5xl font-semibold tracking-tight sm:text-6xl">{d.title}</h1><p class="mt-6 text-2xl font-semibold text-primary-accent">{d.coreOutcome}</p><p class="mt-5 text-lg leading-8 text-muted-foreground">{d.shortDescription}</p><p class="mt-6 border-l-2 border-primary pl-4"><strong>Designed for:</strong> <span class="text-muted-foreground">{d.audience}</span></p><div class="mt-8"><ProductCTA product={product} location="hero" /></div><p class="mt-4 text-sm text-muted-foreground">{d.format}{d.price ? ` · $${d.price}` : d.status === "coming-soon" ? " · Final price not yet published" : ""}</p></div><ProductCover title={d.title} family={d.family} tier={d.tier} image={d.coverImage} /></div></div></section>
  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2"><div><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">The situation</p><h2 class="mt-3 text-3xl font-semibold">The bottleneck is a missing system.</h2><p class="mt-5 text-lg leading-8 text-muted-foreground">{d.situation}</p></div><div class="rounded-xl border border-border bg-card p-7"><h2 class="text-xl font-semibold">Why the obvious approach falls short</h2><p class="mt-4 leading-7 text-muted-foreground">{d.commonFailure}</p><h3 class="mt-7 font-semibold">What needs to change</h3><p class="mt-3 leading-7 text-muted-foreground">{d.methodology}</p></div></div></section>
  <section class="border-y border-border bg-card/30 px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">What you will be able to do</p><h2 class="mt-3 text-3xl font-semibold">Build capability, not just collect information.</h2><ul class="mt-9 grid gap-4 md:grid-cols-2">{d.capabilities.map((item) => <li class="rounded-xl border border-border bg-card p-5"><span aria-hidden="true" class="mr-3 text-success">✓</span>{item}</li>)}</ul><h2 class="mt-14 text-3xl font-semibold">The implementation path</h2><ol class="mt-7 grid gap-3 md:grid-cols-3">{d.workflow.map((step,index) => <li class="rounded-lg border border-border bg-card px-4 py-4"><span class="mr-3 font-mono text-xs text-primary-accent">{String(index+1).padStart(2,"0")}</span>{step}</li>)}</ol></div></section>
  {d.tier && <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><h2 class="text-3xl font-semibold">Technical boundary</h2><div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4"><div class="rounded-xl border border-border bg-card p-5"><h3 class="font-semibold">Automation</h3><p class="mt-2 text-sm text-muted-foreground">{d.automationLevel}</p></div><div class="rounded-xl border border-border bg-card p-5"><h3 class="font-semibold">Technical level</h3><p class="mt-2 text-sm text-muted-foreground">{d.technicalLevel}</p></div><div class="rounded-xl border border-border bg-card p-5"><h3 class="font-semibold">State</h3><p class="mt-2 text-sm text-muted-foreground">{d.stateModel}</p></div><div class="rounded-xl border border-border bg-card p-5"><h3 class="font-semibold">Supervision</h3><p class="mt-2 text-sm text-muted-foreground">{d.supervision}</p></div></div><p class="mt-6 rounded-xl border border-warning/30 bg-warning/10 p-5 text-sm">{d.technicalBoundary}</p><p class="mt-6 text-sm text-muted-foreground"><strong class="text-foreground">Primary tools:</strong> {d.tools.join(", ")}</p></div></section>}
  <section class="border-y border-border bg-card/30 px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-2"><div><h2 class="text-3xl font-semibold">This is for</h2><ul class="mt-6 space-y-3">{d.whoItsFor.map((item) => <li class="text-muted-foreground">✓ {item}</li>)}</ul></div><div><h2 class="text-3xl font-semibold">This is not for</h2><ul class="mt-6 space-y-3">{d.whoItsNotFor.map((item) => <li class="text-muted-foreground">× {item}</li>)}</ul></div></div></section>
  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-4xl"><h2 class="text-3xl font-semibold">Choose the next honest step.</h2><p class="mt-4 leading-7 text-muted-foreground">{d.status === "coming-soon" ? "This product is defined but not yet commercially ready. Final contents, price, and delivery details will be published only when they are confirmed." : d.coreOutcome}</p><div class="mt-8"><ProductCTA product={product} location="final" /></div>{d.faqs.length > 0 && <div class="mt-12"><FAQList faqs={d.faqs.map((faq,index) => ({data:{...faq,order:index}}))} /></div>}{related.length > 0 && <div class="mt-12"><h2 class="text-2xl font-semibold">Related systems</h2><div class="mt-5 flex flex-wrap gap-3">{related.map((item) => <Button as="a" href={`/products/${item.data.slug}/`} variant="outline">{item.data.title}</Button>)}</div></div>}</div></section>
</BaseLayout>
