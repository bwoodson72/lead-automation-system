---
import BaseLayout from "@/layouts/BaseLayout.astro";
import KitForm from "@/components/marketing/KitForm.astro";
import ProductCover from "@/components/products/ProductCover.astro";
---
<BaseLayout title="Free Developer Marketing Quickstart | Prospect Foundry" description="Build a minimum viable customer-acquisition system in seven days."><section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-2 lg:items-center"><div><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Free starting point</p><h1 class="mt-4 text-5xl font-semibold tracking-tight">Developer Marketing Quickstart</h1><p class="mt-6 text-2xl font-semibold text-primary-accent">Build a minimum viable customer-acquisition system in seven days.</p><p class="mt-5 text-lg leading-8 text-muted-foreground">Clarify who you target, the problem you sell against, what you offer, what to say, where to find buyers, what to do next, and what to measure.</p><div class="mt-8"><KitForm kind="quickstart" /></div></div><ProductCover title="Developer Marketing Quickstart" family="Free Resource" /></div></section><section class="border-t border-border bg-card/30 px-4 py-16 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><h2 class="text-3xl font-semibold">The seven-day operating loop</h2><ol class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{["Choose a target","Define the problem","Shape the offer","Write the message","Find buyers","Set the next action","Measure and improve"].map((item,index)=><li class="rounded-lg border border-border bg-card p-5"><span class="font-mono text-xs text-primary-accent">DAY {index+1}</span><p class="mt-2">{item}</p></li>)}</ol><p class="mt-7 text-sm text-muted-foreground">The guide and Kit delivery automation must be complete before the form is enabled. No unavailable download is being advertised as ready.</p></div></section></BaseLayout>
