---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import ProductCTA from "@/components/products/ProductCTA.astro";
import ProductCover from "@/components/products/ProductCover.astro";
import ProductProof from "@/components/products/ProductProof.astro";
import FAQList from "@/components/ui/FAQList.astro";
import heroImage from "@/assets/brand/neutral-hero.png";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";

const products = await getCollection("products");
const product = products.find((item) => item.data.slug === "developer-marketing-quickstart");
if (!product) throw new Error("Developer Marketing Quickstart product entry was not found.");
const d = product.data;
const commerce = resolveProductCommerce(d);
const paragraphs = (d.reframe ?? d.situation).split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<BaseLayout title={d.seo.title} description={d.seo.description} enableCheckoutOverlay={commerce.purchasable}>
  <PageHero
    image={heroImage}
    imageAlt="Dark developer workspace at night with warm desk lighting and city lights beyond the window"
    eyebrow="Free · Developer Marketing Quickstart"
    title={d.hook}
    description={d.shortDescription}
    audience={d.audience}
    supportingItems={["30-page guide + 16-page workbook", "Seven-day first execution", "Qualified First 25 + diagnostic loop"]}
  >
    <div slot="actions"><ProductCTA product={product} location="free-page-hero" /></div>
    <div slot="visual" class="gold-glow"><ProductCover product={product} /></div>
  </PageHero>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-20">
      <div><p class="editorial-kicker">The problem underneath the tactics</p><h2 class="mt-4 text-3xl font-semibold">More activity does not fix a customer-acquisition loop you cannot diagnose.</h2></div>
      <div class="space-y-5 text-lg leading-8 text-muted-foreground">{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="editorial-kicker">Inside the Quickstart system</p>
      <div class="mt-4 grid gap-8 lg:grid-cols-[1fr_.55fr] lg:gap-16">
        <div><h2 class="text-4xl font-semibold tracking-tight">Build one connected acquisition loop from market choice to the next experiment.</h2><ol class="mt-8 border-t border-border">{d.contents.map((item, index) => <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-border py-5"><span class="font-mono text-xs text-primary-accent">{String(index + 1).padStart(2, "0")}</span><span>{item}</span></li>)}</ol></div>
        {d.delivery && <aside class="surface-editorial self-start p-7"><p class="editorial-kicker">What you receive</p><dl class="mt-6 space-y-6"><div><dt class="font-semibold">Guide</dt><dd class="mt-2 text-sm leading-6 text-muted-foreground">{d.delivery.length}</dd></div><div><dt class="font-semibold">Workbook</dt><dd class="mt-2 text-sm leading-6 text-muted-foreground">{d.delivery.worksheets}</dd></div><div><dt class="font-semibold">First execution</dt><dd class="mt-2 text-sm leading-6 text-muted-foreground">{d.delivery.time}</dd></div></dl></aside>}
      </div>
    </div>
  </section>

  {d.proofPackage && <ProductProof proof={d.proofPackage} />}

  <section class="border-t border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <p class="editorial-kicker">Before you download it</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Questions worth answering first.</h2><div class="mt-8"><FAQList faqs={d.faqs.map((faq, index) => ({ data: { ...faq, order: index } }))} /></div>
      <div class="mt-14 border-t border-border pt-12"><p class="editorial-kicker">Start free</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Put one real acquisition loop into motion.</h2><p class="mt-5 text-lg leading-8 text-muted-foreground">Finish with a defined buyer, evidence-backed problem, provisional offer price, buyer-first message, one channel, a qualified First 25, an execution cadence, and a next experiment you can explain.</p><div class="mt-8"><ProductCTA product={product} location="free-page-final" /></div></div>
    </div>
  </section>
</BaseLayout>
