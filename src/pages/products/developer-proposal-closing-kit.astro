---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import ProductCTA from "@/components/products/ProductCTA.astro";
import ProductHeroPurchaseCard from "@/components/products/ProductHeroPurchaseCard.astro";
import ProductPreviewGallery from "@/components/products/ProductPreviewGallery.astro";
import FAQList from "@/components/ui/FAQList.astro";
import heroImage from "@/assets/brand/neutral-hero.png";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";
import { applyProductCopyOverride } from "@/lib/copy-overrides";
import { cleanPublicCopyTree } from "@/lib/public-copy-cleaner";

const sourceProduct = (await getCollection("products")).find((entry) => entry.data.slug === "developer-proposal-closing-kit");
if (!sourceProduct) throw new Error("Developer Proposal & Closing Kit product record not found.");
const d = cleanPublicCopyTree(applyProductCopyOverride(sourceProduct.data));
const product = { ...sourceProduct, data: d };
const commerce = resolveProductCommerce(d);
const priceLine = commerce.priceFormatted ? `${commerce.priceFormatted}, one-time` : "One-time purchase";
const previews = [
  {
    image: "developer-proposal-closing-kit/scope-module.svg",
    alt: "Completed Redwood Roofing Scope Module defining business purpose, deliverables, quantities, acceptance conditions, client inputs, exclusions, and change triggers",
    label: "Workbook PC05 · Scope Module",
    caption: "The worked scope record turns a broad project into explicit deliverables, quantities, acceptance conditions, client inputs, exclusions, and change triggers before those details can drift during proposal review.",
  },
  {
    image: "developer-proposal-closing-kit/objection-diagnostic.svg",
    alt: "Completed Redwood Roofing Objection Diagnostic separating a price concern from payment-timing concerns and identifying the next commercial decision",
    label: "Workbook PC16 · Objection Diagnostic",
    caption: "A price objection is diagnosed before the deal changes. The worksheet separates scope and price comparison from cash-flow concerns so the response can address the real issue without automatically discounting the total price.",
  },
  {
    image: "developer-proposal-closing-kit/one-page-closing-sop.svg",
    alt: "Completed Redwood Roofing One-Page Closing SOP covering gate, synthesis, scope, risk, price, proposal, presentation, revision control, execution, handoff, and learning",
    label: "Workbook PC27 · One-Page Closing SOP",
    caption: "The closing SOP condenses the full proposal-to-close process into one operating sequence, including proposal construction, objection handling, revision control, required payment, Start-Ready conditions, and delivery handoff.",
  },
];
const siteUrl = Astro.site?.toString() || "https://developerbusinesslab.com";
const canonical = new URL("/products/developer-proposal-closing-kit/", siteUrl).toString();
const organizationId = new URL("/#organization", siteUrl).toString();
const parsedPrice = commerce.priceFormatted ? Number(commerce.priceFormatted.replace(/[^0-9.]/g, "")) : undefined;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Products", item: new URL("/products/", siteUrl).toString() },
      { "@type": "ListItem", position: 2, name: d.title, item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": `${canonical}#product`,
    name: d.title,
    description: d.seo.description,
    url: canonical,
    category: d.family,
    sku: d.slug,
    brand: { "@id": organizationId },
    audience: { "@type": "Audience", audienceType: d.audience },
    ...(commerce.purchasable && Number.isFinite(parsedPrice) ? {
      offers: {
        "@type": "Offer",
        url: canonical,
        priceCurrency: "USD",
        price: parsedPrice!.toFixed(2),
        availability: "https://schema.org/InStock",
      },
    } : {}),
  },
];

const buildItems = [
  ["Proposals that confirm, not discover", "Proposals built on what was already agreed in the sales conversation, so they get signed instead of reopening the whole project."],
  ["The complete deal package", "Scope, assumptions, responsibilities, price, payment terms, and timeline, assembled so nothing important is left vague."],
  ["Controlled reviews and revisions", "How to handle client feedback on the proposal without it turning into unpaid redesign."],
  ["Negotiation that protects your margin", "How to respond to price pushback by trading scope, timing, or terms instead of just cutting your price."],
  ["Objection handling", "Calm, honest responses to the concerns that stall deals, without pressure tactics."],
  ["Documented changes", "How to record anything that changes during closing, so the final agreement matches what everyone understood."],
  ["Signature and payment, secured", "How to get the agreement signed and the deposit paid before any work begins."],
  ["A clean project start", "A handoff that carries everything agreed during the sale into delivery, so the project starts organized and stays on scope."],
];

const faqs = [
  { data: { question: "Does this include proposal templates?", answer: "It includes 12 matched implementation records, a persistent Final Commercial Record, worked Redwood Roofing examples, and the material you use to assemble a One-Page Closing SOP. It is not a generic plug-and-play proposal template pack. More importantly, it teaches you what belongs in a proposal and why, so you can adapt it to any deal." } },
  { data: { question: "What if the client asks for a discount?", answer: "That's covered in detail. You'll learn how to respond by adjusting scope, timing, or payment terms instead of simply cutting your price." } },
  { data: { question: "Won't asking for a deposit scare clients off?", answer: "Good clients expect it. A clear deposit and payment schedule is a sign of a professional business, and it protects both of you." } },
  { data: { question: "Is this a legal contract product?", answer: "No. It covers the commercial side of closing: proposals, agreements, negotiation, payment terms, and keeping the current deal state consistent. It does not include contract templates or legal advice. For contract language, legal effect, IP treatment, procurement terms, or questions specific to your location, consult a qualified professional." } },
  { data: { question: "How long does it take?", answer: "Use the system on one qualified opportunity rather than treating it like a course you must finish first. The kit includes a 108-page guide with 12 chapters and an 83-page fillable workbook with 12 matched implementation records. Complete each record when the guide calls for it so the same commercial decisions carry forward from proposal readiness through agreement, payment, and project start." } },
  { data: { question: "What if it isn't right for me?", answer: "Eligible purchases are covered by Developer Business Lab's 14-Day Satisfaction Guarantee. After reviewing the product, if you decide it isn't useful for your business, you may request a refund within 14 days of purchase." } },
];
---

<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  enableCheckoutOverlay={commerce.purchasable}
  structuredData={structuredData}
>
  <PageHero
    image={heroImage}
    imageAlt="Dark developer workspace at night with warm desk lighting and city lights beyond the window"
    breadcrumbs={[{ label: "Products", href: "/products/" }, { label: d.title }]}
    eyebrow="Developer Proposal & Closing Kit"
    title="Get the deal signed and paid without giving away your margin."
    description="Turn a ready opportunity into a signed agreement, a paid deposit, and a clean project start. Write proposals that confirm the deal instead of reopening it, handle negotiation without slashing your price, and start every project with scope and payment locked in."
  >
    <div slot="visual" class="min-w-0 max-w-full">
      <ProductHeroPurchaseCard
        product={product}
        ctaLabel="Get the Proposal & Closing Kit"
        supportingText="A guide, fill-in workbooks, and templates you use on real deals."
      />
    </div>
  </PageHero>

  <section class="px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-20">
      <div><h2 class="text-4xl font-semibold tracking-tight">The deal was almost done. Then the proposal happened.</h2></div>
      <div class="space-y-5 text-lg leading-8 text-muted-foreground">
        <p>You sent the proposal and the questions started. Could you add this feature? What if the design went a different way? Could you break the price down line by line? Three revisions later, you've done a week of free consulting and the client still hasn't signed.</p>
        <p>Or they signed, but asked for a discount first, and you gave it without changing anything else. Or you started work before the deposit cleared, because you didn't want to seem difficult.</p>
        <p class="font-semibold text-foreground">Each of those moments costs you money. None of them is about your development skills.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-4xl font-semibold tracking-tight">The discount request, handled two ways</h2>
      <p class="mt-6 max-w-4xl text-lg leading-8 text-muted-foreground">You've sent a proposal for $5,500: a new website, a blog, and an online booking integration. The client replies: <em>“We love it. Can you do it for $4,000?”</em></p>
      <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border lg:grid-cols-2">
        <div class="bg-background p-7">
          <p class="editorial-kicker">The usual response</p>
          <p class="mt-4 text-lg leading-8 text-muted-foreground">You don't want to lose the deal, so you say yes. Same scope, same timeline, $1,500 less. You've just agreed to do the same work at a much lower rate, and the client has learned your prices are negotiable.</p>
        </div>
        <div class="bg-background p-7">
          <p class="editorial-kicker">The same request, handled as a business decision</p>
          <p class="mt-4 text-lg leading-8 text-muted-foreground">You reply: <em>“I can get to $4,000 by launching the core website first and moving the blog and booking integration to a second phase. Or we can keep everything at $5,500 and spread the payments over three milestones instead of two. Which works better for you?”</em></p>
          <p class="mt-5 text-lg leading-8 text-muted-foreground">The client picks the second option. You keep your full price, the project is still fully scoped, and the client got a real choice instead of a discount.</p>
        </div>
      </div>
      <p class="mt-8 text-xl font-semibold">When price changes, something else changes with it. That one rule protects more margin than almost anything else in freelancing.</p>
      <p class="mt-3 text-sm italic text-muted-foreground">Illustrative example.</p>
    </div>
  </section>

  <section class="px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-20">
      <div><h2 class="text-4xl font-semibold tracking-tight">Agencies don't start without a signature and a deposit.</h2></div>
      <div class="space-y-5 text-lg leading-8 text-muted-foreground">
        <p>Agencies treat the close as a process. By the time a proposal goes out, the scope and price have already been discussed. They trade scope rather than cutting price, put every change in writing, and don't start work until the agreement is signed and the deposit has cleared.</p>
        <p>That isn't rigid. It's professional, and clients expect it. The Proposal & Closing Kit gives a one-person business that same process, so the deal you agreed to is the deal you actually deliver and get paid for.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-4xl font-semibold tracking-tight">What you'll build</h2>
      <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border md:grid-cols-2 lg:grid-cols-3">
        {buildItems.map(([title, body]) => (
          <article class="bg-background p-7"><h3 class="text-xl font-semibold">{title}</h3><p class="mt-3 leading-7 text-muted-foreground">{body}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-4xl font-semibold tracking-tight">What changes</h2>
      <div class="mt-8 space-y-5 text-lg leading-8 text-muted-foreground">
        <p>Proposals get signed instead of revised endlessly.</p>
        <p>You stop discounting out of fear and start offering real options.</p>
        <p>You never start work before the deposit clears.</p>
        <p>The project you deliver matches the deal you agreed to.</p>
        <p>Late payments and scope disputes become rare, because everything was clear from the start.</p>
        <p>And closing a deal starts to feel professional instead of awkward.</p>
      </div>
    </div>
  </section>

  <ProductPreviewGallery
    heading="See inside"
    previews={previews}
    conclusion="You'll use these on every deal you close, from proposal to kickoff."
  />

  <section class="px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-4xl font-semibold tracking-tight">Where this fits</h2>
      <div class="mt-8 space-y-6 text-lg leading-8 text-muted-foreground">
        <p><strong class="text-foreground">Using the Developer Sales Playbook?</strong> The Sales Playbook gets an opportunity ready for a proposal. This kit takes it from there to a signed, paid project. Together they're part of the <a class="font-semibold text-primary-accent hover:underline" href="/bundles/freelancer-sales-system/">Freelancer Sales System</a> bundle. <a class="font-semibold text-primary-accent hover:underline" href="/products/developer-sales-playbook/">See the Developer Sales Playbook</a>.</p>
        <p><strong class="text-foreground">Already have the Launch Kit?</strong> It covers closing at a foundational level. This goes much deeper, for when your business review shows deals are stalling or losing money at the finish line. <a class="font-semibold text-primary-accent hover:underline" href="/products/freelance-developer-launch-kit/">See the Launch Kit</a>.</p>
        <p><strong class="text-foreground">Still unsure about your prices?</strong> Pair this with the <a class="font-semibold text-primary-accent hover:underline" href="/products/web-developer-pricing-system/">Web Developer Pricing System</a>, so the price in your proposal is one you can confidently defend.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-5xl text-center">
      <h2 class="text-4xl font-semibold tracking-tight">The math</h2>
      <p class="mx-auto mt-6 max-w-4xl text-lg leading-8 text-muted-foreground">One unnecessary discount can cost you more than this kit many times over. So can one proposal that turns into weeks of free consulting, or one project that starts before the deposit and never gets fully paid. If this prevents even one of those, it has paid for itself.</p>
      <p class="mt-8 text-lg font-semibold">{priceLine}</p>
      <div class="mt-5 flex justify-center"><ProductCTA product={product} location="value" label="Get the Proposal & Closing Kit" /></div>
    </div>
  </section>

  <section class="px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-4xl font-semibold tracking-tight">Questions</h2>
      <div class="mt-8"><FAQList faqs={faqs} /></div>
      <p class="mt-5 text-sm text-muted-foreground"><a class="font-semibold text-primary-accent hover:underline" href="/refund-policy/">Read the full refund policy →</a></p>
    </div>
  </section>

  <section class="border-t border-border bg-card/35 px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-5xl text-center">
      <h2 class="text-4xl font-semibold tracking-tight sm:text-5xl">You earned the deal. Don't give it away at the finish line.</h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">Get every project signed, paid, and started right, at the price it deserves.</p>
      <p class="mt-8 text-lg font-semibold">{priceLine}</p>
      <div class="mt-5 flex justify-center"><ProductCTA product={product} location="final" label="Get the Proposal & Closing Kit" /></div>
    </div>
  </section>
</BaseLayout>
