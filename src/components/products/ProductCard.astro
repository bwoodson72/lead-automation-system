---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from "@/components/starwind/card";

const { product } = Astro.props;
const d = product.data;
const statusLabel = d.status === "coming-soon" ? "Coming soon" : d.status === "planned" ? "Planned" : d.free ? "Free" : d.price ? `$${d.price}` : "Available";

const productCoverImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/products/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);
const explicitCoverImageFile = d.coverImageSrc?.split("/").at(-1);
const explicitCoverImage = explicitCoverImageFile
  ? productCoverImages[`/src/assets/products/${explicitCoverImageFile}`]?.default
  : undefined;
const slugCoverImage =
  productCoverImages[`/src/assets/products/${d.slug}.webp`]?.default ??
  productCoverImages[`/src/assets/products/${d.slug}.png`]?.default ??
  productCoverImages[`/src/assets/products/${d.slug}.jpg`]?.default ??
  productCoverImages[`/src/assets/products/${d.slug}.jpeg`]?.default ??
  productCoverImages[`/src/assets/products/${d.slug}.avif`]?.default;
const coverImage = d.coverImage ?? explicitCoverImage ?? slugCoverImage;
---

<Card class="flex h-full flex-col border-border bg-card/70">
  {coverImage && (
    <Image
      src={coverImage}
      alt={`${d.title} product cover`}
      class="block h-auto w-full"
      widths={[360, 540, 720]}
      sizes="(min-width: 768px) 50vw, 100vw"
    />
  )}
  <CardHeader>
    <div class="mb-4 flex flex-wrap gap-2">
      <Badge variant="outline">{d.family}</Badge>
      <Badge variant={d.status === "available" ? "default" : "secondary"}>{statusLabel}</Badge>
    </div>
    <CardTitle class="text-xl">{d.title}</CardTitle>
  </CardHeader>
  <CardContent class="flex-1">
    <p class="leading-7 text-muted-foreground">{d.shortDescription}</p>
    <p class="mt-5 text-sm"><strong>Best for:</strong> <span class="text-muted-foreground">{d.audience}</span></p>
  </CardContent>
  <CardFooter>
    <Button as="a" href={`/products/${d.slug}/`} variant="secondary" data-event="product_view" data-product-slug={d.slug}>See how it works</Button>
  </CardFooter>
</Card>
