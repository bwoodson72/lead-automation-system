---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import BundleOfferCard from "@/components/products/BundleOfferCard.astro";
import { Button } from "@/components/starwind/button";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { getBundleMerchandising } from "@/lib/bundle-merchandising";
import { isPublicBundle, isPublicProduct } from "@/lib/storefront-visibility";

const bundles = (await getCollection("bundles")).filter(isPublicBundle).sort((a, b) => a.data.order - b.data.order);
const products = (await getCollection("products")).filter(isPublicProduct);
const merchandising = bundles.map((bundle) => ({ bundle, merch: getBundleMerchandising(bundle, products) }));
const hasCheckout = merchandising.some(({ merch }) => merch.purchasable);
---

<BaseLayout
  title="Bundles | Developer Business Lab"
  description="Build the whole stage of your freelance business with connected systems and save compared with buying the included products separately when live pricing permits."
  enableCheckoutOverlay={hasCheckout}
>
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="Business system bundles"
    title="Build the whole stage—and pay less than buying the systems one at a time."
    description="When several business problems depend on one another, solve them together. Choose the bundle that matches the part of your freelance business you are building now."
    supportingItems={["Connected systems", "Implementation order included", "Live savings shown when available"]}
  />

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-end">
        <div><p class="editorial-kicker">Choose the scope</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">One stage. One larger outcome. One connected purchase.</h2></div>
        <p class="max-w-2xl text-lg leading-8 text-muted-foreground">A focused guide is right when one bottleneck is clear. A bundle is right when several decisions inside the same stage need to work together and you expect to use more than one of the systems.</p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {bundles.map((bundle) => <BundleOfferCard bundle={bundle} products={products} featured={bundle.data.slug === "freelance-developer-business-system"} location="bundles-index" />)}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="editorial-kicker">The bundle progression</p>
      <h2 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight">Move from foundation to acquisition to sales—or buy the complete freelance system when the scope is broader.</h2>
      <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border lg:grid-cols-4">
        {merchandising.map(({ bundle, merch }) => (
          <a href={`/bundles/${bundle.data.slug}/`} class="group bg-background p-6 transition-colors hover:bg-card/50" data-event="bundle_progression" data-product-slug={bundle.data.slug}>
            <p class="font-mono text-xs text-primary-accent">{merch.step}</p>
            <p class="mt-3 text-xs font-semibold uppercase tracking-[.14em] text-muted-foreground">{merch.stage}</p>
            <h3 class="mt-3 text-lg font-semibold group-hover:text-primary-accent">{bundle.data.title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">{bundle.data.shortDescription ?? bundle.data.outcome}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-px overflow-hidden border border-border bg-border lg:grid-cols-3">
      <div class="bg-background p-7 sm:p-9"><p class="editorial-kicker">Whole business unclear</p><h2 class="mt-4 text-3xl font-semibold tracking-tight">Start with the Launch Kit.</h2><p class="mt-4 leading-7 text-muted-foreground">Use the integrated operating map when you first need to understand how the parts of the freelance business depend on one another.</p><p class="mt-7"><Button as="a" href="/products/freelance-developer-launch-kit/">See the Launch Kit</Button></p></div>
      <div class="bg-background p-7 sm:p-9"><p class="editorial-kicker">One bottleneck</p><h2 class="mt-4 text-3xl font-semibold tracking-tight">Buy the focused guide.</h2><p class="mt-4 leading-7 text-muted-foreground">If one constraint is clearly the problem and the surrounding stage already works, go directly to the specialist system.</p><p class="mt-7"><Button as="a" href="/products/" variant="outline">Browse Focused Systems</Button></p></div>
      <div class="bg-background p-7 sm:p-9"><p class="editorial-kicker">Several connected problems</p><h2 class="mt-4 text-3xl font-semibold tracking-tight">Buy the bundle for that stage.</h2><p class="mt-4 leading-7 text-muted-foreground">Use the larger system when you need multiple connected decisions, want the implementation order, and would otherwise buy several included guides separately.</p><p class="mt-7"><Button as="a" href="/start/" variant="outline">Help Me Choose</Button></p></div>
    </div>
  </section>
</BaseLayout>
