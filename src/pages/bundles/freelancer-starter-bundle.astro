---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import FAQList from "@/components/ui/FAQList.astro";
import { button } from "@/components/starwind/button/variants";
import heroImage from "@/assets/brand/neutral-hero.png";
import { getBundleMerchandising } from "@/lib/bundle-merchandising";
import { isPublicProduct } from "@/lib/storefront-visibility";
import { applyBundleCopyOverride } from "@/lib/copy-overrides";
import { cleanPublicCopyTree } from "@/lib/public-copy-cleaner";

const sourceBundle = (await getCollection("bundles")).find((entry) => entry.data.slug === "freelancer-starter-bundle");
if (!sourceBundle) throw new Error("Freelancer Starter Bundle record not found.");
const products = (await getCollection("products")).filter(isPublicProduct);
const merch = getBundleMerchandising(sourceBundle, products);
const d = cleanPublicCopyTree(applyBundleCopyOverride(sourceBundle.data));
const checkoutClass = button({ class: "lemonsqueezy-button" });

const money = (value?: number) => value === undefined
  ? undefined
  : new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(value);
const bundlePriceLine = merch.bundlePriceFormatted ? `${merch.bundlePriceFormatted}, one-time` : "One-time purchase";
const separateTotal = money(merch.separateValue);
const savingsAmount = money(merch.savings);

const siteUrl = Astro.site?.toString() || "https://developerbusinesslab.com";
const canonical = new URL("/bundles/freelancer-starter-bundle/", siteUrl).toString();
const organizationId = new URL("/#organization", siteUrl).toString();
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Bundles", item: new URL("/bundles/", siteUrl).toString() },
      { "@type": "ListItem", position: 2, name: d.title, item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": `${canonical}#bundle`,
    name: d.title,
    description: d.seo.description,
    url: canonical,
    category: "Business system bundle",
    brand: { "@id": organizationId },
    audience: { "@type": "Audience", audienceType: d.audience },
    ...(merch.purchasable && merch.bundlePrice ? {
      offers: {
        "@type": "Offer",
        url: canonical,
        priceCurrency: "USD",
        price: merch.bundlePrice.toFixed(2),
        availability: "https://schema.org/InStock",
      },
    } : {}),
  },
];

const faqs = [
  { data: { question: "Should I get this or the Launch Kit?", answer: "If several parts of your business need work, including finding clients, sales, and delivery, start with the Launch Kit. If you already know your offer, pricing, and marketing are the problem, this bundle goes much deeper on exactly those." } },
  { data: { question: "Do I have to use them in order?", answer: "It works best in order, since each one builds on the last. But if one area is clearly the most urgent, you can start there." } },
  { data: { question: "What if it isn't right for me?", answer: "Eligible purchases are covered by Developer Business Lab's 14-Day Satisfaction Guarantee. After reviewing the bundle, if you decide it isn't useful for your business, you may request a refund within 14 days of purchase." } },
];
---

<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  enableCheckoutOverlay={merch.purchasable}
  structuredData={structuredData}
>
  <PageHero
    image={heroImage}
    imageAlt="Dark developer workspace at night with warm desk lighting and city lights beyond the window"
    breadcrumbs={[{ label: "Bundles", href: "/bundles/" }, { label: d.title }]}
    eyebrow="Freelancer Starter Bundle"
    title="Know what you sell, what to charge, and why clients should care."
    description="Three systems that fix the foundation of a freelance development business: a clear offer, prices based on real numbers, and marketing that makes buyers understand your value. Each one makes the others work."
    supportingItems={["Includes Productize Your Dev Skills, Web Developer Pricing System, and Marketing for Builders."]}
  >
    <div slot="actions" class="space-y-3">
      <p class="text-lg font-semibold text-white">{bundlePriceLine}</p>
      {savingsAmount && <p class="text-sm text-white/70">Save {savingsAmount} compared to buying separately.</p>}
      {merch.purchasable && merch.checkoutUrl && (
        <a href={merch.checkoutUrl} class={checkoutClass} data-event="checkout_click" data-product-slug={d.slug} data-cta-location="bundle-hero">Get the Starter Bundle</a>
      )}
    </div>
    {merch.image && <div slot="visual" class="min-w-0"><Image src={merch.image} alt="Freelancer Starter Bundle product mockup" class="mx-auto max-h-[30rem] w-full object-contain" widths={[480, 720, 960]} sizes="(min-width: 1024px) 38vw, 90vw" /></div>}
  </PageHero>

  <section class="px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-20">
      <div><h2 class="text-4xl font-semibold tracking-tight">Three problems that are really one problem.</h2></div>
      <div class="space-y-5 text-lg leading-8 text-muted-foreground">
        <p>Your offer changes from client to client. Your prices feel like guesses. And your marketing doesn't give buyers a reason to pay you more than the cheapest bid.</p>
        <p>Those feel like three separate problems. They're not.</p>
        <p>A vague offer is hard to price, because there's nothing stable to attach a price to. A price you can't explain is hard to market. And marketing with no clear offer or price behind it has nothing specific to say. Fix one without the others, and the other two keep dragging it back down.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-4xl font-semibold tracking-tight">One developer, three decisions that fit together</h2>
      <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border lg:grid-cols-3">
        <article class="bg-background p-7">
          <p class="editorial-kicker">The offer</p>
          <p class="mt-4 text-lg leading-8 text-muted-foreground">Instead of “I build custom websites,” he defines one service: fast websites for home service companies that turn local searches into booked jobs, with fixed scope and a four-week launch.</p>
        </article>
        <article class="bg-background p-7">
          <p class="editorial-kicker">The price</p>
          <p class="mt-4 text-lg leading-8 text-muted-foreground">Because the service is defined, he can see the full workload behind it: discovery, content coordination, revisions, launch, and support. He prices it to cover all of it, with milestone payments and a clear line on what counts as extra.</p>
        </article>
        <article class="bg-background p-7">
          <p class="editorial-kicker">The marketing</p>
          <p class="mt-4 text-lg leading-8 text-muted-foreground">Because the offer and price are clear, his message writes itself. He talks to home service owners about booked jobs and phone calls, not frameworks, and shows past projects as proof of that specific result.</p>
        </article>
      </div>
      <p class="mt-8 text-xl font-semibold">Now every part supports the others. The offer makes the price defensible. The price makes the offer feel professional. The marketing makes both easy for a buyer to say yes to.</p>
      <p class="mt-3 text-sm italic text-muted-foreground">Illustrative example.</p>
    </div>
  </section>

  <section class="px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-4xl font-semibold tracking-tight">What's included</h2>
      <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border lg:grid-cols-3">
        <article class="bg-background p-7">
          <h3 class="text-xl font-semibold">Productize Your Dev Skills</h3>
          <p class="mt-3 leading-7 text-muted-foreground">Turn everything you can build into one clear service the right clients understand and buy.</p>
          <a class="mt-5 inline-flex font-semibold text-primary-accent hover:underline" href="/products/productize-your-dev-skills/">Learn more →</a>
        </article>
        <article class="bg-background p-7">
          <h3 class="text-xl font-semibold">Web Developer Pricing System</h3>
          <p class="mt-3 leading-7 text-muted-foreground">Know what a project really costs you and whether it's worth taking, before you quote.</p>
          <a class="mt-5 inline-flex font-semibold text-primary-accent hover:underline" href="/products/web-developer-pricing-system/">Learn more →</a>
        </article>
        <article class="bg-background p-7">
          <h3 class="text-xl font-semibold">Marketing for Builders</h3>
          <p class="mt-3 leading-7 text-muted-foreground">Make buyers understand why your work is worth paying for, without becoming a salesman.</p>
          <a class="mt-5 inline-flex font-semibold text-primary-accent hover:underline" href="/products/marketing-for-builders/">Learn more →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-4xl font-semibold tracking-tight">How to use them together</h2>
      <ol class="mt-8 space-y-5 text-lg leading-8 text-muted-foreground">
        <li><strong class="text-foreground">1. Define what you sell</strong> with Productize Your Dev Skills.</li>
        <li><strong class="text-foreground">2. Price it</strong> with the Web Developer Pricing System, using the offer you just defined.</li>
        <li><strong class="text-foreground">3. Tell buyers about it</strong> with Marketing for Builders, using the offer and price as your foundation.</li>
      </ol>
      <p class="mt-7 text-xl font-semibold">Each system hands its results to the next, so you're never starting from scratch.</p>
    </div>
  </section>

  <section class="px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-4xl font-semibold tracking-tight">What changes</h2>
      <div class="mt-8 space-y-5 text-lg leading-8 text-muted-foreground">
        <p>Every prospect hears the same clear offer, not a new pitch each time.</p>
        <p>Your prices stop drifting down, because you know what they need to cover and can explain why.</p>
        <p>Buyers understand your value before the first call.</p>
        <p>You stop getting compared line by line with the cheapest option.</p>
        <p>And the business finally has a foundation the rest of it can build on.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-4xl font-semibold tracking-tight">Where this fits</h2>
      <div class="mt-8 space-y-6 text-lg leading-8 text-muted-foreground">
        <p><strong class="text-foreground">Want the whole business built at once?</strong> The <a class="font-semibold text-primary-accent hover:underline" href="/products/freelance-developer-launch-kit/">Freelance Developer Launch Kit</a> covers offer, pricing, and marketing at a foundational level, along with finding clients, sales, delivery, and more. The Starter Bundle goes much deeper on these three.</p>
        <p><strong class="text-foreground">Offer and pricing already solid?</strong> If your main problem is finding enough clients, the <a class="font-semibold text-primary-accent hover:underline" href="/bundles/client-acquisition-bundle/">Client Acquisition Bundle</a> may be the better fit.</p>
      </div>
    </div>
  </section>

  <section class="px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-5xl text-center">
      <h2 class="text-4xl font-semibold tracking-tight">The math</h2>
      <p class="mx-auto mt-6 max-w-4xl text-lg leading-8 text-muted-foreground">Bought separately, these three systems cost {separateTotal ?? "their current individual total"}. The bundle is {merch.bundlePriceFormatted ?? "available as one purchase"}.</p>
      <p class="mx-auto mt-5 max-w-4xl text-lg leading-8 text-muted-foreground">And the payoff compounds. A clear offer supports a higher price, a higher price supports stronger marketing, and stronger marketing brings in clients willing to pay it. Raising the price on even one project covers the bundle several times over.</p>
      <p class="mt-8 text-lg font-semibold">{bundlePriceLine}</p>
      {merch.purchasable && merch.checkoutUrl && <div class="mt-5 flex justify-center"><a href={merch.checkoutUrl} class={checkoutClass} data-event="checkout_click" data-product-slug={d.slug} data-cta-location="bundle-value">Get the Starter Bundle</a></div>}
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-4xl font-semibold tracking-tight">Questions</h2>
      <div class="mt-8"><FAQList faqs={faqs.map((faq, index) => ({ data: { ...faq.data, order: index } }))} /></div>
      <p class="mt-5 text-sm text-muted-foreground"><a class="font-semibold text-primary-accent hover:underline" href="/refund-policy/">Read the full refund policy →</a></p>
    </div>
  </section>

  <section class="px-6 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-5xl text-center">
      <h2 class="text-4xl font-semibold tracking-tight sm:text-5xl">Build the foundation everything else stands on.</h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">A clear offer, a price you can defend, and marketing that shows buyers why you're worth it.</p>
      <p class="mt-8 text-lg font-semibold">{bundlePriceLine}</p>
      {merch.purchasable && merch.checkoutUrl && <div class="mt-5 flex justify-center"><a href={merch.checkoutUrl} class={checkoutClass} data-event="checkout_click" data-product-slug={d.slug} data-cta-location="bundle-final">Get the Starter Bundle</a></div>}
    </div>
  </section>
</BaseLayout>
