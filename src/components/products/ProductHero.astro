---
import type { CollectionEntry } from "astro:content";
import ProductHeroPurchaseCard from "@/components/products/ProductHeroPurchaseCard.astro";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  product: CollectionEntry<"products">;
  eyebrow?: string;
  title: string;
  description?: string;
  audience?: string;
  audienceLabel?: string;
  breadcrumbs?: Breadcrumb[];
  ctaLabel?: string;
  supportingText?: string;
  location?: string;
}

const {
  product,
  eyebrow = product.data.title,
  title,
  description,
  audience,
  audienceLabel = "Best for",
  breadcrumbs = [
    { label: "Products", href: "/products/" },
    { label: product.data.title },
  ],
  ctaLabel,
  supportingText,
  location = "hero-card",
} = Astro.props;
---

<section class="relative isolate min-h-[52vh] overflow-hidden border-b border-border bg-background lg:min-h-[58vh]">
  <div class="absolute inset-0 bg-linear-to-br from-background via-card/80 to-background"></div>
  <div class="absolute -right-32 top-1/2 h-[34rem] w-[34rem] -translate-y-1/2 rounded-full bg-primary/18 blur-3xl"></div>
  <div class="absolute right-1/4 top-0 h-72 w-72 -translate-y-1/3 rounded-full bg-primary-accent/8 blur-3xl"></div>
  <div class="absolute inset-y-0 left-0 w-4/5 bg-linear-to-r from-background via-background/95 to-transparent"></div>
  <div class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-primary/35 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-background/70 to-transparent"></div>

  <div class="relative mx-auto grid min-h-[52vh] max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:min-h-[58vh] lg:grid-cols-[1.05fr_.95fr] lg:gap-20 lg:px-8">
    <div class="relative z-10 min-w-0 max-w-3xl">
      {breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/55">
          {breadcrumbs.map((crumb, index) => (
            <span class="contents">
              {crumb.href ? <a href={crumb.href} class="hover:text-white">{crumb.label}</a> : <span>{crumb.label}</span>}
              {index < breadcrumbs.length - 1 && <span aria-hidden="true">/</span>}
            </span>
          ))}
        </nav>
      )}

      {eyebrow && <p class="editorial-kicker">{eyebrow}</p>}
      <h1 class:list={["font-semibold tracking-[-0.04em] text-white text-4xl sm:text-5xl lg:text-6xl", eyebrow ? "mt-5" : "mt-0"]}>
        {title}
      </h1>

      {description && <p class="mt-7 max-w-2xl text-lg leading-8 text-white/70 sm:text-xl">{description}</p>}

      {audience && (
        <div class="mt-7 max-w-2xl border-l border-primary/70 pl-5">
          <p class="text-sm font-semibold uppercase tracking-[.12em] text-white/55">{audienceLabel}</p>
          <p class="mt-2 leading-7 text-white/80">{audience}</p>
        </div>
      )}
    </div>

    <div class="relative z-10 min-w-0 lg:w-full lg:justify-self-end">
      <ProductHeroPurchaseCard
        product={product}
        ctaLabel={ctaLabel}
        supportingText={supportingText}
        location={location}
      />
    </div>
  </div>
</section>
