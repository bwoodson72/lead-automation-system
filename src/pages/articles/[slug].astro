---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";

export async function getStaticPaths() {
  return (await getCollection("articles", ({ data }) => !data.draft)).map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const siteUrl = Astro.site?.toString() || "https://developerbusinesslab.com";
const canonical = new URL(`/articles/${article.id}/`, siteUrl).toString();
const organizationId = new URL("/#organization", siteUrl).toString();

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${canonical}#article`,
    headline: article.data.title,
    description: article.data.description,
    datePublished: article.data.publishedAt.toISOString(),
    ...(article.data.updatedAt ? { dateModified: article.data.updatedAt.toISOString() } : {}),
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    author: {
      "@type": "Person",
      name: "Brian Woodson",
    },
    publisher: { "@id": organizationId },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Articles",
        item: new URL("/articles/", siteUrl).toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: article.data.title,
        item: canonical,
      },
    ],
  },
];
---
<BaseLayout title={`${article.data.title} | Developer Business Lab`} description={article.data.description} structuredData={structuredData}>
  <article class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground"><a href="/articles/" class="hover:text-foreground">Articles</a><span aria-hidden="true"> / </span><span>{article.data.category}</span></nav>
      <p class="mt-10 font-mono text-xs uppercase tracking-widest text-primary-accent">{article.data.category}</p>
      <h1 class="mt-4 text-5xl font-semibold tracking-tight">{article.data.title}</h1>
      <p class="mt-6 text-xl leading-8 text-muted-foreground">{article.data.description}</p>
      <p class="mt-5 text-sm text-muted-foreground">By Brian Woodson · <time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString("en-US", { dateStyle: "long" })}</time></p>
      {headings.length > 2 && <nav aria-label="Table of contents" class="mt-10 rounded-xl border border-border bg-card p-6"><h2 class="font-semibold">On this page</h2><ul class="mt-3 space-y-2">{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`} class="text-sm text-primary-accent hover:text-foreground">{h.text}</a></li>)}</ul></nav>}
      <div class="mt-12 space-y-6 leading-8 text-muted-foreground [&_h2]:pt-8 [&_h2]:text-3xl [&_h2]:font-semibold [&_h2]:text-foreground [&_p]:text-base"><Content /></div>
      <div class="mt-14 rounded-xl border border-primary/20 bg-primary/10 p-7"><h2 class="text-2xl font-semibold">Build the business system behind your development work.</h2><p class="mt-3 text-muted-foreground">Explore practical systems for positioning, pricing, client acquisition, sales, and recurring revenue.</p><div class="mt-6"><Button as="a" href="/products/" data-event="article_to_product_navigation">Explore the systems</Button></div></div>
    </div>
  </article>
</BaseLayout>
