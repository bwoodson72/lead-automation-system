---
import type { CollectionEntry } from "astro:content";
import { Button } from "@/components/starwind/button";
import TextLink from "@/components/ui/TextLink.astro";
import BundlePriceComparison from "@/components/products/BundlePriceComparison.astro";
import { getBundleRecommendation } from "@/lib/bundle-progression";
import { getBundleMerchandising } from "@/lib/bundle-merchandising";

interface Props {
  currentProduct: CollectionEntry<"products">;
  products: CollectionEntry<"products">[];
  bundle?: CollectionEntry<"bundles">;
}

const { currentProduct, products, bundle } = Astro.props;
const recommendation = getBundleRecommendation(currentProduct.data.slug);
const merch = bundle ? getBundleMerchandising(bundle, products) : undefined;
---

{recommendation && bundle && merch && (
  <section class="border-y border-border bg-card/35 px-6 py-10 sm:px-6 sm:py-12 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <article class="grid gap-8 border border-primary/35 bg-background p-7 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:p-9">
        <div class="min-w-0">
          <p class="editorial-kicker">This guide is included in a larger system</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight">Need the rest of this stage working with it?</h2>
          <p class="mt-4 max-w-3xl text-lg leading-8 text-muted-foreground">{recommendation.bridge}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {merch.includedProducts.map((product) => (
              <span class:list={["border px-3 py-1.5 text-xs", product.data.slug === currentProduct.data.slug ? "border-primary/40 text-primary-accent" : "border-border text-muted-foreground"]}>
                {product.data.title}{product.data.slug === currentProduct.data.slug ? " · You’re here" : ""}
              </span>
            ))}
          </div>
        </div>
        <div class="min-w-0 border-t border-border pt-7 lg:border-l lg:border-t-0 lg:pl-9 lg:pt-0">
          <p class="font-mono text-xs uppercase tracking-[.14em] text-primary-accent">{merch.stage}</p>
          <h3 class="mt-3 text-2xl font-semibold">{bundle.data.title}</h3>
          <div class="mt-6"><BundlePriceComparison bundlePriceFormatted={merch.bundlePriceFormatted} separateValue={merch.separateValue} savings={merch.savings} savingsPercent={merch.savingsPercent} /></div>
          <div class="mt-7 flex flex-wrap items-center gap-4">
            <Button as="a" href={`/bundles/${bundle.data.slug}/`} data-event="bundle_upsell" data-product-slug={bundle.data.slug} data-cta-location="product-page">See the Complete Bundle</Button>
            {merch.purchasable && merch.checkoutUrl && <TextLink href={merch.checkoutUrl}>Buy the bundle now →</TextLink>}
          </div>
        </div>
      </article>
    </div>
  </section>
)}
