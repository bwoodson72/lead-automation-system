---
import { button } from "@/components/starwind/button/variants";
import { Button } from "@/components/starwind/button";
import KitForm from "@/components/marketing/KitForm.astro";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";
const { product, location = "product", label, fullWidth = false } = Astro.props;
const d = product.data;
const commerce = resolveProductCommerce(d);
const widthClass = fullWidth ? "w-full max-w-full" : "w-full max-w-full sm:w-auto";
const checkoutClass = button({ class: `lemonsqueezy-button ${widthClass} whitespace-normal break-words px-4 text-center leading-snug sm:px-5` });
const freeLabel = label ?? `Get ${d.title} Free`;
const paidLabel = label ?? `Get ${d.title} for ${commerce.priceFormatted}`;
const parsedPrice = commerce.priceFormatted ? Number(commerce.priceFormatted.replace(/[^0-9.]/g, "")) : d.free ? 0 : undefined;
const analyticsEvent = d.free ? "quickstart_checkout_start" : "begin_checkout";
---
{commerce.purchasable && d.free ? (
  <a
    href={commerce.checkoutUrl!}
    class={checkoutClass}
    data-event="checkout_click"
    data-product-slug={d.slug}
    data-cta-location={location}
    data-ga-event={analyticsEvent}
    data-ga-item-id={d.slug}
    data-ga-item-name={d.title}
    data-ga-item-category={d.family}
    data-ga-price={parsedPrice}
    data-ga-currency="USD"
    data-ga-cta-location={location}
  >
    {freeLabel}
  </a>
) : commerce.effectiveStatus === "available" && d.free ? (
  <Button as="a" href="/free/" class={`${widthClass} whitespace-normal break-words px-4 text-center leading-snug sm:px-5`} data-event="quickstart_view" data-cta-location={location}>{freeLabel}</Button>
) : commerce.purchasable ? (
  <a
    href={commerce.checkoutUrl!}
    class={checkoutClass}
    data-event="checkout_click"
    data-product-slug={d.slug}
    data-cta-location={location}
    data-ga-event={analyticsEvent}
    data-ga-item-id={d.slug}
    data-ga-item-name={d.title}
    data-ga-item-category={d.family}
    data-ga-price={parsedPrice}
    data-ga-currency="USD"
    data-ga-cta-location={location}
  >
    {paidLabel}
  </a>
) : commerce.effectiveStatus === "coming-soon" ? (
  <KitForm kind="updates" productSlug={d.slug} />
) : (
  <p class="rounded-lg border border-border bg-muted px-4 py-3 text-sm text-muted-foreground">This system is planned. There is no purchase or interest form yet.</p>
)}
