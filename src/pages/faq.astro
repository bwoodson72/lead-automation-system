---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import FAQList from "@/components/ui/FAQList.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";

const faqs = (await getCollection("faqs")).sort((a,b) => a.data.order-b.data.order);
---

<BaseLayout title="Product & Catalog FAQ | Developer Business Lab" description="Understand the current Developer Business Lab catalog, how the products differ, which system matches your current bottleneck, and when a bundle makes more sense than a focused product.">
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="Product guide"
    title="Find the system that matches the problem you are actually trying to solve."
    description="The DBL catalog covers different parts of a freelance developer business. These answers explain where the current products start and stop, how the bundles fit together, and when a smaller purchase is the better choice."
  />
  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-4xl"><FAQList faqs={faqs} /></div>
  </section>
</BaseLayout>
