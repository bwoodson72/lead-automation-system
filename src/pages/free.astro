---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCTA from "@/components/products/ProductCTA.astro";
import ProductCover from "@/components/products/ProductCover.astro";

const products = await getCollection("products");
const product = products.find((item) => item.data.slug === "developer-marketing-quickstart");

if (!product) {
  throw new Error("Developer Marketing Quickstart product entry was not found.");
}

const d = product.data;
const enableCheckoutOverlay = d.status === "available" && Boolean(d.checkoutUrl);
---
<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  enableCheckoutOverlay={enableCheckoutOverlay}
>
  <section class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Free starting point</p>
        <h1 class="mt-4 text-5xl font-semibold tracking-tight">{d.title}</h1>
        <p class="mt-6 text-2xl font-semibold text-primary-accent">{d.shortDescription}</p>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">{d.coreOutcome}</p>
        <div class="mt-8">
          <ProductCTA product={product} location="free-page-hero" />
        </div>
        <p class="mt-4 text-sm text-muted-foreground">Free downloadable field guide. Lemon Squeezy handles checkout and delivery.</p>
      </div>
      <ProductCover title={d.title} family="Free Resource" image={d.coverImage} />
    </div>
  </section>

  <section class="border-t border-border bg-card/30 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-3xl font-semibold">The seven-step operating loop</h2>
      <ol class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {d.workflow.map((item, index) => (
          <li class="rounded-lg border border-border bg-card p-5">
            <span class="font-mono text-xs text-primary-accent">STEP {index + 1}</span>
            <p class="mt-2">{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
