---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Button } from "@/components/starwind/button";
import { resolveProductCoverImage } from "@/lib/product-cover-images";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";

interface Props {
  product: CollectionEntry<"products">;
  eyebrow?: string;
  heading?: string;
}

const {
  product,
  eyebrow = "Best place to start",
  heading = "Build the whole freelance business before you chase another isolated tactic.",
} = Astro.props;
const d = product.data;
const commerce = resolveProductCommerce(d);
const cover = resolveProductCoverImage(d, commerce.purchasable ? commerce.product?.id : undefined);
const price = commerce.priceFormatted ?? (d.price ? `$${d.price.toFixed(0)}` : undefined);
---

<article class="relative overflow-hidden border border-primary/30 bg-card/35">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(212,138,23,.13),transparent_30rem)]"></div>
  <div class="relative grid gap-10 p-7 sm:p-10 lg:grid-cols-[1.2fr_.8fr] lg:items-center lg:gap-16 lg:p-12">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-3">
        <p class="editorial-kicker">{eyebrow}</p>
        <span class="border border-primary/35 px-2.5 py-1 text-[.65rem] font-semibold uppercase tracking-[.14em] text-primary-accent">Flagship system</span>
      </div>
      <h2 class="mt-5 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">{heading}</h2>
      <p class="mt-5 text-sm font-semibold text-primary-accent">{d.title}</p>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-muted-foreground">{d.shortDescription}</p>

      <div class="mt-8 grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-3">
        {d.capabilities.slice(0, 3).map((capability) => (
          <div class="bg-background p-5">
            <span class="text-primary-accent" aria-hidden="true">✓</span>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{capability}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button as="a" href={`/products/${d.slug}/`} size="lg">Start with the Launch Kit</Button>
        {price && <span class="text-sm font-semibold text-muted-foreground">{price} one-time</span>}
      </div>
      <p class="mt-5 max-w-2xl text-sm leading-6 text-muted-foreground">Already know exactly what is broken? Skip the broad system and use a focused guide for that bottleneck instead.</p>
    </div>

    <div class="flex justify-center lg:justify-end">
      {cover ? (
        <Image
          src={cover}
          alt={`${d.title} cover`}
          class="h-auto w-full max-w-sm object-contain drop-shadow-[0_26px_45px_rgba(0,0,0,.48)]"
          widths={[360, 520, 720]}
          sizes="(min-width: 1024px) 24rem, 80vw"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="relative flex aspect-4/5 w-full max-w-sm flex-col overflow-hidden border border-primary/30 bg-[#0b0c0a] p-8">
          <div class="absolute inset-x-0 top-0 h-1 bg-primary"></div>
          <p class="font-mono text-xs font-semibold uppercase tracking-[.16em] text-primary-accent">Developer Business Lab</p>
          <div class="my-auto">
            <p class="text-xs font-semibold uppercase tracking-[.16em] text-white/45">Flagship system</p>
            <p class="mt-4 text-4xl font-semibold tracking-tight text-white">{d.title}</p>
          </div>
        </div>
      )}
    </div>
  </div>
</article>
