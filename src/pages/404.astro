---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
---

<BaseLayout title="Page Not Found | Developer Business Lab" description="The requested page could not be found." noindex={true}>
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="404 · Not found"
    title="This path does not lead anywhere useful."
    description="The page may have moved. The business problem you came here to solve probably has not."
    primaryCta={{ label: "Find Your Bottleneck", href: "/start/" }}
    secondaryCta={{ label: "Browse Products", href: "/products/" }}
  />
</BaseLayout>
