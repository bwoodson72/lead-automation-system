---
interface Props { steps?: string[]; }
const { steps = ["Discover", "Verify", "Analyze", "Qualify", "Contact", "Outreach", "Follow up", "Track"] } = Astro.props;
---
<ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
  {steps.map((step, index) => <li class="relative rounded-xl border border-border bg-card px-4 py-4"><span class="font-mono text-xs text-primary-accent">{String(index + 1).padStart(2, "0")}</span><p class="mt-2 font-semibold">{step}</p></li>)}
</ol>
