---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCard from "@/components/products/ProductCard.astro";

const tiers = (await getCollection("products", ({ data }) => data.family === "AI Prospecting"))
  .sort((a, b) => (a.data.tier || 0) - (b.data.tier || 0));
---

<BaseLayout
  title="AI Prospecting System | Compare Four Automation Tiers"
  description="Keep prospecting moving without automating bad decisions. Choose the AI prospecting tier that matches the process you have already proven."
>
  <section class="border-b border-border px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">AI Prospecting System</p>
      <h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight">Do not automate a prospecting process you do not trust yet.</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">The point is not to build the most impressive automation. It is to keep qualified prospecting moving while client work gets busy, without making weak research, fake personalization, duplicate outreach, or bad follow-up happen faster.</p>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">The expensive mistake</p>
      <h2 class="mt-3 text-3xl font-semibold">Automation multiplies whatever you give it</h2>
      <div class="mt-5 space-y-5 text-lg leading-8 text-muted-foreground">
        <p>When prospecting is manual, a bad assumption wastes one email. When the same assumption is automated, it can waste a batch, damage sender reputation, annoy good prospects, and fill your tracker with activity that was never worth creating.</p>
        <p>That is why the four tiers are not a ladder you are supposed to climb. Start with human-controlled work while you learn which businesses qualify, which website evidence is trustworthy, which messages deserve to be sent, and what should make the sequence stop.</p>
        <p>Once those decisions become boring and repeatable, automate the repetition. Scheduling removes memory work. n8n removes tool-to-tool handoffs. Application architecture becomes useful only when workflow state, concurrency, recovery, testing, and auditability have become real operating problems.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/30 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-3xl font-semibold">Use the lowest tier that gives you back meaningful time</h2>
      <div class="mt-9 overflow-x-auto rounded-xl border border-border">
        <table class="w-full min-w-4xl border-collapse text-left text-sm">
          <caption class="sr-only">Comparison of AI Prospecting tiers</caption>
          <thead class="bg-card">
            <tr><th class="p-4">Tier</th><th class="p-4">Automation</th><th class="p-4">Technical level</th><th class="p-4">State and supervision</th><th class="p-4">Use it when</th></tr>
          </thead>
          <tbody>
            {tiers.map((tier) => (
              <tr class="border-t border-border align-top">
                <th class="p-4"><a href={`/products/${tier.data.slug}/`} class="text-primary-accent">Tier {tier.data.tier}: {tier.data.title}</a></th>
                <td class="p-4 text-muted-foreground">{tier.data.automationLevel}</td>
                <td class="p-4 text-muted-foreground">{tier.data.technicalLevel}<p class="mt-2">{tier.data.tools.join(", ")}</p></td>
                <td class="p-4 text-muted-foreground">{tier.data.stateModel}<p class="mt-2">{tier.data.supervision}</p></td>
                <td class="p-4 text-muted-foreground">{tier.data.whoItsFor[0]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-3xl font-semibold">Choose the burden you are ready to remove</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {tiers.map((tier) => (
          <ProductCard
            product={tier}
            eventName="family_navigation"
            ctaLabel={`See Tier ${tier.data.tier}`}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
