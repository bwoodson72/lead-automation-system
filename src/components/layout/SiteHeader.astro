---
import { siteConfig } from "@/config";
import Logo from "./Logo.astro";
import AnnouncementBanner from "./AnnouncementBanner.astro";
import { Button } from "@/components/starwind/button";
const pathname = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-border/80 bg-background/88 backdrop-blur-xl supports-[backdrop-filter]:bg-background/72">
  <AnnouncementBanner message="Launch special: Save 20% through September 17 with code LAUNCH20." />
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3.5 sm:px-6 lg:px-8">
    <Logo />
    <nav aria-label="Primary" class="hidden items-center gap-7 lg:flex">
      {siteConfig.navigation.map((item) => (
        <a
          href={item.href}
          aria-current={pathname === item.href ? "page" : undefined}
          class="relative py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-primary-accent after:transition-transform hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
        >{item.label}</a>
      ))}
    </nav>
    <div class="hidden lg:block"><Button as="a" href="/free/">Get the Free Quickstart</Button></div>
    <details class="lg:hidden">
      <summary class="cursor-pointer list-none border border-border bg-secondary/80 px-4 py-2 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline">Menu</summary>
      <nav aria-label="Mobile" class="fixed inset-x-0 top-[105px] z-50 flex h-[calc(100dvh-105px)] flex-col overflow-y-auto border-t border-border bg-background px-6 py-6 shadow-2xl sm:px-8">
        <div class="mx-auto flex w-full max-w-7xl flex-col">
          {siteConfig.navigation.map((item) => (
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
              class="border-b border-border px-1 py-5 text-lg font-medium text-foreground transition-colors hover:text-primary-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline aria-[current=page]:text-primary-accent"
            >{item.label}</a>
          ))}
          <Button as="a" href="/free/" size="lg" class="mt-8 w-full">Get the Free Quickstart</Button>
        </div>
      </nav>
    </details>
  </div>
</header>
