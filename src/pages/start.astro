---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/starwind/card";
const service = [["Do you know exactly what you sell?","No","Productize Your Dev Skills","/products/productize-your-dev-skills/"],["Do you have a reliable way to find opportunities?","No","Client Acquisition Without Upwork","/products/client-acquisition-without-upwork/"],["Do you need prospecting automation?","Yes","AI Prospecting System","/products/ai-prospecting-system/"],["Are conversations turning into projects?","No","Developer Sales Playbook","/products/developer-sales-playbook/"],["Do you need legitimate recurring revenue?","Yes","Freelancer Retainer System","/products/freelancer-retainer-system/"]];
const saas = [["Have you validated the problem?","No","SaaS Validation Before You Build","/products/saas-validation-before-you-build/"],["Have you launched?","No","Micro-SaaS Launch System","/products/micro-saas-launch-system/"],["Do you have early paying customers?","No","The First 10 SaaS Customers","/products/the-first-10-saas-customers/"],["Do you need repeatable acquisition?","Yes","Marketing for Builders","/products/marketing-for-builders/"]];
---
<BaseLayout title="Start Here | Prospect Foundry" description="Identify your current commercial bottleneck and find the next practical system to build."><section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Start here</p><h1 class="mt-4 max-w-4xl text-5xl font-semibold">What business problem should you solve next?</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">Choose the path closest to your business. This is guidance, not a prerequisite ladder: skip directly to the bottleneck you actually have.</p><div class="mt-12 grid gap-7 lg:grid-cols-2">{[["I sell development services",service],["I am building software or SaaS",saas]].map(([title,items]) => <Card><CardHeader><CardTitle class="text-2xl">{title}</CardTitle></CardHeader><CardContent><ol class="space-y-4">{(items as string[][]).map(([question,answer,product,href],index)=><li class="rounded-xl border border-border bg-background p-5"><p class="font-mono text-xs text-primary-accent">STEP {index+1}</p><p class="mt-2 font-semibold">{question}</p><p class="mt-3 text-sm text-muted-foreground">If {answer.toLowerCase()}: <a href={href} class="font-semibold text-primary-accent" data-event="start_here_choice">{product} →</a></p></li>)}</ol></CardContent></Card>)}</div></div></section></BaseLayout>
