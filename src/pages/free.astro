---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCTA from "@/components/products/ProductCTA.astro";
import ProductCover from "@/components/products/ProductCover.astro";
import FAQList from "@/components/ui/FAQList.astro";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";

const products = await getCollection("products");
const product = products.find((item) => item.data.slug === "developer-marketing-quickstart");
if (!product) throw new Error("Developer Marketing Quickstart product entry was not found.");
const d = product.data;
const commerce = resolveProductCommerce(d);
const paragraphs = (d.reframe ?? d.situation).split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const proofParagraphs = d.proof ? d.proof.body.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];
---

<BaseLayout title={d.seo.title} description={d.seo.description} enableCheckoutOverlay={commerce.purchasable}>
  <section class="relative overflow-hidden border-b border-border px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_20%,rgba(212,138,23,.09),transparent_32rem)]"></div>
    <div class="relative mx-auto grid max-w-7xl gap-14 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:gap-20">
      <div>
        <p class="editorial-kicker">Free · Developer Marketing Quickstart</p>
        <h1 class="mt-5 text-5xl font-semibold tracking-[-0.04em] sm:text-6xl">{d.hook}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">{d.shortDescription}</p>
        <div class="mt-7 border-l border-primary/70 pl-5"><p class="text-sm font-semibold uppercase tracking-[.12em] text-muted-foreground">Best for</p><p class="mt-2 leading-7">{d.audience}</p></div>
        <div class="mt-8"><ProductCTA product={product} location="free-page-hero" /></div>
        <p class="mt-4 text-sm text-muted-foreground">Free downloadable field guide · Seven days · One real acquisition test</p>
      </div>
      <div class="gold-glow"><ProductCover product={product} /></div>
    </div>
  </section>

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-20">
      <div><p class="editorial-kicker">The cycle you already know</p><h2 class="mt-4 text-3xl font-semibold">The worst time to build a pipeline is when you already need one.</h2></div>
      <div class="space-y-5 text-lg leading-8 text-muted-foreground">{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="editorial-kicker">Inside the guide</p>
      <div class="mt-4 grid gap-8 lg:grid-cols-[1fr_.55fr] lg:gap-16">
        <div><h2 class="text-4xl font-semibold tracking-tight">Build the first system before you chase another tactic.</h2><ol class="mt-8 border-t border-border">{d.contents.map((item, index) => <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-border py-5"><span class="font-mono text-xs text-primary-accent">{String(index + 1).padStart(2, "0")}</span><span>{item}</span></li>)}</ol></div>
        {d.delivery && <aside class="surface-editorial self-start p-7"><p class="editorial-kicker">What you receive</p><dl class="mt-6 space-y-6"><div><dt class="font-semibold">Guide depth</dt><dd class="mt-2 text-sm leading-6 text-muted-foreground">{d.delivery.length}</dd></div><div><dt class="font-semibold">Working tools</dt><dd class="mt-2 text-sm leading-6 text-muted-foreground">{d.delivery.worksheets}</dd></div><div><dt class="font-semibold">How to use it</dt><dd class="mt-2 text-sm leading-6 text-muted-foreground">{d.delivery.time}</dd></div></dl></aside>}
      </div>
    </div>
  </section>

  {d.proof && <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto max-w-5xl"><p class="editorial-kicker">See what changes</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">{d.proof.title}</h2><div class="mt-6 space-y-5 text-lg leading-8 text-muted-foreground">{proofParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div><div class="mt-9 grid gap-px overflow-hidden border border-border bg-border md:grid-cols-2"><div class="bg-background p-7"><p class="editorial-kicker text-muted-foreground">Before</p><p class="mt-3 text-lg">{d.proof.before}</p></div><div class="bg-background p-7"><p class="editorial-kicker">After</p><p class="mt-3 text-lg">{d.proof.after}</p></div></div></div></section>}

  <section class="border-t border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <p class="editorial-kicker">Before you download it</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Questions worth answering first.</h2><div class="mt-8"><FAQList faqs={d.faqs.map((faq, index) => ({ data: { ...faq, order: index } }))} /></div>
      <div class="mt-14 border-t border-border pt-12"><p class="editorial-kicker">Start free</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Stop waiting for the pipeline to become an emergency.</h2><p class="mt-5 text-lg leading-8 text-muted-foreground">Replace “I need clients” with one buyer, one offer, one channel, 25 real prospects, and a result you can learn from.</p><div class="mt-8"><ProductCTA product={product} location="free-page-final" /></div></div>
    </div>
  </section>
</BaseLayout>
