---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import FlagshipProductFeature from "@/components/products/FlagshipProductFeature.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { isPublicProduct } from "@/lib/storefront-visibility";
import { applyProductCopyOverride } from "@/lib/copy-overrides";

const products = (await getCollection("products")).filter(isPublicProduct).sort((a, b) => a.data.order - b.data.order);
const launchKit = products.find((product) => product.data.slug === "freelance-developer-launch-kit");
const groups = [
  {
    title: "Make the work easier to buy and worth taking",
    description: "Start here when the commercial foundation under your technical skill is weak.",
    slugs: ["productize-your-dev-skills", "web-developer-pricing-system", "marketing-for-builders"],
  },
  {
    title: "Create more qualified opportunity",
    description: "Use these when future work is too dependent on luck, one source, or activity that is not reaching the pipeline.",
    slugs: ["client-acquisition-without-upwork", "social-media-client-acquisition-system", "agency-partnership-playbook"],
  },
  {
    title: "Turn serious opportunity into paid work",
    description: "Use these when good buyer interest exists but value is being lost between conversation, commitment, payment, and project start.",
    slugs: ["developer-sales-playbook", "developer-proposal-closing-kit"],
  },
  {
    title: "Keep useful client value working after delivery",
    description: "Use this when a successful client relationship contains a genuine continuing need worth structuring commercially.",
    slugs: ["freelancer-retainer-system"],
  },
];

const productBySlug = (slug: string) => products.find((product) => product.data.slug === slug);
---

<BaseLayout title="Freelance Developer Business Systems | Developer Business Lab" description="Choose the Developer Business Lab system that matches the commercial problem you want to improve: offer, pricing, marketing, acquisition, sales, closing, agency partnerships, or recurring revenue.">
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="Developer Business Lab products"
    title="Choose the part of your freelance business you want to make stronger."
    description="Start with the business condition that is limiting income, opportunity, margin, continuity, or the way you want to work. Use one focused system when one problem is clearly the problem."
    primaryCta={{ label: "Help Me Choose", href: "/start/" }}
    secondaryCta={{ label: "Compare Bundles", href: "/bundles/" }}
    supportingItems={["Focused commercial systems", "Guide + workbook products", "Whole-business foundation available"]}
  />

  {launchKit && (
    <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 max-w-3xl"><p class="editorial-kicker">When several parts need to work together</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Build the first complete operating foundation.</h2><p class="mt-5 text-lg leading-8 text-muted-foreground">The Launch Kit is the broad standalone starting point when offer, pricing, buyer access, sales, delivery, cash, capacity, future demand, and management decisions are still interacting without one coherent operating structure.</p></div>
        <FlagshipProductFeature product={{ ...launchKit, data: applyProductCopyOverride(launchKit.data) }} eyebrow="Whole-business foundation" heading="Build the first complete version of the freelance business around your technical skills." />
      </div>
    </section>
  )}

  {groups.map((group, index) => (
    <section class={index % 2 === 0 ? "border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8" : "px-4 py-18 sm:px-6 sm:py-24 lg:px-8"}>
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end"><div><p class="editorial-kicker">Choose by outcome</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">{group.title}</h2></div><p class="max-w-2xl text-lg leading-8 text-muted-foreground">{group.description}</p></div>
        <div class="mt-10 grid gap-px overflow-hidden border border-border bg-border md:grid-cols-2">
          {group.slugs.map((slug) => {
            const product = productBySlug(slug);
            if (!product) return null;
            const data = applyProductCopyOverride(product.data);
            return <a href={`/products/${data.slug}/`} class="group bg-background p-7 transition-colors hover:bg-card/50"><p class="editorial-kicker">{data.family}</p><h3 class="mt-3 text-2xl font-semibold group-hover:text-primary-accent">{data.title}</h3><p class="mt-4 leading-7 text-muted-foreground">{data.shortDescription}</p><p class="mt-5 text-sm font-semibold text-primary-accent">Explore {data.title} →</p></a>;
          })}
        </div>
      </div>
    </section>
  ))}

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.75fr_1.25fr] lg:gap-20"><div><p class="editorial-kicker">When one problem is really several</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Use a bundle when several connected decisions need to improve together.</h2></div><div class="space-y-5 text-lg leading-8 text-muted-foreground"><p>The bundles group products by a shared business condition: commercial foundation, client acquisition, sales and closing, or the broader freelance business.</p><p><a class="font-semibold text-primary-accent hover:underline" href="/bundles/">Compare the current bundles →</a></p></div></div></section>
</BaseLayout>
