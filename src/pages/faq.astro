---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FAQList from "@/components/ui/FAQList.astro";
const faqs = (await getCollection("faqs")).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout title="Frequently Asked Questions | Prospect Foundry" description="Answers about Prospect Foundry products, availability, tools, technical requirements, delivery, and results."><section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-4xl"><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Product questions</p><h1 class="mt-4 text-5xl font-semibold tracking-tight">Frequently Asked Questions</h1><p class="mt-6 text-lg text-muted-foreground">Clear answers about the implementation systems, their status, technical requirements, and the AI Prospecting family.</p><div class="mt-12"><FAQList faqs={faqs} /></div></div></section></BaseLayout>
