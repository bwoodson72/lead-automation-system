---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import ArticleSidebar from "@/components/articles/ArticleSidebar.astro";
import ArticlePagination from "@/components/articles/ArticlePagination.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { ARTICLES_PER_PAGE, getTopicLinks, sortArticles } from "@/lib/articleTopics";

export async function getStaticPaths() {
  const allArticles = sortArticles(await getCollection("articles", ({ data }) => !data.draft));
  const totalPages = Math.ceil(allArticles.length / ARTICLES_PER_PAGE);
  const topics = getTopicLinks(allArticles);

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * ARTICLES_PER_PAGE;

    return {
      params: { page: String(currentPage) },
      props: {
        articles: allArticles.slice(start, start + ARTICLES_PER_PAGE),
        currentPage,
        totalPages,
        totalArticles: allArticles.length,
        topics,
      },
    };
  });
}

const { articles, currentPage, totalPages, totalArticles, topics } = Astro.props;
---

<BaseLayout
  title={`Freelance Developer Business Articles — Page ${currentPage}`}
  description="Practical articles for freelance developers about client acquisition, pricing, positioning, sales, delivery, retention, and business systems."
>
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="Educational articles"
    title="Freelance Developer Business Articles"
    description="Practical guidance for finding clients, pricing work, selling projects, managing delivery, and building a more repeatable freelance development business."
  />

  <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-10 lg:grid-cols-4 lg:items-start">
        <main class="lg:col-span-3">
          <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Article library</p>
              <h2 class="mt-2 text-3xl font-semibold text-foreground">Latest articles</h2>
            </div>
            <p class="text-sm text-muted-foreground">Page {currentPage} of {totalPages} · {totalArticles} articles</p>
          </div>

          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {articles.map((article) => <ArticleCard article={article} />)}
          </div>

          <ArticlePagination currentPage={currentPage} totalPages={totalPages} />
        </main>

        <ArticleSidebar topics={topics} showQuickstart />
      </div>
    </div>
  </section>
</BaseLayout>
