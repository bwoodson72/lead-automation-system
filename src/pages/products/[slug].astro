---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import ProductCTA from "@/components/products/ProductCTA.astro";
export async function getStaticPaths() { return (await getCollection("products")).map((product) => ({ params: { slug: product.data.slug }, props: { product } })); }
const { product } = Astro.props;
const { Content } = await render(product);
const d = product.data;
const prev = d.tier > 1 ? (await getCollection("products")).find((p) => p.data.tier === d.tier - 1) : undefined;
const next = d.tier < 4 ? (await getCollection("products")).find((p) => p.data.tier === d.tier + 1) : undefined;
---
<BaseLayout title={`${d.title} for Web Developers | Lead Automation System`} description={d.description}>
  <section class="border-b border-border px-4 py-16 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><nav aria-label="Breadcrumb" class="text-sm text-muted-foreground"><a href="/products/" class="hover:text-foreground">Products</a><span aria-hidden="true"> / </span><span>{d.title}</span></nav><div class="mt-10 grid gap-12 lg:grid-cols-2"><div><Badge variant="outline">Tier {d.tier} · {d.automationLevel}</Badge><h1 class="mt-5 text-5xl font-semibold tracking-tight">{d.title}</h1><p class="mt-5 text-2xl font-semibold text-primary-accent">{d.benefitHeadline}</p><p class="mt-5 text-lg leading-8 text-muted-foreground">{d.benefitDescription}</p><p class="mt-6 border-l-2 border-primary pl-4 text-muted-foreground"><strong class="text-foreground">Best for:</strong> {d.audience}</p><div class="mt-8"><ProductCTA product={product} location="hero" /></div></div><div class="rounded-2xl border border-primary/20 bg-card p-8"><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">What changes for you</p><ul class="mt-6 space-y-4">{d.benefitBullets.map((item) => <li class="flex gap-3"><span aria-hidden="true" class="text-success">✓</span><span>{item}</span></li>)}</ul></div></div></div></section>
  <section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-3"><div class="lg:col-span-2"><h2 class="text-3xl font-semibold">What you will build</h2><p class="mt-4 text-lg leading-8 text-muted-foreground">{d.description}</p><ul class="mt-6 grid gap-3 sm:grid-cols-2">{d.whatYouBuild.map((item) => <li class="rounded-lg border border-border bg-card px-4 py-3 text-sm">{item}</li>)}</ul><h2 class="mt-12 text-3xl font-semibold">{d.promise}</h2><div class="mt-6 leading-8 text-muted-foreground"><Content /></div><h2 class="mt-12 text-2xl font-semibold">What the guide covers</h2><ul class="mt-6 grid gap-3 sm:grid-cols-2">{d.topics.map((topic) => <li class="rounded-lg border border-border bg-card px-4 py-3 text-sm">{topic}</li>)}</ul><h2 class="mt-12 text-2xl font-semibold">Outcomes</h2><ul class="mt-6 space-y-3">{d.outcomes.map((item) => <li class="flex gap-3 text-muted-foreground"><span class="text-success">✓</span>{item}</li>)}</ul><h2 class="mt-12 text-2xl font-semibold">Deliberate limitations</h2><ul class="mt-6 space-y-3">{d.limitations.map((item) => <li class="flex gap-3 text-muted-foreground"><span class="text-error">×</span>{item}</li>)}</ul></div><aside><div class="rounded-xl border border-border bg-card p-6"><h2 class="font-semibold">Technical profile</h2><dl class="mt-5 space-y-4 text-sm"><div><dt class="text-muted-foreground">Automation</dt><dd class="mt-1">{d.automationLevel}</dd></div><div><dt class="text-muted-foreground">Technical level</dt><dd class="mt-1">{d.technicalLevel}</dd></div></dl><h3 class="mt-7 font-semibold">Tools</h3><ul class="mt-3 flex flex-wrap gap-2">{d.tools.map((tool) => <li class="rounded-full bg-muted px-3 py-1 text-xs">{tool}</li>)}</ul><h3 class="mt-7 font-semibold">Prerequisites</h3><ul class="mt-3 space-y-2 text-sm text-muted-foreground">{d.prerequisites.map((item) => <li>• {item}</li>)}</ul></div></aside></div></section>
  <section class="border-y border-border bg-card/30 px-4 py-16 sm:px-6 lg:px-8"><div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-2"><div><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Why this level of ownership</p><h2 class="mt-3 text-3xl font-semibold">{d.ownershipHeadline}</h2><p class="mt-4 leading-7 text-muted-foreground">{d.ownershipDescription}</p></div><div><h2 class="text-3xl font-semibold">Choose the appropriate level.</h2><div class="mt-8 flex flex-wrap gap-3">{prev && <Button as="a" href={`/products/${prev.data.slug}/`} variant="outline">← Tier {prev.data.tier}: {prev.data.shortTitle}</Button>}{next && <Button as="a" href={`/products/${next.data.slug}/`} variant="outline">Tier {next.data.tier}: {next.data.shortTitle} →</Button>}<Button as="a" href="/compare/" variant="secondary">Compare all tiers</Button></div></div></div></section>
</BaseLayout>
