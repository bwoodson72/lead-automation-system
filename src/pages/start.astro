---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/starwind/card";

const service = [
  ["I can do the work, but I still cannot explain one clear service I sell.", "Productize Your Dev Skills", "/products/productize-your-dev-skills/"],
  ["I know what I sell, but every quote still feels like a guess.", "Web Developer Pricing System", "/products/web-developer-pricing-system/"],
  ["I am tired of marketplaces, referrals, and restarting the pipeline when work slows down.", "Client Acquisition Without Upwork", "/products/client-acquisition-without-upwork/"],
  ["My work is stronger than the way my website, portfolio, and marketing explain it.", "Marketing for Builders", "/products/marketing-for-builders/"],
  ["My manual prospecting works, but the repeated research and follow-up are becoming the bottleneck.", "AI Prospecting System", "/products/ai-prospecting-system/"],
  ["I get prospects into conversations, but too many calls end without a clear decision.", "Developer Sales Playbook", "/products/developer-sales-playbook/"],
  ["I reach the proposal stage, but scope, revisions, price, or closing still get messy.", "Developer Proposal & Closing Kit", "/products/developer-proposal-closing-kit/"],
  ["I want repeat work from agencies without becoming cheap overflow labor.", "Agency Partnership Playbook", "/products/agency-partnership-playbook/"],
  ["Good projects end, then revenue drops back to zero because nothing continues.", "Freelancer Retainer System", "/products/freelancer-retainer-system/"],
];

const saas = [
  ["I have a SaaS idea, but I do not have enough evidence to justify building it yet.", "SaaS Validation Before You Build", "/products/saas-validation-before-you-build/"],
  ["I have validated demand, but I need to turn it into a bounded MVP and real launch.", "Micro-SaaS Launch System", "/products/micro-saas-launch-system/"],
  ["The product is live, but I still do not know how to get and learn from the first paying customers.", "The First 10 SaaS Customers", "/products/the-first-10-saas-customers/"],
];
---

<BaseLayout
  title="Start Here | Developer Business Lab"
  description="Choose the business problem that sounds most like your current bottleneck and go directly to the system built for it."
>
  <section class="px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Start here</p>
      <h1 class="mt-4 max-w-5xl text-5xl font-semibold tracking-tight">Do not start with the product catalog. Start with the sentence that sounds like your week.</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">You do not need a business curriculum. Pick the bottleneck that is creating the most friction now. If two are true, start with the one that has to be solved before the other can work.</p>

      <div class="mt-12 grid gap-7 lg:grid-cols-2">
        {[["I sell development services", service], ["I am building software or SaaS", saas]].map(([title, items]) => (
          <Card>
            <CardHeader><CardTitle class="text-2xl">{title}</CardTitle></CardHeader>
            <CardContent>
              <ol class="space-y-4">
                {(items as string[][]).map(([problem, product, href], index) => (
                  <li class="rounded-xl border border-border bg-background p-5">
                    <p class="font-mono text-xs text-primary-accent">{String(index + 1).padStart(2, "0")}</p>
                    <p class="mt-2 font-semibold">{problem}</p>
                    <p class="mt-3 text-sm"><a href={href} class="font-semibold text-primary-accent" data-event="start_here_choice">Go to {product} →</a></p>
                  </li>
                ))}
              </ol>
            </CardContent>
          </Card>
        ))}
      </div>

      <div class="mt-12 max-w-4xl rounded-xl border border-border bg-card p-6">
        <h2 class="text-xl font-semibold">If the answer is still “I just need clients”</h2>
        <p class="mt-3 leading-7 text-muted-foreground">Start with the free Developer Marketing Quickstart. It will force the problem into a buyer, offer, message, channel, first prospect list, and measurement loop before you spend money on a deeper system.</p>
        <p class="mt-5"><a href="/free/" class="font-semibold text-primary-accent">Get Developer Marketing Quickstart Free →</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
