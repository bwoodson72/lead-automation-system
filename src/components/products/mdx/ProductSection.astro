---
interface Props {
  eyebrow?: string;
  title?: string;
  tone?: "default" | "muted";
}

const { eyebrow, title, tone = "default" } = Astro.props;
const sectionClass = tone === "muted"
  ? "border-y border-border bg-card/30 px-4 py-20 sm:px-6 lg:px-8"
  : "px-4 py-20 sm:px-6 lg:px-8";
---

<section class={sectionClass}>
  <div class="mx-auto max-w-5xl">
    {eyebrow && <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">{eyebrow}</p>}
    {title && <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>}
    <div class="mt-7 space-y-5 text-lg leading-8 text-muted-foreground [&_strong]:text-foreground [&_a]:text-primary-accent [&_a]:underline-offset-4 hover:[&_a]:underline [&_ul]:space-y-3 [&_ol]:space-y-3 [&_li]:pl-1">
      <slot />
    </div>
  </div>
</section>
