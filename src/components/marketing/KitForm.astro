---
import { siteConfig } from "@/config";
import { Button } from "@/components/starwind/button";
interface Props { kind: "quickstart" | "updates"; productSlug?: string; }
const { kind, productSlug } = Astro.props;
const uid = kind === "quickstart" ? siteConfig.kit.quickstartFormUid : siteConfig.kit.updatesFormUid;
const label = kind === "quickstart" ? "Get the Free Quickstart" : "Get release updates";
---
<div class="rounded-xl border border-border bg-card p-6" data-form-kind={kind} data-product-slug={productSlug}>
  {uid ? (
    <>
      <script is:inline src={`https://f.convertkit.com/${uid}.js`} async></script>
      <p class="mt-4 text-xs leading-5 text-muted-foreground">By subscribing, you agree to receive the requested resource or release update plus relevant Developer Business Lab emails. Unsubscribe at any time. See the <a class="underline hover:text-foreground" href="/privacy/">privacy policy</a>.</p>
      <noscript><p class="mt-4 text-sm text-warning">JavaScript is required for the Kit form. Please contact us through the details in the privacy policy.</p></noscript>
    </>
  ) : (
    <div>
      <p class="font-semibold">{label} is not available yet.</p>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">We will not collect your email until there is something ready to deliver or a real release update to send.</p>
      <Button as="a" href="/products/" variant="outline" class="mt-4">See what is available now</Button>
    </div>
  )}
</div>
