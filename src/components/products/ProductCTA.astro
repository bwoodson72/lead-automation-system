---
import { Button } from "@/components/starwind/button";
const { product, location = "product" } = Astro.props;
const { checkoutUrl, price, title, tier, slug } = product.data;
---
{checkoutUrl && price ? (
  <Button as="a" href={checkoutUrl} target="_blank" rel="noopener noreferrer" data-event="checkout_click" data-product-slug={slug} data-tier={tier} data-cta-location={location}>
    Buy {title} — ${price}
  </Button>
) : (
  <p class="rounded-lg border border-warning/30 bg-warning/10 px-4 py-3 text-sm text-warning">Purchasing will be available when pricing and checkout are configured.</p>
)}
