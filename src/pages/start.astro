---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import { Button } from "@/components/starwind/button";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";

const service = [
  ["01", "Offer", "Every prospect asks what I do, and I still answer with a list of technologies or whatever they happen to need.", "Productize Your Dev Skills", "/products/productize-your-dev-skills/"],
  ["02", "Pricing", "I can build the project, but I still feel uncertain when the client asks what it will cost.", "Web Developer Pricing System", "/products/web-developer-pricing-system/"],
  ["03", "Pipeline", "I get busy, stop prospecting, then reach the end of the project with an empty pipeline.", "Client Acquisition Without Upwork", "/products/client-acquisition-without-upwork/"],
  ["04", "Marketing", "I know my work is stronger than the way my website, portfolio, and marketing make me look.", "Marketing for Builders", "/products/marketing-for-builders/"],
  ["05", "Sales", "Prospects like talking to me, but too many calls end with vague interest instead of a decision.", "Developer Sales Playbook", "/products/developer-sales-playbook/"],
  ["06", "Closing", "I spend too much time writing proposals, then lose control of scope, revisions, price, or the decision itself.", "Developer Proposal & Closing Kit", "/products/developer-proposal-closing-kit/"],
  ["07", "Partnerships", "I want agencies to send repeat work without buying my availability at a discount.", "Agency Partnership Playbook", "/products/agency-partnership-playbook/"],
  ["08", "Retention", "Good projects end, the client still needs help, and I somehow go back to zero anyway.", "Freelancer Retainer System", "/products/freelancer-retainer-system/"],
];
---

<BaseLayout
  title="Start Here | Developer Business Lab"
  description="Choose between the complete freelance business system and a focused guide for the bottleneck you already know needs attention."
>
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="Start here"
    title="Do you need the whole business system, or one deeper fix?"
    description="That is the first decision. Do not diagnose eight separate problems if the business as a whole still feels improvised. But do not buy the broad system when you already know one narrow constraint is the thing costing you."
  />

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-px overflow-hidden border border-border bg-border lg:grid-cols-2">
      <div class="bg-background p-7 sm:p-9">
        <p class="editorial-kicker">The whole business feels improvised</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight">Start with the Freelance Developer Launch Kit.</h2>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">Build the market, offer, pricing, positioning, proof, acquisition, sales, onboarding, delivery, referrals, and recurring-revenue system in dependency order so you can see what actually needs attention next.</p>
        <ul class="mt-6 space-y-3 text-sm leading-6 text-muted-foreground">
          <li><span class="mr-2 text-primary-accent">✓</span>You are starting or rebuilding the freelance business.</li>
          <li><span class="mr-2 text-primary-accent">✓</span>Several stages feel undefined at the same time.</li>
          <li><span class="mr-2 text-primary-accent">✓</span>You want one operating map before choosing deeper specialist material.</li>
        </ul>
        <p class="mt-8"><Button as="a" href="/products/freelance-developer-launch-kit/" size="lg">Start with the Launch Kit</Button></p>
      </div>

      <div class="bg-card/35 p-7 sm:p-9">
        <p class="editorial-kicker">I know exactly what is broken</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight">Go directly to the focused system.</h2>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">If the rest of the business is functioning well enough and one stage is clearly leaking money, time, opportunity, or confidence, use the specialist guide built for that constraint.</p>
        <p class="mt-8"><a href="#known-bottleneck" class="font-semibold text-primary-accent">Choose the known bottleneck ↓</a></p>
      </div>
    </div>
  </section>

  <section id="known-bottleneck" class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8 scroll-mt-24">
    <div class="mx-auto max-w-7xl">
      <div class="max-w-3xl">
        <p class="editorial-kicker">Known bottleneck</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">Which sentence sounds most like the problem you already see?</h2>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">Pick the constraint that is costing you most now. The focused guide goes deeper than the Launch Kit on that one stage.</p>
      </div>
      <div class="mt-9 border-t border-border">
        {service.map(([number, stage, problem, product, href]) => (
          <a href={href} class="group grid gap-3 border-b border-border py-7 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline sm:grid-cols-[4rem_8rem_1fr_auto] sm:items-center" data-event="start_here_choice">
            <span class="font-mono text-xs text-primary-accent">{number}</span>
            <span class="text-xs font-semibold uppercase tracking-[.14em] text-muted-foreground">{stage}</span>
            <span class="text-lg leading-7">{problem}</span>
            <span class="text-sm font-semibold text-primary-accent">{product} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="px-4 py-18 sm:px-6 sm:py-20 lg:px-8">
    <div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[.7fr_1.3fr] lg:items-center">
      <div><p class="editorial-kicker">Prefer to start free?</p><h2 class="mt-4 text-3xl font-semibold">Build one acquisition loop before you spend anything.</h2></div>
      <div><p class="text-lg leading-8 text-muted-foreground">Developer Marketing Quickstart turns “I need more clients” into one buyer, one problem, one offer, one message, one channel, and a first real test. It is the lowest-risk way to put the system into motion.</p><p class="mt-5"><a href="/free/" class="font-semibold text-primary-accent">Build the first acquisition loop free →</a></p></div>
    </div>
  </section>
</BaseLayout>
