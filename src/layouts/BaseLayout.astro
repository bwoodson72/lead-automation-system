---
import "@/styles/starwind.css";
import { ClientRouter, fade } from "astro:transitions";
import { getCollection } from "astro:content";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import GoogleAnalytics from "@/components/analytics/GoogleAnalytics.astro";
import CookieConsent from "@/components/privacy/CookieConsent.astro";
import { siteConfig } from "@/config";
import { resolveProductCoverImage } from "@/lib/product-cover-images";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";
import brandLogo from "@/assets/brand/developer-business-lab-logo.png";
import brandHero from "@/assets/brand/developer-business-lab-hero.png";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  enableCheckoutOverlay?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  enableCheckoutOverlay = false,
  structuredData,
} = Astro.props;

const siteUrl = siteConfig.url || "https://www.developerbusinesslab.com";
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const organizationId = new URL("/#organization", siteUrl).toString();
const websiteId = new URL("/#website", siteUrl).toString();
const organizationLogo = new URL(brandLogo.src, siteUrl).toString();
const brandContentImage = new URL(brandHero.src, siteUrl).toString();

const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const productPathMatch = normalizedPath.match(/^\/products\/([^/]+)$/);
const productSlug = normalizedPath === "/free"
  ? "developer-marketing-quickstart"
  : productPathMatch?.[1];

let productContentImage: string | undefined;
if (productSlug) {
  const products = await getCollection("products");
  const product = products.find((entry) => entry.data.slug === productSlug);

  if (product) {
    const commerce = resolveProductCommerce(product.data);
    const productImage = product.data.coverImage
      ?? resolveProductCoverImage(product.data, commerce.purchasable ? commerce.product?.id : undefined);

    if (productImage) {
      productContentImage = new URL(productImage.src, siteUrl).toString();
    }
  }
}

const defaultContentImage = productContentImage ?? brandContentImage;

const globalStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": organizationId,
    name: siteConfig.name,
    url: siteUrl,
    description: siteConfig.description,
    logo: {
      "@type": "ImageObject",
      url: organizationLogo,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": websiteId,
    url: siteUrl,
    name: siteConfig.name,
    description: siteConfig.description,
    publisher: { "@id": organizationId },
  },
];

const rawPageStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const pageStructuredData = rawPageStructuredData.map((schema) => {
  const schemaType = schema["@type"];
  if ((schemaType === "Article" || schemaType === "Product") && !schema.image) {
    return { ...schema, image: defaultContentImage };
  }
  return schema;
});
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={defaultContentImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={defaultContentImage} />
    <title>{title}</title>
    {globalStructuredData.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    {pageStructuredData.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <ClientRouter />
  </head>
  <body transition:animate={fade({ duration: "0.55s" })}>
    <a href="#main-content" class="sr-only z-50 rounded-md bg-primary px-4 py-2 text-primary-foreground focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <SiteHeader />
    <main id="main-content"><slot /></main>
    <SiteFooter />
    <CookieConsent />
    {enableCheckoutOverlay && <script is:inline src="https://assets.lemonsqueezy.com/lemon.js" defer></script>}
    <SpeedInsights />
  </body>
</html>
