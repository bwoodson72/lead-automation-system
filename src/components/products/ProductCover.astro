---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { resolveProductCoverImage } from "@/lib/product-cover-images";
import { resolveProductCommerce } from "@/lib/lemon-squeezy";

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const d = product.data;
const commerce = resolveProductCommerce(d);
const image = resolveProductCoverImage(d, commerce.purchasable ? commerce.product?.id : undefined);
---

{image ? (
  <div class="aspect-4/5 w-full max-w-md overflow-hidden rounded-2xl border border-primary/30 bg-card shadow-xl">
    <Image
      src={image}
      alt={`${d.title} product cover`}
      class="h-full w-full object-contain"
      widths={[480, 640, 960]}
      sizes="(min-width: 1024px) 28rem, 90vw"
      priority={true}
    />
  </div>
) : (
  <div class="relative flex aspect-4/5 w-full max-w-md flex-col overflow-hidden rounded-2xl border border-primary/30 bg-card p-8 shadow-xl" role="img" aria-label={`${d.title} cover concept`}>
    <div class="absolute inset-x-0 top-0 h-2 bg-primary"></div>
    <p class="font-mono text-xs font-semibold uppercase tracking-widest text-primary-accent">Developer Business Lab</p>
    <div class="my-auto">
      <p class="text-sm font-medium text-muted-foreground">{d.family}{d.tier ? ` · Tier ${d.tier}` : ""}</p>
      <p class="mt-4 text-4xl font-semibold tracking-tight">{d.title}</p>
    </div>
    <div class="grid grid-cols-5 gap-2" aria-hidden="true">{[1,2,3,4,5].map((n) => <span class:list={["h-2 rounded-full", n < 4 ? "bg-primary" : "bg-muted"]}></span>)}</div>
  </div>
)}
