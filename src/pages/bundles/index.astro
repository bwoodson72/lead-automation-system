---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import BundleOfferCard from "@/components/products/BundleOfferCard.astro";
import heroImage from "@/assets/brand/developer-business-lab-hero.png";
import { getBundleMerchandising } from "@/lib/bundle-merchandising";
import { isPublicBundle, isPublicProduct } from "@/lib/storefront-visibility";
import { applyBundleCopyOverride } from "@/lib/copy-overrides";

const bundles = (await getCollection("bundles")).filter(isPublicBundle).sort((a, b) => a.data.order - b.data.order);
const products = (await getCollection("products")).filter(isPublicProduct);
const merchandising = bundles.map((bundle) => ({ bundle, merch: getBundleMerchandising(bundle, products), data: applyBundleCopyOverride(bundle.data) }));
const hasCheckout = merchandising.some(({ merch }) => merch.purchasable);

const situationCopy: Record<string, { situation: string; develops: string; payoff: string }> = {
  "freelancer-starter-bundle": {
    situation: "Your technical skill is stronger than the commercial foundation under it.",
    develops: "Offer definition, project economics, and buyer-facing marketing.",
    payoff: "Make the work easier to buy and more worthwhile to sell."
  },
  "client-acquisition-bundle": {
    situation: "Future work depends too heavily on one or two ways opportunity enters the business.",
    develops: "Market-facing relevance, one acquisition backbone, social relationships, and agency access.",
    payoff: "Give good opportunities more than one path into the pipeline."
  },
  "freelancer-sales-system": {
    situation: "Serious buyer interest exists, but too much value disappears between conversation, commitment, payment, and what happens after delivery.",
    develops: "Sales decisions, proposal and closing, paid project start, and the post-delivery continuing-need decision.",
    payoff: "Protect more of the value you already worked to create."
  },
  "freelance-developer-business-system": {
    situation: "Several parts of the freelance business need a common foundation and deeper specialist work over time.",
    develops: "The complete Launch Kit foundation plus specialist depth across the broader commercial cycle.",
    payoff: "Build the whole business once, then go deeper where the business needs it next."
  }
};
---

<BaseLayout title="Freelance Developer Bundles | Developer Business Lab" description="Choose a Developer Business Lab bundle when several connected freelance business problems need to move together across your commercial foundation, acquisition, sales, or complete business system." enableCheckoutOverlay={hasCheckout}>
  <PageHero
    image={heroImage}
    imageAlt="Developer Business Lab guides and implementation workbooks arranged on a developer workspace"
    eyebrow="Developer Business Lab bundles"
    title="When one problem is really several connected problems, work on the whole part of the business."
    description="Choose the bundle by the business condition you want to leave behind. Product count and savings are supporting facts. The reason to buy a bundle is that several connected decisions need to improve together."
    primaryCta={{ label: "Help Me Choose", href: "/start/" }}
    supportingItems={["Four current bundles", "Connected commercial outcomes", "Live pricing and savings"]}
  />

  <section class="px-4 py-18 sm:px-6 sm:py-24 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end"><div><p class="editorial-kicker">Choose the scope that matches the problem</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">How much of the business needs to move together?</h2></div><p class="max-w-2xl text-lg leading-8 text-muted-foreground">A bundle is useful when fixing one piece would still leave the larger outcome constrained by another connected decision. If one problem is clearly the problem, the focused product is usually the better purchase.</p></div>

      <div class="mt-10 space-y-8">
        {merchandising.map(({ bundle, merch, data }) => {
          const copy = situationCopy[data.slug];
          return (
            <article class="border border-border bg-background p-7 lg:p-9">
              <div class="grid gap-8 lg:grid-cols-[.78fr_1.22fr] lg:gap-16">
                <div>
                  <p class="editorial-kicker">{merch.stage}</p>
                  <h3 class="mt-3 text-3xl font-semibold tracking-tight">{data.title}</h3>
                  <p class="mt-4 text-lg leading-8 text-muted-foreground">{data.hook ?? data.shortDescription}</p>
                  <p class="mt-6"><a class="font-semibold text-primary-accent hover:underline" href={`/bundles/${data.slug}/`}>Explore {data.title} →</a></p>
                </div>
                <dl class="grid gap-px overflow-hidden border border-border bg-border sm:grid-cols-3">
                  <div class="bg-background p-5"><dt class="text-xs font-semibold uppercase tracking-[.12em] text-muted-foreground">Current situation</dt><dd class="mt-3 leading-7">{copy?.situation ?? data.outcome}</dd></div>
                  <div class="bg-background p-5"><dt class="text-xs font-semibold uppercase tracking-[.12em] text-muted-foreground">What the bundle develops</dt><dd class="mt-3 leading-7">{copy?.develops ?? data.whyTogether}</dd></div>
                  <div class="bg-background p-5"><dt class="text-xs font-semibold uppercase tracking-[.12em] text-muted-foreground">Practical payoff</dt><dd class="mt-3 leading-7">{copy?.payoff ?? data.shortDescription}</dd></div>
                </dl>
              </div>
              <div class="mt-8 border-t border-border pt-7"><BundleOfferCard bundle={bundle} products={products} /></div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/35 px-4 py-18 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.75fr_1.25fr] lg:gap-20"><div><p class="editorial-kicker">When one problem is the problem</p><h2 class="mt-4 text-4xl font-semibold tracking-tight">Solve it directly.</h2></div><div class="space-y-5 text-lg leading-8 text-muted-foreground"><p>If the service is already clear and pricing is the only weak point, use the Pricing System. If qualified opportunity creation is the constraint, use the acquisition system. If sales is working but recurring client demand is not structured, use the Retainer System.</p><p>The bundle should match the scope of the business condition you are trying to change, not simply the largest purchase available.</p><p><a class="font-semibold text-primary-accent hover:underline" href="/products/">Browse focused products →</a></p></div></div></section>
</BaseLayout>
