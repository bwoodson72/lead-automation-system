---
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/starwind/badge";
import ProductCTA from "@/components/products/ProductCTA.astro";
import ProductCover from "@/components/products/ProductCover.astro";
import FAQList from "@/components/ui/FAQList.astro";

export async function getStaticPaths() {
  return (await getCollection("products")).map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const d = product.data;
const canonical = Astro.site ? new URL(`/products/${d.slug}/`, Astro.site).toString() : undefined;
const breadcrumbs = canonical ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Products", item: new URL("/products/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: d.title, item: canonical },
  ],
} : undefined;

const productCoverImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/products/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);
const explicitCoverImageFile = d.coverImageSrc?.split("/").at(-1);
const explicitCoverImage = explicitCoverImageFile
  ? productCoverImages[`/src/assets/products/${explicitCoverImageFile}`]?.default
  : undefined;
const slugCoverImage =
  productCoverImages[`/src/assets/products/${d.slug}.webp`]?.default ??
  productCoverImages[`/src/assets/products/${d.slug}.png`]?.default ??
  productCoverImages[`/src/assets/products/${d.slug}.jpg`]?.default ??
  productCoverImages[`/src/assets/products/${d.slug}.jpeg`]?.default ??
  productCoverImages[`/src/assets/products/${d.slug}.avif`]?.default;
const coverImage = d.coverImage ?? explicitCoverImage ?? slugCoverImage;
const hook = d.hook ?? d.problem;
const reframe = d.reframe ?? d.situation;
const delivery = d.delivery ?? {
  length: d.contents.length > 0 ? `${d.contents.length} focused implementation topics` : d.format,
  worksheets: "Final working assets will be listed when the product is released.",
  time: d.status === "available" ? "Use it on the next real business decision." : "Final implementation guidance will be published at release.",
};

const splitParagraphs = (text: string) => {
  const explicitParagraphs = text
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);

  if (explicitParagraphs.length > 1) return explicitParagraphs;

  const sentences = text
    .match(/[^.!?]+(?:[.!?]+["'’”)]*|$)/g)
    ?.map((sentence) => sentence.trim())
    .filter(Boolean);

  if (!sentences || sentences.length < 3) return [text];

  const paragraphs: string[] = [];
  for (let index = 0; index < sentences.length; index += 2) {
    paragraphs.push(sentences.slice(index, index + 2).join(" "));
  }
  return paragraphs;
};

const reframeParagraphs = splitParagraphs(reframe);
const proofParagraphs = d.proof ? splitParagraphs(d.proof.body) : [];
---

<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  noindex={d.status === "planned"}
  enableCheckoutOverlay={d.status === "available" && Boolean(d.checkoutUrl)}
>
  {breadcrumbs && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />}

  <section class="border-b border-border px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
        <a href="/products/" class="hover:text-foreground">Products</a>
        <span aria-hidden="true"> / </span>
        <span>{d.title}</span>
      </nav>
      <div class="mt-10 grid gap-14 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="flex flex-wrap gap-2">
            <Badge variant="outline">{d.family}</Badge>
            {d.tier && <Badge>Tier {d.tier}</Badge>}
            <Badge variant="secondary">{d.status === "coming-soon" ? "Coming soon" : d.status}</Badge>
          </div>
          <h1 class="mt-5 text-5xl font-semibold tracking-tight sm:text-6xl">{d.title}</h1>
          <p class="mt-6 max-w-2xl text-2xl font-semibold leading-9 text-primary-accent">{hook}</p>
          <p class="mt-6 border-l-2 border-primary pl-4"><strong>For:</strong> <span class="text-muted-foreground">{d.audience}</span></p>
          <div class="mt-8"><ProductCTA product={product} location="hero" /></div>
          <p class="mt-4 text-sm text-muted-foreground">{d.format}{d.status === "available" && d.price ? ` · $${d.price}` : d.free ? " · Free" : ""}</p>
        </div>
        <ProductCover title={d.title} family={d.family} tier={d.tier} image={coverImage} />
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-3xl font-semibold">The problem</h2>
      <div class="mt-5 space-y-5 text-lg leading-8 text-muted-foreground">
        {reframeParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-card/30 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Contents</p>
      <h2 class="mt-3 text-3xl font-semibold">What you get</h2>
      <div class="mt-8 grid gap-8 lg:grid-cols-[1.4fr_0.6fr]">
        <ul class="grid gap-3 sm:grid-cols-2">
          {d.contents.map((item) => (
            <li class="rounded-xl border border-border bg-card p-5"><span aria-hidden="true" class="mr-3 text-success">✓</span>{item}</li>
          ))}
        </ul>
        <dl class="space-y-5 rounded-xl border border-border bg-card p-6">
          <div><dt class="text-sm font-semibold">Format and length</dt><dd class="mt-1 text-sm leading-6 text-muted-foreground">{delivery.length}</dd></div>
          <div><dt class="text-sm font-semibold">Worksheets and templates</dt><dd class="mt-1 text-sm leading-6 text-muted-foreground">{delivery.worksheets}</dd></div>
          <div><dt class="text-sm font-semibold">Implementation time</dt><dd class="mt-1 text-sm leading-6 text-muted-foreground">{delivery.time}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-semibold">For:</h2>
        <ul class="mt-6 space-y-3">{d.whoItsFor.map((item) => <li class="text-muted-foreground">✓ {item}</li>)}</ul>
      </div>
      <div>
        <h2 class="text-3xl font-semibold">Not for:</h2>
        <ul class="mt-6 space-y-3">{d.whoItsNotFor.map((item) => <li class="text-muted-foreground">× {item}</li>)}</ul>
      </div>
    </div>
  </section>

  {d.proof && (
    <section class="border-y border-border bg-card/30 px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <p class="font-mono text-xs uppercase tracking-widest text-primary-accent">Concrete example</p>
        <h2 class="mt-3 text-3xl font-semibold">Example</h2>
        <p class="mt-4 text-xl font-semibold leading-8">{d.proof.title}</p>
        <div class="mt-5 space-y-5 text-lg leading-8 text-muted-foreground">
          {proofParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {(d.proof.before || d.proof.after) && (
          <div class="mt-8 grid gap-4 md:grid-cols-2">
            {d.proof.before && <div class="rounded-xl border border-border bg-background p-5"><p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Before</p><p class="mt-2">{d.proof.before}</p></div>}
            {d.proof.after && <div class="rounded-xl border border-primary/30 bg-background p-5"><p class="text-xs font-semibold uppercase tracking-wide text-primary-accent">After</p><p class="mt-2">{d.proof.after}</p></div>}
          </div>
        )}
      </div>
    </section>
  )}

  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      {d.faqs.length > 0 && (
        <>
          <h2 class="text-3xl font-semibold">FAQ</h2>
          <div class="mt-8"><FAQList faqs={d.faqs.map((faq, index) => ({ data: { ...faq, order: index } }))} /></div>
        </>
      )}
      <div class={d.faqs.length > 0 ? "mt-12 border-t border-border pt-10" : ""}>
        <h2 class="text-3xl font-semibold">{d.status === "available" ? "Get the system" : "Release updates"}</h2>
        <p class="mt-4 leading-7 text-muted-foreground">{d.status === "available" ? d.coreOutcome : "This product is not for sale yet. Join the update list if you want to know when the final contents and release details are ready."}</p>
        <div class="mt-8"><ProductCTA product={product} location="final" /></div>
      </div>
    </div>
  </section>
</BaseLayout>
