---
import ProseLayout from "@/layouts/ProseLayout.astro";
import { siteConfig } from "@/config";
---
<ProseLayout title="You're In." description="Your purchase is complete." eyebrow="Purchase complete" noindex={true}><p>Your receipt and download information are provided through Lemon Squeezy at the email address used during checkout.</p><p>Save the delivery email so you can return to your product. When you are ready, begin with the product's introduction and follow its implementation path at the pace that fits your business.</p>{siteConfig.supportEmail ? <p>If you have trouble accessing the purchase, email <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>.</p> : <p class="rounded-lg border border-warning/30 bg-warning/10 p-4 text-warning">Support contact is awaiting production configuration.</p>}</ProseLayout>
