---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCard from "@/components/products/ProductCard.astro";
const products = (await getCollection("products")).sort((a,b)=>a.data.order-b.data.order);
const problems = [["Decide what to sell","productize-your-dev-skills"],["Set prices","web-developer-pricing-system"],["Find clients","client-acquisition-without-upwork"],["Automate prospecting","ai-prospecting-starter"],["Improve sales","developer-sales-playbook"],["Create recurring revenue","freelancer-retainer-system"],["Validate SaaS","saas-validation-before-you-build"],["Launch SaaS","micro-saas-launch-system"],["Find early SaaS customers","the-first-10-saas-customers"],["Operate more efficiently with AI","ai-powered-one-person-dev-business"]];
const families = [...new Set(products.map((p)=>p.data.family))];
const idFor = (family:string) => family.toLowerCase().replaceAll(" ","-").replaceAll("&","");
---
<BaseLayout title="Products | Prospect Foundry" description="Browse practical business systems for developers by current bottleneck or product family."><section class="px-4 py-20 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><p class="font-mono text-xs uppercase tracking-widest text-primary-accent">The catalog</p><h1 class="mt-4 max-w-4xl text-5xl font-semibold tracking-tight">Find the system that removes your current bottleneck.</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">You do not need to follow a rigid curriculum. Start with the problem constraining the business now.</p><h2 class="mt-14 text-3xl font-semibold">Browse by current problem</h2><div class="mt-7 grid gap-3 md:grid-cols-2">{problems.map(([problem,slug]) => <a href={`/products/${slug}/`} class="rounded-lg border border-border bg-card px-5 py-4 hover:border-primary/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-outline" data-event="problem_path">{problem}<span class="float-right text-primary-accent">→</span></a>)}</div></div></section>{families.map((family) => <section id={idFor(family)} class="border-t border-border px-4 py-16 sm:px-6 lg:px-8"><div class="mx-auto max-w-7xl"><h2 class="text-3xl font-semibold">{family}</h2><div class="mt-8 grid gap-5 md:grid-cols-2">{products.filter((p)=>p.data.family===family).map((product)=><ProductCard product={product} />)}</div></div></section>)}</BaseLayout>
